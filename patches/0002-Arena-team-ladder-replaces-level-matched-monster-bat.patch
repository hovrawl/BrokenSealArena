From ab9ddc2bec5e9dd83cd3e7192f7f09cedd294dd4 Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Fri, 30 Oct 2026 10:11:06 +1100
Subject: [PATCH] Arena: team ladder replaces level-matched monster battles

A monster series fights rung n of gArenaLadder (battle/formations.c) on win n,
with twelve fixed mixed teams from level 10 to 45. Guarded by ARENA_LADDER in
battle/battle/formation.c; enemies are levelled to the rung with the existing
BattleEnemy_AdjustLevel.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/include/battle/formations.h   | 12 +++++++
 games/tbs/src/battle/battle/formation.c | 48 +++++++++++++++++++++++++
 games/tbs/src/battle/formations.c       | 31 ++++++++++++++++
 3 files changed, 91 insertions(+)

diff --git a/games/tbs/include/battle/formations.h b/games/tbs/include/battle/formations.h
index 401fb18672..dc5124b628 100644
--- a/games/tbs/include/battle/formations.h
+++ b/games/tbs/include/battle/formations.h
@@ -29,4 +29,16 @@ struct Formation {
 /// The 380 formations, by formation id (battle/formations.c).
 extern const struct Formation gFormations[];
 
+/// Arena romhack: one rung of the team ladder. In a monster series, win number
+/// n (0-based) fights rung n; its enemies are levelled to targetLevel.
+struct ArenaTeam {
+  u8 targetLevel;
+  struct Formation formation;
+};
+
+#define ARENA_LADDER_COUNT 12
+
+/// The team ladder (battle/formations.c).
+extern const struct ArenaTeam gArenaLadder[];
+
 #endif
diff --git a/games/tbs/src/battle/battle/formation.c b/games/tbs/src/battle/battle/formation.c
index d56e52646e..02c164bd8e 100644
--- a/games/tbs/src/battle/battle/formation.c
+++ b/games/tbs/src/battle/battle/formation.c
@@ -68,6 +68,48 @@ s32 BattleFormation_AverageLevel(s32 recordId) {
   return levelTotal / enemyCount;
 }
 
+#ifndef ARENA_LADDER
+#define ARENA_LADDER 1
+#endif
+
+#if ARENA_LADDER
+/// Arena romhack: the team a monster series fights next. Win number n of the
+/// series (the Battle Arena's LINK_TALLY_MONSTER_STREAK, linkTallies[3]) fights
+/// rung n of gArenaLadder; past the last rung it fights the last again, a level
+/// stronger for each win. outMargin is the levels each enemy gains to reach the
+/// rung's level from the average of its members.
+static const struct Formation *ArenaLadder_Select(s32 *outMargin) {
+  s32 streak = gMainRoutineWork.linkTallies[3];
+  s32 rung = streak;
+  s32 target;
+  s32 levelTotal = 0;
+  s32 members = 0;
+  s32 i;
+  const struct ArenaTeam *team;
+
+  if (rung >= ARENA_LADDER_COUNT)
+    rung = ARENA_LADDER_COUNT - 1;
+  team = &gArenaLadder[rung];
+  for (i = 0; i < 5; i++) {
+    struct EnemyDefinition *enemy;
+
+    if (team->formation.maximumCounts[i] == 0)
+      continue;
+    enemy = (struct EnemyDefinition *)Enemy_GetDefinitionFar(
+        team->formation.memberIds[i] + ENEMY_ID_FIRST);
+    if (enemy == 0)
+      continue;
+    levelTotal += enemy->level;
+    members++;
+  }
+  target = team->targetLevel + (streak - rung);
+  if (target > UNIT_LEVEL_MAX)
+    target = UNIT_LEVEL_MAX;
+  *outMargin = members != 0 ? target - levelTotal / members : 0;
+  return &team->formation;
+}
+#endif
+
 /// A formation that may be chosen for the party's level: its row and its
 /// enemies' average level. BattleFormation_SelectLevelMatchedCandidate keeps
 /// a pool of 32 in a 128-byte EWRAM pool block, freed before it returns.
@@ -488,11 +530,17 @@ s32 BattleFormation_BuildEnemyList(s32 recordId) {
   levelAdjustment = 0;
   battle->enemyKindCount = 0;
   enemyKinds = listBuffer;
+#if !ARENA_LADDER
   if (GameFlag_GetFar(FLAG_MONSTER_BATTLE))
     recordId = BattleFormation_SelectLevelMatchedCandidate(&levelAdjustment);
+#endif
   if (recordId < 0 || recordId >= FORMATION_COUNT)
     recordId = 1;
   record = (struct Formation *)&gFormations[recordId];
+#if ARENA_LADDER
+  if (GameFlag_GetFar(FLAG_MONSTER_BATTLE))
+    record = (struct Formation *)ArenaLadder_Select(&levelAdjustment);
+#endif
   for (memberIndex = 0;
        memberIndex <= 4 && record->minimumCounts[memberIndex] == 0;
        memberIndex++)
diff --git a/games/tbs/src/battle/formations.c b/games/tbs/src/battle/formations.c
index df576762de..981a2118ef 100644
--- a/games/tbs/src/battle/formations.c
+++ b/games/tbs/src/battle/formations.c
@@ -1529,6 +1529,37 @@ const struct Formation gFormations[] = {
     },
 };
 
+// Arena romhack: the team ladder. Members are rows of enemy_table.c; a small
+// enemy takes one of the battle's six sprite slots and any other two, so each
+// rung's counts stay within six. Counts are fixed (minimum equals maximum).
+#define ARENA_TEAM(level, ...) {(level), {.layout = 2, __VA_ARGS__}}
+const struct ArenaTeam gArenaLadder[ARENA_LADDER_COUNT] = {
+    // Skeleton, Bats and a Slime
+    ARENA_TEAM(10, .memberIds = {24, 5, 11}, .minimumCounts = {1, 2, 1}, .maximumCounts = {1, 2, 1}),
+    // Rat Fighter, Drone Bees and a Mole
+    ARENA_TEAM(13, .memberIds = {34, 36, 63}, .minimumCounts = {1, 2, 1}, .maximumCounts = {1, 2, 1}),
+    // Brigand, Harpy and a Dirge
+    ARENA_TEAM(16, .memberIds = {23, 57, 66}, .minimumCounts = {1, 1, 1}, .maximumCounts = {1, 1, 1}),
+    // Mercury Djinni, Gnome Mage and a Golem
+    ARENA_TEAM(19, .memberIds = {154, 46, 93}, .minimumCounts = {1, 1, 1}, .maximumCounts = {1, 1, 1}),
+    // Orc Captain, Siren and a Mole Mage
+    ARENA_TEAM(22, .memberIds = {76, 60, 65}, .minimumCounts = {1, 1, 1}, .maximumCounts = {1, 1, 1}),
+    // The Colosso champions: Azart, Satrage and Navampa
+    ARENA_TEAM(25, .memberIds = {124, 126, 128}, .minimumCounts = {1, 1, 1}, .maximumCounts = {1, 1, 1}),
+    // Cannibal Ghoul, Ice Gargoyle and two Recluses
+    ARENA_TEAM(28, .memberIds = {50, 89, 44}, .minimumCounts = {1, 1, 2}, .maximumCounts = {1, 1, 2}),
+    // Lizard King, Wild Gryphon and a Jupiter Djinni
+    ARENA_TEAM(31, .memberIds = {121, 91, 163}, .minimumCounts = {1, 1, 1}, .maximumCounts = {1, 1, 1}),
+    // Thunder Lizard, Chimera Mage and a Skull Warrior
+    ARENA_TEAM(34, .memberIds = {80, 103, 26}, .minimumCounts = {1, 1, 1}, .maximumCounts = {1, 1, 1}),
+    // Three Djinn: Mars, Venus and Mercury
+    ARENA_TEAM(37, .memberIds = {159, 152, 156}, .minimumCounts = {1, 1, 1}, .maximumCounts = {1, 1, 1}),
+    // Poison Toad, Fenrir and an Earth Lizard
+    ARENA_TEAM(41, .memberIds = {134, 98, 79}, .minimumCounts = {1, 1, 1}, .maximumCounts = {1, 1, 1}),
+    // Menardi, Saturos and Cerebus
+    ARENA_TEAM(45, .memberIds = {118, 116, 97}, .minimumCounts = {1, 1, 1}, .maximumCounts = {1, 1, 1}),
+};
+
 /// The 20 enemies whose defeated flags a monster battle clears before it
 /// picks a formation (BattleFormation_SelectLevelMatchedCandidate).
 const u16 gBattleFormation_LevelMatchedEnemies[] = {
