@@ -41,6 +41,7 @@
 	.set import.ArenaMenu_IconChoose, 1
 	.set import.ItemPicker_ChooseMember, 1
 	.set import.ArenaShop_Run, 1
+	.set import.Save_ToChosenFile, 1
 	.set import.WindowSprite_CreateFromResource, 1
 	.set import.Sprite_Create, 1
 	.set import.Sprite_Destroy, 1
