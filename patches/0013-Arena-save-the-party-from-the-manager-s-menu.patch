From edebe70d2a405566a3bd440d2d6e7a622cd2b0d1 Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Fri, 30 Oct 2026 11:55:52 +1100
Subject: [PATCH] Arena: save the party from the manager's menu

The party manager gets a Save entry (the Save icon, a new MsgArenaSave label)
that runs the game's own Save_ToChosenFile. The scene and entrance a Continue
goes to are set to the arena's door for the save, and the series flag cleared,
then put back, so loading does not replay a battle's reward or resume a series.
New Game also sets restartScene and restartEntrance to the arena, so Continue
on a file from another build lands there too. The new label goes in the middle
of the arena messages, so the ones after it move up by one.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/scene/battle_arena.c        | 31 ++++++++++-
 games/tbs/src/scene/file_screen.c         |  3 +
 games/tbs/src/scene/import/battle_arena.s |  1 +
 games/tbs/text/en.po                      | 68 ++++++++++++-----------
 4 files changed, 69 insertions(+), 34 deletions(-)

diff --git a/games/tbs/src/scene/battle_arena.c b/games/tbs/src/scene/battle_arena.c
index adf496ace6..98dbe6c1ce 100644
--- a/games/tbs/src/scene/battle_arena.c
+++ b/games/tbs/src/scene/battle_arena.c
@@ -1083,7 +1083,8 @@ static s32 BattleArena_EnterBattle(void) {
 const u8 gArenaMenu_AttendantIcons[] = {COMMAND_ICON_FIGHT, COMMAND_ICON_CABLE};
 const u8 gArenaMenu_TournamentIcons[] = {COMMAND_ICON_BATTLE};
 const u8 gArenaMenu_ManagerIcons[] = {COMMAND_ICON_STATUS, COMMAND_ICON_DJINN,
-                                      COMMAND_ICON_PSYNERGY, COMMAND_ICON_ITEM};
+                                      COMMAND_ICON_PSYNERGY, COMMAND_ICON_ITEM,
+                                      COMMAND_ICON_SAVE_QUEST};
 const u8 gArenaMenu_ShopIcons[] = {COMMAND_ICON_ATTACK, COMMAND_ICON_DEFEND,
                                    COMMAND_ICON_ITEM};
 
@@ -1123,6 +1124,28 @@ static void ArenaMenu_ShowWin(s32 reward) {
   Party_RestoreHpPp(1);
 }
 
+/// Saves the party to a file the player chooses, with the game's own Save
+/// command, so the title's Battle (or Continue) brings it back to the arena.
+/// The file is written as if the game stood at the arena's door and no series
+/// were running: the scene and entrance a Continue goes to, and the series flag,
+/// are set for the save and put back after, so loading does not replay the last
+/// battle's reward or resume its series.
+static void ArenaMenu_SaveGame(void) {
+  s32 savedNext = gMainRoutineWork.next;
+  s32 savedEntrance = gMainRoutineWork.entrance;
+  s32 inSeries = Event_GetFlag(FLAG_MONSTER_BATTLE);
+
+  gMainRoutineWork.next = (s32)&SceneId_BattleArena;
+  gMainRoutineWork.entrance = BATTLE_ARENA_FROM_FILE_SCREEN;
+  if (inSeries)
+    GameFlag_Clear(FLAG_MONSTER_BATTLE);
+  Save_ToChosenFile();
+  if (inSeries)
+    GameFlag_Set(FLAG_MONSTER_BATTLE);
+  gMainRoutineWork.next = savedNext;
+  gMainRoutineWork.entrance = savedEntrance;
+}
+
 /// Talking to ACTOR_LINKED_WINS_TELLER, now the party manager: characters,
 /// Djinn, Psynergy and the item shops. B leaves; the party is healed on the
 /// way out, since stats and gear may have changed.
@@ -1135,9 +1158,13 @@ static s32 BattleArena_PartyManager(s32 actorId) {
   for (;;) {
     choice = ArenaMenu_IconChoose(MsgArenaManagerPrompt,
                                   gArenaMenu_ManagerIcons, MsgArenaCharacters,
-                                  4);
+                                  5);
     if (choice < 0)
       break;
+    if (choice == 4) {
+      ArenaMenu_SaveGame();
+      continue;
+    }
     if (choice == 3) {
       choice = ArenaMenu_IconChoose(MsgArenaShopPrompt, gArenaMenu_ShopIcons,
                                     MsgArenaWeapons, 3);
diff --git a/games/tbs/src/scene/file_screen.c b/games/tbs/src/scene/file_screen.c
