index 0000000000..31a6cf78c5
--- /dev/null
+++ b/games/tbs/include/arena/arena_touch.h
@@ -0,0 +1,66 @@
+#ifndef GUARD_ARENA_TOUCH_H
+#define GUARD_ARENA_TOUCH_H
+
+/// @file
+/// Touch for the game's own screens in the desktop build (native/touch.h):
+/// helpers that turn a tap on a window's grid of choices into the same moves
+/// the keys make. A tap on another choice moves the selection there; a tap on
+/// the selected one presses A for that frame, so the screen's own A code
+/// runs. Positions are in pixels from the window's interior (one tile in from
+/// its corner), as the window's sprites and cursor are placed.
+/// Desktop only; the GBA build has none of it.
+
+#ifdef NATIVE
+#include "native/touch.h"
+
+/// The grid cell tapped this frame, cells as for Touch_TappedUiCell but from
+/// the window's interior; -1 when none.
+static inline s32 WindowTouch_Cell(struct Window *window, s32 x, s32 y,
+                                   s32 cellWidth, s32 cellHeight, s32 columns,
+                                   s32 count) {
+  if (window == 0)
+    return -1;
+  return Touch_TappedUiCell(window->x * 8 + 8 + x, window->y * 8 + 8 + y,
+                            cellWidth, cellHeight, columns, count);
+}
+
+/// Applies a tap on a grid of choices to *selection: returns 1 after moving
+/// it to the tapped choice (with the cursor sound), so the caller redraws;
+/// on the selected choice it sets KEY_A in gKeysPressed and returns 0.
+static inline s32 WindowTouch_Pick(struct Window *window, s32 x, s32 y,
+                                   s32 cellWidth, s32 cellHeight, s32 columns,
+                                   s32 count, s32 *selection) {
+  s32 cell = WindowTouch_Cell(window, x, y, cellWidth, cellHeight, columns,
+                              count);
+
+  if (cell < 0)
+    return 0;
+  if (cell == *selection) {
+    gKeysPressed |= KEY_A;
+    return 0;
+  }
+  Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+  *selection = cell;
+  return 1;
+}
+
+/// The party row of the shops and the party manager (figures from
+/// Menu_CreatePartyFigures(window, 2, 0, 8, 0): one every 24 pixels, standing
+/// on the window's interior): as WindowTouch_Pick for the member index.
+static inline s32 WindowTouch_PickMember(struct Window *window, s32 count,
+                                         s32 *memberIndex) {
+  s32 index = (*memberIndex % count + count) % count;
+  s32 moved = WindowTouch_Pick(window, -4, -24, 24, 36, count, count, &index);
+
+  if (moved || (gKeysPressed & KEY_A))
+    *memberIndex = index;
+  return moved;
+}
+
+/// The bag grid of the shops (Shop_DrawMemberItems: SHOP_INVENTORY_COLUMNS
+/// 16-pixel icons a row, from 8 pixels into the window's interior).
+#define WINDOW_TOUCH_BAG(window, count, slot)                                  \
+  WindowTouch_Pick((window), 8, 0, 16, 16, 5, (count), (slot))
+
+#endif
+#endif
