diff --git a/port/src/native_touch.c b/port/src/native_touch.c
index b9c57cecf6..9e709604fe 100644
--- a/port/src/native_touch.c
+++ b/port/src/native_touch.c
@@ -48,3 +48,46 @@ int Touch_Held(int *x, int *y) {
   *y = sY;
   return sDown;
 }
+
+// The cell under (px, py), or -1: one axis at a time, with the outer edges
+// widened so a small cell is still TOUCH_TARGET_MIN across.
+static int Axis(int p, int start, int size, int cells) {
+  int pad = size < TOUCH_TARGET_MIN ? (TOUCH_TARGET_MIN - size) / 2 : 0;
+  int rel = p - start;
+
+  if (rel < -pad || rel >= size * cells + pad)
+    return -1;
+  if (rel < 0)
+    return 0;
+  if (rel >= size * cells)
+    return cells - 1;
+  return rel / size;
+}
+
+static int CellAt(int px, int py, int left, int top, int cellWidth,
+                  int cellHeight, int columns, int count) {
+  int rows = (count + columns - 1) / columns;
+  int column = Axis(px, left, cellWidth, columns);
+  int row = Axis(py, top, cellHeight, rows);
+  int cell;
+
+  if (column < 0 || row < 0)
+    return -1;
+  cell = row * columns + column;
+  return cell < count ? cell : -1;
+}
+
+int Touch_TappedUiCell(int left, int top, int cellWidth, int cellHeight,
+                       int columns, int count) {
+  int cell;
+
+  if (!sReleased || count <= 0 || columns <= 0)
+    return -1;
+  left += gNativeUiOffset;
+  cell = CellAt(sX, sY, left, top, cellWidth, cellHeight, columns, count);
+  if (cell < 0 || cell != CellAt(sPressX, sPressY, left, top, cellWidth,
+                                 cellHeight, columns, count))
+    return -1;
+  sReleased = 0;
+  return cell;
+}
