+/// Touch on the stock row of the buying screens (Shop_DrawStock): a page of
+/// SHOP_STOCK_PAGE_ITEMS entries 32 pixels apart, a figure over each in the
+/// Djinn shop, and the page arrows at the right. As WindowTouch_Pick for the
+/// index into the whole stock; an arrow turns the page.
+static inline s32 ShopTouch_PickStock(struct Window *window, s32 count,
+                                      s32 *selected) {
+  s32 pageStart = *selected - *selected % SHOP_STOCK_PAGE_ITEMS;
+  s32 slot = *selected - pageStart;
+  s32 onPage = count - pageStart;
+
+  if (pageStart > 0 && WindowTouch_Cell(window, 212, -20, 24, 24, 1, 1) == 0) {
+    Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+    *selected = pageStart - SHOP_STOCK_PAGE_ITEMS;
+    return 1;
+  }
+  if (pageStart + SHOP_STOCK_PAGE_ITEMS < count &&
+      WindowTouch_Cell(window, 212, 20, 24, 24, 1, 1) == 0) {
+    Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+    *selected = pageStart + SHOP_STOCK_PAGE_ITEMS;
+    return 1;
+  }
+  if (onPage > SHOP_STOCK_PAGE_ITEMS)
+    onPage = SHOP_STOCK_PAGE_ITEMS;
+  if (WindowTouch_Pick(window, 0, -16, 32, 36, SHOP_STOCK_PAGE_ITEMS, onPage,
+                       &slot)) {
+    *selected = pageStart + slot;
+    return 1;
+  }
+  return 0;
+}
+#endif
+
 #endif
