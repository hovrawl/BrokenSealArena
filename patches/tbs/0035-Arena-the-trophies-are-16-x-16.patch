From 5b976f2c68ac61167936a43f82d97818bfd9caa2 Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Sun, 1 Nov 2026 16:14:48 +1100
Subject: [PATCH] Arena: the trophies are 16 x 16

The trophy sprites (sprite table rows 309 to 313) are one 16 x 16 picture each instead of 16 x 32,
a quarter of a person's sprite memory. scripts/gen-trophy-sprites.py draws the smaller cups.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/graphics/sprite/sprites.tsv | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/games/tbs/src/graphics/sprite/sprites.tsv b/games/tbs/src/graphics/sprite/sprites.tsv
index 9b9de6f624..06104496e9 100644
--- a/games/tbs/src/graphics/sprite/sprites.tsv
+++ b/games/tbs/src/graphics/sprite/sprites.tsv
@@ -308,11 +308,11 @@ BATTLE_JENNA	64	64	192	2	0	2	48	32	0	BATTLE_JENNA	BATTLE_JENNA
 SPR_306	32	32	434	2	0	2	48	32	3	SPR_306	BATTLE_GARET
 SPR_307	32	32	384	2	0	2	48	32	3	SPR_307	BATTLE_IVAN
 SPR_308	32	32	384	2	0	2	48	32	3	SPR_308	BATTLE_MIA
-SPR_309	16	32	256	11	0	2	14	12	3	SPR_309	SPR_309
-SPR_310	16	32	256	11	0	2	14	12	3	SPR_310	SPR_310
-SPR_311	16	32	256	11	0	2	14	12	3	SPR_311	SPR_311
-SPR_312	16	32	256	11	0	2	14	12	3	SPR_312	SPR_312
-SPR_313	16	32	256	11	0	2	14	12	3	SPR_313	SPR_313
+SPR_309	16	16	256	11	0	2	14	12	3	SPR_309	SPR_309
+SPR_310	16	16	256	11	0	2	14	12	3	SPR_310	SPR_310
+SPR_311	16	16	256	11	0	2	14	12	3	SPR_311	SPR_311
+SPR_312	16	16	256	11	0	2	14	12	3	SPR_312	SPR_312
+SPR_313	16	16	256	11	0	2	14	12	3	SPR_313	SPR_313
 SPR_314	0	0	0	0	0	0	0	0	0
