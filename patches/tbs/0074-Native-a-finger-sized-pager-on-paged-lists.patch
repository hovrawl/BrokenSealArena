 }
 
+#ifdef NATIVE
+/// The item menu's arrows (gMenu_ArrowTiles: the small up arrow, then the up
+/// and down arrows, 16 by 16 and 128 bytes each), drawn for the window
+/// sprites' palette, which every screen with a paged list loads.
+extern u8 gMenu_ArrowTiles[];
+#define PAGER_UP_ARROW_TILES (gMenu_ArrowTiles + 128)
+#define PAGER_DOWN_ARROW_TILES (gMenu_ArrowTiles + 256)
+
+/// The pager (ui_kit.h): one list at a time, so its state is here.
+static struct {
+  struct Window *window;
+  s32 slots[2]; ///< VRAM cache entries: the up arrow, the down arrow
+  struct WindowSprite *arrows[2];
+  s32 x[2], y[2]; ///< the arrows' places, in pixels from the interior
+} sPager;
+
+void UiPager_Open(struct Window *window) {
+  sPager.window = 0;
+  if (!UI_TOUCH_LAYOUT || window == 0)
+    return;
+  sPager.slots[0] = VramCache_FindFreeEntry();
+  if (sPager.slots[0] >= VRAM_CACHE_ENTRY_COUNT)
+    return;
+  VramCache_Load(sPager.slots[0], 128, PAGER_UP_ARROW_TILES);
+  sPager.slots[1] = VramCache_FindFreeEntry();
+  if (sPager.slots[1] >= VRAM_CACHE_ENTRY_COUNT) {
+    VramCache_FreeEntry(sPager.slots[0]);
+    return;
+  }
+  VramCache_Load(sPager.slots[1], 128, PAGER_DOWN_ARROW_TILES);
+  sPager.window = window;
+  sPager.arrows[0] = sPager.arrows[1] = 0;
+  sPager.x[0] = sPager.x[1] = -1;
+}
+
+/// Shows arrow `which` (0 up, 1 down) at (x, y) from the window's interior,
+/// still (a hop would take the up arrow into the window above).
+static void UiPager_Place(s32 which, s32 x, s32 y) {
+  struct WindowSprite *arrow = sPager.arrows[which];
+
+  if (arrow == 0) {
+    arrow = WindowSprite_CreateFar(sPager.slots[which],
+                                   WINDOW_SPRITE_SIZE_16X16, sPager.window, x,
+                                   y);
+    if (arrow == 0)
+      return;
+    arrow->kind = WINDOW_SPRITE_PLAIN;
+    arrow->depth = 250;
+    sPager.arrows[which] = arrow;
+  } else if (x != sPager.x[which]) {
+    // Moved (the page count changed): x and the OAM word's x, as
+    // WindowSprite_Create sets them.
+    s32 screenX = (x + sPager.window->x * 8 + 8) & OBJ_X_MASK;
+    u32 *word = (u32 *)&arrow->sprite.oam;
+
+    arrow->x = screenX;
+    *word = (*word & ~OBJ_X(OBJ_X_MASK)) | OBJ_X(screenX);
+  }
+  sPager.x[which] = x;
+  sPager.y[which] = y;
+  arrow->motion = WINDOW_SPRITE_MOTION_STILL;
+}
+
+s32 UiPager_Step(s32 pages, s32 leftColumn, s32 rightColumn) {
+  struct Window *window = sPager.window;
+  s32 i;
+
+  (void)rightColumn;
+  if (window == 0)
+    return 0;
+  if (pages <= 1) {
+    for (i = 0; i < 2; i++)
+      if (sPager.arrows[i] != 0)
+        sPager.arrows[i]->motion = WINDOW_SPRITE_MOTION_HIDDEN;
+    return 0;
+  }
+  // The up arrow over the small left one on the top border (the tile before
+  // it too), the down arrow at the bottom right inside.
+  if (sPager.arrows[0] == 0 || sPager.x[0] != leftColumn * 8 - 8 ||
+      sPager.arrows[0]->motion == WINDOW_SPRITE_MOTION_HIDDEN) {
+    UiPager_Place(0, leftColumn * 8 - 8, -12);
+    UiPager_Place(1, (window->width - 2) * 8 - 16,
+                  (window->height - 2) * 8 - 8);
+  }
+  for (i = 0; i < 2; i++)
+    if (WindowTouch_Cell(window, sPager.x[i] - 4, sPager.y[i] - 4, 24, 24, 1,
+                         1) == 0)
+      return i == 0 ? -1 : 1;
+  return 0;
+}
+
+void UiPager_Close(void) {
+  s32 i;
+
+  if (sPager.window == 0)
+    return;
+  for (i = 0; i < 2; i++) {
+    if (sPager.arrows[i] != 0)
+      sPager.arrows[i]->motion = WINDOW_SPRITE_MOTION_HIDDEN;
+    VramCache_FreeEntry(sPager.slots[i]);
+  }
+  sPager.window = 0;
+}
+#endif
+
