--- a/games/tbs/include/arena/battle_touch.h
+++ b/games/tbs/include/arena/battle_touch.h
@@ -107,6 +107,16 @@ static inline void BattleTouch_List(struct Window *window, s32 pageRows,
     return;
   if (rows > pageRows)
     rows = pageRows;
+  {
+    // The pager's finger-sized arrows over the small ones (ui_kit.h).
+    s32 turn = UiPager_Step(pages, window->width - pages - 3,
+                            window->width - 2);
+
+    if (turn != 0) {
+      gKeysRepeat |= turn < 0 ? KEY_LEFT : KEY_RIGHT;
+      return;
+    }
+  }
   if (pages > 1) {
     // The arrows sit on the border row, one tile each; taps reach 24 pixels.
     if (WindowTouch_Cell(window, (window->width - pages - 3) * 8, -8, 8, 8, 1,
diff --git a/games/tbs/include/arena/menu_touch.h b/games/tbs/include/arena/menu_touch.h
index 950459efd8..30c31ba3b8 100644
--- a/games/tbs/include/arena/menu_touch.h
+++ b/games/tbs/include/arena/menu_touch.h
@@ -26,11 +26,37 @@
   ((list).entryCount - (list).page * LIST_PAGE_SIZE > LIST_PAGE_SIZE           \
        ? LIST_PAGE_SIZE                                                        \
        : (list).entryCount - (list).page * LIST_PAGE_SIZE)
-/// A tap on a row of a PagedList's page (moves list.row, or presses A).
+/// The page arrows' tile columns (PagedList_DrawPageNumbers, numbers ending
+/// at PAGE_NUMBERS_RIGHT) for `pages` pages.
+#define MENU_TOUCH_PAGER_LEFT(pages) (PAGE_NUMBERS_RIGHT - (pages) - 1)
+#define MENU_TOUCH_PAGER_RIGHT PAGE_NUMBERS_RIGHT
+/// A tap on a row of a PagedList's page (moves list.row, or presses A): 1;
+/// a tap on the pager's arrows (UiPager, ui_kit.h) turns the page as Left
+/// and Right do: 2, for the caller to redraw it; else 0. Always 0 on the GBA.
+#ifndef NATIVE
+#define MENU_TOUCH_LIST(list) 0
+#else
 #define MENU_TOUCH_LIST(list)                                                  \
-  MenuTouch_PickCell(MENU_TOUCH_LIST_LEFT, MENU_TOUCH_LIST_TOP,                \
-                     MENU_TOUCH_LIST_WIDTH, MENU_LIST_ROW_HEIGHT, 1,           \
-                     MENU_TOUCH_LIST_ROWS(list), &(list).row)
+  ({                                                                           \
+    s32 pages_ = ((list).entryCount + LIST_PAGE_SIZE - 1) / LIST_PAGE_SIZE;    \
+    s32 turn_ = UiPager_Step(pages_, MENU_TOUCH_PAGER_LEFT(pages_),            \
+                             MENU_TOUCH_PAGER_RIGHT);                          \
+    s32 result_ = 0;                                                           \
+    if (turn_ != 0) {                                                          \
+      Sound_PlayFar(SE_MENU_CURSOR_MOVE);                                      \
+      (list).page = ((list).page + turn_ + pages_) % pages_;                   \
+      if ((list).row >= MENU_TOUCH_LIST_ROWS(list))                            \
+        (list).row = MENU_TOUCH_LIST_ROWS(list) - 1;                           \
+      result_ = 2;                                                             \
+    } else if (MenuTouch_PickCell(MENU_TOUCH_LIST_LEFT, MENU_TOUCH_LIST_TOP,   \
+                                  MENU_TOUCH_LIST_WIDTH, MENU_LIST_ROW_HEIGHT, \
+                                  1, MENU_TOUCH_LIST_ROWS(list),               \
+                                  &(list).row)) {                              \
+      result_ = 1;                                                             \
+    }                                                                          \
+    result_;                                                                   \
+  })
+#endif
 
 /// The item commands (Use, Equip, Details over Give, Remove, Drop): rows 8
 /// pixels apart (the text at 32 and 40), columns taken as 46 pixels from 96.
