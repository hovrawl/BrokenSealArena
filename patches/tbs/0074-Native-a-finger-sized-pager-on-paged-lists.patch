@@ -74,6 +74,25 @@ void UiHeader_Touch(struct Window *header, s32 buttons);
 #endif
 struct Window *UiBackButton_Open(void);
 void UiBackButton_Close(struct Window *button);
+/// The pager of a paged list (its page numbers between two small arrows on
+/// the window's top border), finger-sized in the touch layout, as the UI
+/// kit's lists page: the item menu's 16 by 16 arrows, the up arrow (the
+/// previous page) over the small left arrow and the down arrow (the next) at
+/// the window's bottom right, each taking taps over 24 by 24. One list at a
+/// time: open it with the list's window, step it each frame with the page
+/// count and the two small arrows' tile columns (in the window's interior),
+/// close it before the window.
+/// UiPager_Step returns -1 or 1 when an arrow was tapped, else 0. Nothing in
+/// the classic layout or on the GBA.
+#ifdef NATIVE
+void UiPager_Open(struct Window *window);
+s32 UiPager_Step(s32 pages, s32 leftColumn, s32 rightColumn);
+void UiPager_Close(void);
+#else
+#define UiPager_Open(window)
+#define UiPager_Step(pages, leftColumn, rightColumn) 0
+#define UiPager_Close()
+#endif
 void UiList_Init(struct UiList *list, struct Window *window, s32 count,
                  s32 labelBase, s32 rowHeight, s32 top, s32 textX, s32 cursor);
 void UiList_SetGrid(struct UiList *list, s32 columns, s32 columnWidth);
