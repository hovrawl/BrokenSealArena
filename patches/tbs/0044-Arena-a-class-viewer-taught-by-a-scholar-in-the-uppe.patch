+/// Talking to the scholar (ACTOR_CLASS_VIEWER): choose a character in the
+/// party strip, then read that character's class lines (ClassViewer_Run). B in
+/// the strip leaves. Nothing about the party changes, so nothing is healed.
+s32 BattleArena_ClassViewer(s32 actorId) {
+  s32 member;
+
+  Event_Start();
+  Actor_SetAngleToward(actorId, gMainRoutineWork.leaderActorId, 0);
+  for (;;) {
+    member = ItemPicker_ChooseMember(3);
+    if (member < 0)
+      break;
+    ClassViewer_Run(member);
+  }
+  Event_End();
+  return 0;
+}
