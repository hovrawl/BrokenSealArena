+/// @file
+/// Arena romhack: four a side in a linked battle (ARENA_LINK4).
+// Part of battle.c.
+
+#include "../battle_internal.h"
+#include "arena_config.h"
+
+#if ARENA_LINK4
+/// The party's four places, in pixels (gBattlePlacement_StepPairs,
+/// battle_tables.s): x 80, and z 48, 16, -16 and -48.
+static const s8 sArenaLink_PlacesZ[4] = {45, 21, -3, -27};
+
+/// In a link battle with four opponents, stands them where the party's own four
+/// stand, mirrored across the field (x -80, the same z). The stock layout spaces
+/// characters 38 pixels apart from z 45, which puts a fourth at -69, past the
+/// party's end and small in the distance; three fit (30, -8, -46). Returns 1
+/// when it laid them out, 0 to leave it to the stock layout.
+static s32 ArenaLink_LayoutOpponents(s32 count, s32 *xPositions,
+                                     s32 *zPositions) {
+  s32 index;
+
+  if (gBattleWork->isLink == 0 || count != 4)
+    return 0;
+  for (index = 0; index < 4; index++) {
+    xPositions[index] = -80;
+    zPositions[index] = sArenaLink_PlacesZ[index];
+  }
+  return 1;
+}
+
+/// The half-size sheets (32 x 32, 16 blocks of sprite VRAM against 64) that
+/// stand in for the characters' battle sprites 300 to 303 on the opponents' side,
+/// so that eight characters and the battle's cursors fit in sprite VRAM. The
+/// sheets are made at build time by scripts/gen-opponent-sprites.py; rows 304,
+/// 306, 307 and 308 of the sprite table hold them.
+static const u16 sArenaLink_SmallSprites[4] = {304, 306, 307, 308};
+
+/// Returns the sprite an opponent character is drawn with: the half-size
+/// sheet for a character's own battle sprite (300 to 303), else sprite itself.
+static s32 ArenaLink_OpponentSprite(s32 sprite) {
+  if (sprite < BATTLE_CHARACTER(ISAAC) || sprite > BATTLE_CHARACTER(MIA))
+    return sprite;
+  return sArenaLink_SmallSprites[sprite - BATTLE_CHARACTER(ISAAC)];
+}
+#endif
diff --git a/games/tbs/src/battle/battle/placement.c b/games/tbs/src/battle/battle/placement.c
