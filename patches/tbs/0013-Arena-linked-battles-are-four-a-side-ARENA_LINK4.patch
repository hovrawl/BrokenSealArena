diff --git a/games/tbs/src/battle/battle_placement.c b/games/tbs/src/battle/battle_placement.c
index 1c5e8e8208..efb425109b 100644
--- a/games/tbs/src/battle/battle_placement.c
+++ b/games/tbs/src/battle/battle_placement.c
@@ -3,6 +3,7 @@
 // Part of battle.c.
 
 #include "battle_internal.h"
+#include "arena_config.h"
 
 /// The Actor_Create kind a battle object's actor is made with: one that makes
 /// no sprite, its battle sprites being attached afterwards.
@@ -235,6 +236,16 @@ void BattleObject_Make(struct BattleObject *battleObject, s32 unitId, s32 x,
     battleObject->overlay = 0;
   }
 
+#if ARENA_LINK4
+  // A character on the enemy side of a link battle is drawn from a half-size
+  // sheet with no weapon layer (the weapon pictures are full size).
+  if (gBattleState->isLink && unit->classId != CLASS_NONE &&
+      (unitId < 0 || unitId > ALLY_MAX)) {
+    battleObject->resource = ArenaLink_OpponentSprite(battleObject->resource);
+    battleObject->overlay = 0;
+  }
+#endif
+
   // Face the centre of the battlefield; enemies are drawn at 1.3 times their
   // size.
   facingAngle = Trig_Atan(y / 8, x) + DEGtoANG(180);
@@ -282,6 +293,11 @@ void BattlePlacement_LayoutEnemies(u16 *unitIds, s32 count, s32 *xPositions,
   s32 z = ((count - 1) * totalSpacing) / 2;
   s32 index;
 
+#if ARENA_LINK4
+  if (ArenaLink_LayoutOpponents(count, xPositions, zPositions))
+    return;
+#endif
+
   // z starts half a line's estimated length up and steps down by half of
   // each enemy's spacing before it (none for the first) and half after it.
   for (index = 0; index != count; index++) {
