+++ b/games/tbs/src/battle/battle/placement.c
@@ -3,6 +3,7 @@
 // Part of battle.c.
 
 #include "../battle_internal.h"
+#include "arena_config.h"
 
 /// Isaac and Garet hold a Machete with sprites of their own.
 #define SPRITE_ISAAC_MACHETE 480
@@ -258,6 +259,16 @@ void BattleObject_Make(struct BattleObject *actor, s32 unitId, s32 x, s32 y) {
     actor->overlay = 0;
   }
 
+#if ARENA_LINK4
+  // A character on the enemy side of a link battle is drawn from a half-size
+  // sheet with no weapon layer (the weapon pictures are full size).
+  if (gBattleWork->isLink && unit->classId != CLASS_NONE &&
+      (unitId < 0 || unitId > ALLY_MAX)) {
+    actor->resource = ArenaLink_OpponentSprite(actor->resource);
+    actor->overlay = 0;
+  }
+#endif
+
   // Face the centre of the battlefield (0x8000 is half a turn, so the
   // angle points back along the line to the origin); enemies are drawn at
   // 1.3 times their size. ACTOR_FALLS lets the actor fall.
@@ -304,6 +315,11 @@ void BattlePlacement_LayoutEnemies(u16 *actorIds, s32 count, s32 *xPositions,
   s32 z = ((count - 1) * totalSpacing) / 2;
   s32 index;
 
+#if ARENA_LINK4
+  if (ArenaLink_LayoutOpponents(count, xPositions, zPositions))
+    return;
+#endif
+
   // z starts half a line's estimated length up and steps down by half of
   // each enemy's spacing before it (none for the first) and half after it.
   for (index = 0; index != count; index++) {
