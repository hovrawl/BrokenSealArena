-static void Training_RunGrid(s32 unitId, s32 kind) {
-  struct Window *window = Training_OpenScreen();
-  struct Sprite *figures[GRID_PAGE];
-  s32 count = Training_GridCount(kind);
-  s32 pages = (count + GRID_PAGE - 1) / GRID_PAGE;
-  s32 cursor = 0;
-  s32 redraw = 1;
-  s32 notice = 0;
-  s32 figuresPage = -1;
-  s32 i;
-
-  for (i = 0; i < GRID_PAGE; i++)
-    figures[i] = 0;
-  for (;;) {
-    if (redraw) {
-      s32 first = (cursor / GRID_PAGE) * GRID_PAGE;
-
-      // Clears the window and the sprites of the last draw.
-      WindowSprite_PrepareForRedraw(window);
-      if (kind == TRAIN_GRID_DJINN && figuresPage != cursor / GRID_PAGE) {
-        figuresPage = cursor / GRID_PAGE;
-        for (i = 0; i < GRID_PAGE; i++) {
-          if (figures[i] != 0)
-            Sprite_Destroy(figures[i]);
-          figures[i] = 0;
-          if (first + i < count) {
-            figures[i] =
-                Sprite_Create(VENUS_DJINNI + (first + i) /
-                                                 TRAINING_DJINN_PER_ELEMENT);
-            if (figures[i] != 0)
-              Sprite_StartAnimation(figures[i], 2);
-          }
-        }
-      }
-      Training_DrawHeader(window, unitId);
-      for (i = 0; i < GRID_PAGE && first + i < count; i++) {
-        s32 x = (i % GRID_COLUMNS) * GRID_CELL_WIDTH;
-        s32 y = GRID_TOP + (i / GRID_COLUMNS) * GRID_CELL_HEIGHT;
-
-        if (first + i == cursor)
-          Text_DrawStringInWindow(gTraining_Cursor, window, x, y + 4);
-        Training_GridDrawCell(window, kind, first + i, x + 8, y, figures[i]);
-      }
-      if (notice != 0)
-        Text_DrawMessageAsTiles(notice, window, 0, GRID_FOOTER_Y);
-      else if (Training_GridOwned(kind, unitId, cursor))
-        Text_DrawMessageAsTiles(kind == TRAIN_GRID_DJINN ? MsgArenaOwned
-                                                         : MsgArenaKnown,
-                                window, TRAINING_LABEL_X, GRID_FOOTER_Y);
-      else
-        Training_DrawNumber(window, Training_GridCost(kind, cursor),
-                            TRAINING_LABEL_X, GRID_FOOTER_Y);
-      MessageArgument_ClearAll();
-      MessageArgument_Push(cursor / GRID_PAGE + 1, MESSAGE_ARGUMENT_NUMBER);
-      MessageArgument_Push(pages, MESSAGE_ARGUMENT_NUMBER);
-      Text_DrawMessageAsTiles(MsgArenaPage, window, 160, GRID_FOOTER_Y);
-      redraw = 0;
-    }
-    wait(1);
-    for (i = 0; i < GRID_PAGE; i++) {
-      if (figures[i] != 0)
-        Training_PlaceFigure(figures[i], TRAINING_CELL_FIGURE_X(i),
-                             TRAINING_CELL_FIGURE_Y(i));
-    }
-    if (gKeysRepeat & KEY_B)
-      break;
-    if (notice != 0) {
-      notice = 0;
-      redraw = 1;
-    }
-    if (gKeysRepeat & KEY_A) {
-      notice = Training_GridBuy(kind, unitId, cursor);
-      redraw = 1;
-    } else if ((gKeysRepeat & KEY_RIGHT) && cursor + 1 < count) {
-      cursor++;
-      redraw = 1;
-    } else if ((gKeysRepeat & KEY_LEFT) && cursor > 0) {
-      cursor--;
-      redraw = 1;
-    } else if ((gKeysRepeat & KEY_DOWN) && cursor + GRID_COLUMNS < count) {
-      cursor += GRID_COLUMNS;
-      redraw = 1;
-    } else if ((gKeysRepeat & KEY_UP) && cursor >= GRID_COLUMNS) {
-      cursor -= GRID_COLUMNS;
-      redraw = 1;
-    } else if (gKeysRepeat & KEY_R) {
-      cursor += GRID_PAGE;
-      if (cursor >= count)
-        cursor = count - 1;
-      redraw = 1;
-    } else if (gKeysRepeat & KEY_L) {
-      cursor -= GRID_PAGE;
-      if (cursor < 0)
-        cursor = 0;
-      redraw = 1;
-    }
-  }
-  for (i = 0; i < GRID_PAGE; i++) {
-    if (figures[i] != 0)
-      Sprite_Destroy(figures[i]);
-  }
-  Window_Close(window, 2);
-}
