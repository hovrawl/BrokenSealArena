@@ -232,6 +234,15 @@ static void Script_Load(const char *path) {
     } else if (!strcmp(word, "tap") && n >= 2) {
       Hold(Keys_Parse(arg1), 4);
       Hold(0, 20);
+    } else if (!strcmp(word, "touch") && n >= 3) {
+      // A tap at screen pixel (x, y): down for 4 frames, then up.
+      struct Command *c = Command_Add(CMD_HOLD);
+
+      c->frames = 4;
+      c->touch = 1;
+      c->touchX = strtol(arg1, NULL, 0);
