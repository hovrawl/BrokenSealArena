diff --git a/port/include/native/touch.h b/port/include/native/touch.h
new file mode 100644
index 0000000000..5d36c9c83a
--- /dev/null
+++ b/port/include/native/touch.h
@@ -0,0 +1,24 @@
+#ifndef NATIVE_TOUCH_H
+#define NATIVE_TOUCH_H
+
+/// @file
+/// Touch and mouse for the desktop build (and later the phone builds): one
+/// pointer, sampled each frame with the keys (native_touch.c). Game code asks
+/// whether a rectangle was tapped this frame: pressed and let go inside it.
+/// A rectangle in the UI's safe area's coordinates (what the window, menu
+/// and shop code lays out in) is moved by the safe area's offset first.
+
+/// The smallest tap target, in screen pixels: about a fingertip on a phone
+/// with the 160-line screen filling its short side.
+#define TOUCH_TARGET_MIN 24
+
+/// 1 when the pointer was let go this frame inside the rectangle (x, y,
+/// width, height, screen pixels) it was pressed in; it is then used up, so
+/// one tap answers one question.
+int Touch_TappedRect(int x, int y, int width, int height);
+/// As Touch_TappedRect, for a rectangle in the safe area's coordinates.
+int Touch_TappedUiRect(int x, int y, int width, int height);
+/// 1 while the pointer is down; its place in screen pixels.
+int Touch_Held(int *x, int *y);
+
+#endif
diff --git a/port/src/native_platform.c b/port/src/native_platform.c
index 9dc72bd13e..1e9e979946 100644
