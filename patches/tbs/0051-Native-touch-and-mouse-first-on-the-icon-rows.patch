+      Hold(0, 20);
     } else if (!strcmp(word, "mash") && n >= 3) {
       u32 i, times = strtoul(arg2, NULL, 0);
       u16 keys = Keys_Parse(arg1);
@@ -283,6 +294,7 @@ static void Script_Step(void) {
   if (sHoldLeft && --sHoldLeft)
     return;
   sKeys = 0;
+  sTouch = 0;
   while (sNext < sCount) {
     struct Command *c = &sCommands[sNext++];
     volatile u8 *at = (volatile u8 *)(uintptr_t)c->address;
@@ -292,6 +304,9 @@ static void Script_Step(void) {
       if (c->frames == 0)
         continue;
       sKeys = c->keys;
+      sTouch = c->touch;
+      sTouchX = c->touchX;
+      sTouchY = c->touchY;
       sHoldLeft = c->frames;
       return;
     case CMD_SHOT:
@@ -359,6 +374,12 @@ void Platform_Present(const u32 *frame) {
 
 u16 Platform_ReadKeys(void) { return sKeys; }
 
+int Platform_ReadPointer(int *x, int *y) {
+  *x = sTouchX;
+  *y = sTouchY;
+  return sTouch;
+}
+
 int Platform_ShouldQuit(void) {
   if (sScripted)
     return sDone;
diff --git a/port/src/platform_sdl.c b/port/src/platform_sdl.c
index 6a21b9e208..153f908d39 100644
--- a/port/src/platform_sdl.c
+++ b/port/src/platform_sdl.c
@@ -19,6 +19,10 @@ static SDL_Renderer *sRenderer;
 static SDL_Texture *sTexture;
 static SDL_Gamepad *sGamepad;
 static int sQuit;
+// The mouse (touch arrives as the mouse too: SDL's default), in screen
+// pixels. A click that goes down and up between two frames still shows as
+// down for one frame (sUpPending).
+static int sPointerX, sPointerY, sPointerDown, sUpPending;
 static Uint64 sNextFrame;
 
 #define FRAME_NS (SDL_NS_PER_SECOND * 280896ull / 16777216ull) // 59.73 Hz
@@ -70,6 +74,24 @@ static void Events_Poll(void) {
       if (event.key.key == SDLK_ESCAPE)
         sQuit = 1;
       break;
+    case SDL_EVENT_MOUSE_BUTTON_DOWN:
+    case SDL_EVENT_MOUSE_BUTTON_UP:
+    case SDL_EVENT_MOUSE_MOTION:
+      SDL_ConvertEventToRenderCoordinates(sRenderer, &event);
+      if (event.type == SDL_EVENT_MOUSE_MOTION) {
+        sPointerX = (int)event.motion.x;
+        sPointerY = (int)event.motion.y;
+      } else if (event.button.button == SDL_BUTTON_LEFT) {
+        sPointerX = (int)event.button.x;
+        sPointerY = (int)event.button.y;
+        if (event.type == SDL_EVENT_MOUSE_BUTTON_DOWN) {
+          sPointerDown = 1;
+          sUpPending = 0;
+        } else if (sPointerDown) {
+          sUpPending = 1;
+        }
+      }
+      break;
     case SDL_EVENT_GAMEPAD_ADDED:
       if (!sGamepad)
         sGamepad = SDL_OpenGamepad(event.gdevice.which);
@@ -108,6 +130,18 @@ void Platform_Present(const u32 *frame) {
   }
 }
 
+int Platform_ReadPointer(int *x, int *y) {
+  int down = sPointerDown;
+
+  *x = sPointerX;
+  *y = sPointerY;
+  if (sUpPending) {
+    sPointerDown = 0;
+    sUpPending = 0;
+  }
+  return down;
+}
+
 u16 Platform_ReadKeys(void) {
   const bool *k = SDL_GetKeyboardState(NULL);
   u16 keys = 0;
