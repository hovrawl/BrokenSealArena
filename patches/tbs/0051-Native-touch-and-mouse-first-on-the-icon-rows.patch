diff --git a/port/src/native_touch.c b/port/src/native_touch.c
new file mode 100644
index 0000000000..b9c57cecf6
--- /dev/null
+++ b/port/src/native_touch.c
@@ -0,0 +1,50 @@
+// The pointer: the platform reports where it is and whether it is down; each
+// frame this keeps where a press began and whether it ended this frame, so a
+// tap is a press and a release in the same rectangle.
+
+#include "native/native.h"
+#include "native/touch.h"
+
+static int sDown, sX, sY;
+static int sPressX, sPressY;
+static int sReleased; // let go this frame, not yet used up
+
+void Touch_Update(void) {
+  int x, y;
+  int down = Platform_ReadPointer(&x, &y);
+
+  sReleased = 0;
+  if (down && !sDown) {
+    sPressX = x;
+    sPressY = y;
+  }
+  if (!down && sDown)
+    sReleased = 1;
+  sDown = down;
+  if (down) {
+    sX = x;
+    sY = y;
+  }
+}
+
+static int Inside(int px, int py, int x, int y, int width, int height) {
+  return px >= x && px < x + width && py >= y && py < y + height;
+}
+
+int Touch_TappedRect(int x, int y, int width, int height) {
+  if (!sReleased || !Inside(sPressX, sPressY, x, y, width, height) ||
+      !Inside(sX, sY, x, y, width, height))
+    return 0;
+  sReleased = 0;
+  return 1;
+}
+
+int Touch_TappedUiRect(int x, int y, int width, int height) {
+  return Touch_TappedRect(x + gNativeUiOffset, y, width, height);
+}
+
+int Touch_Held(int *x, int *y) {
+  *x = sX;
+  *y = sY;
+  return sDown;
+}
