+/// A Back button for screens that run the game's own loops (the shops): a
+/// small window at the top right with B Back, which a tap turns into B for
+/// whatever screen is reading keys (Touch_SetBackZone). Only in a touch
+/// layout; returns 0 otherwise. Close it with UiBackButton_Close.
+struct Window *UiBackButton_Open(void) {
+  struct Window *button;
+
+  if (!UI_TOUCH_LAYOUT)
+    return 0;
+  button = Window_CreateFar(UI_SCREEN_TILES - 7, 0, 7, 3, WINDOW_FLAG_INSTANT);
+  Text_DrawMessageAsTilesFar(MsgArenaUiBack, button, 4, 0);
+#ifdef NATIVE
+  Touch_SetBackZone((UI_SCREEN_TILES - 7) * 8, 0, 7 * 8, 24);
+#endif
+  return button;
+}
+
+void UiBackButton_Close(struct Window *button) {
+  if (button == 0)
+    return;
+#ifdef NATIVE
+  Touch_SetBackZone(0, 0, 0, 0);
+#endif
+  Window_CloseFar(button, 2);
+}
+
 /// Sets a list up in `window`: `count` rows, messages labelBase + row, rows of
 /// `rowHeight` pixels from `top` inside the window, the text `textX` in (the
 /// hand sits 22 pixels before it), as many rows as fit showing.
