 }
 
+static int sBackX, sBackY, sBackWidth, sBackHeight;
+
+void Touch_SetBackZone(int x, int y, int width, int height) {
+  sBackX = x + gNativeUiOffset;
+  sBackY = y;
+  sBackWidth = width;
+  sBackHeight = height;
+}
+
+int Touch_BackTapped(void) {
+  return sBackWidth > 0 &&
+         Touch_TappedRect(sBackX, sBackY, sBackWidth, sBackHeight);
+}
