+/// A Back button that stays on screen while the game runs its own loops (the
+/// shops): a tap inside the rectangle (safe area coordinates) holds B for one
+/// frame, so whatever screen is reading keys takes it as B. width 0 clears it.
+void Touch_SetBackZone(int x, int y, int width, int height);
+/// Called by the frame's key update: 1 when the Back zone was tapped.
+int Touch_BackTapped(void);
 
 #endif
diff --git a/port/src/native_platform.c b/port/src/native_platform.c
index a066a266e0..191c6e2c5a 100644
--- a/port/src/native_platform.c
+++ b/port/src/native_platform.c
@@ -283,6 +283,8 @@ static void Keys_Update(void) {
   u16 pressed = Platform_ReadKeys() & 0x3ff;
 
   Touch_Update();
+  if (Touch_BackTapped())
+    pressed |= 0x0002; // B
   u16 keycnt = IO_REG16(REG_KEYCNT_OFFSET);
 
   IO_REG16(REG_KEYINPUT_OFFSET) = ~pressed & 0x3ff;
diff --git a/port/src/native_touch.c b/port/src/native_touch.c
