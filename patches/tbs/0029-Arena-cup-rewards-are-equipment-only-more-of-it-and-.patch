   }
 }
 
+/// After a fight every Djinni is back to normal: set, none on standby or
+/// recovering (the party's recovery list is emptied). A fight leaves the party's
+/// Djinn spent, and the next round should not start with them gone (Djinn do
+/// not count down by steps in the arena).
+void ArenaMenu_RestoreDjinn(void) {
+  struct DjinnRecoveryTable *table =
+      (struct DjinnRecoveryTable *)Djinn_GetRecoveryTable(0);
+  s32 count = Party_CountMembers();
+  s32 i;
+  s32 element;
+  s32 index;
+
+  table->list.count = 0;
+  for (i = 0; i < count; i++) {
+    s32 unitId = gMainRoutineWork.party[i];
+    struct Unit *unit = &gMainRoutineWork.units[unitId];
+
+    for (element = 0; element < 4; element++) {
+      for (index = 0; index < 7; index++) {
+        if ((unit->djinnHeld[element] & (1 << index)) &&
+            !(unit->djinnSet[element] & (1 << index)))
+          Djinn_Set(unitId, element, index);
+      }
+    }
+    Unit_Calculate(unitId);
+  }
+}
+
 /// The attendant reports the coins a battle just won, and the party is healed
-/// for the next one, unless the cup does not heal.
+/// for the next one, unless the cup does not heal. The Djinn are set again
+/// either way.
 void ArenaMenu_ShowWin(s32 actorId, s32 reward) {
   MessageArgument_ClearAll();
   MessageArgument_Push(reward, MESSAGE_ARGUMENT_NUMBER);
   Event_SetMessageId(MsgArenaVictory);
   FieldMessage_ShowAtActor(actorId, 0);
+  ArenaMenu_RestoreDjinn();
   if (ArenaCup_Heals())
     Party_RestoreHpPp(1);
 }
