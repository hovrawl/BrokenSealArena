       !GameFlag_Get(FLAG_MONSTER_BATTLE)) {
     Party_RestoreHpPp(1);
+#if ARENA_TRAINING
+    ArenaMenu_RestoreDjinn();
+#else
     DjinnRecovery_CountDownTwenty();
+#endif
   }
   return 0;
 }
