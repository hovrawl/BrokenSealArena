+#if ARENA_RULES_EFFECT_IDS
+/// Arena romhack (Golden Sun Reloaded, forum topic 2779): the effect ids that run
+/// another effect's handler. The ability data gives such an alias its own odds
+/// (Battle_GetEffectBaseSuccessRate's tables are by id), so one handler serves
+/// several ids: a one-stage Dull at 75 percent, the two-stage version as id 36
+/// at 90, and so on. Dull, Impair and Weaken (8, 12, 16) become the one-stage
+/// Blunt, Debilitate and Enfeeble; Confuse (21) is Delude's handler, Charm
+/// (22) Paralyze's, Reflect (30) Haunt's and the unused 54 Condemn's; 36 to 38
+/// are the two-stage versions the old ids lose, 39 and 40 Taint and Poison,
+/// 41 Paralyze, 43 Haunt.
+static s32 ArenaRules_EffectHandler(s32 effect) {
+  switch (effect) {
+  case 8: return ABILITY_EFFECT_ATTACK_DOWN;
+  case 12: return ABILITY_EFFECT_DEFENSE_DOWN;
+  case 16: return ABILITY_EFFECT_RESISTANCE_DOWN;
+  case 21: return ABILITY_EFFECT_DELUSION;
+  case 22: return ABILITY_EFFECT_STUN;
+  case 30: return ABILITY_EFFECT_HAUNT;
+  case 36: return ABILITY_EFFECT_ATTACK_DOWN_2;
+  case 37: return ABILITY_EFFECT_DEFENSE_DOWN_2;
+  case 38: return ABILITY_EFFECT_RESISTANCE_DOWN_2;
+  case 39: return ABILITY_EFFECT_POISON;
+  case 40: return ABILITY_EFFECT_VENOM;
+  case 41: return ABILITY_EFFECT_STUN;
+  case 43: return ABILITY_EFFECT_HAUNT;
+  case 54: return ABILITY_EFFECT_INSTANT_DEATH;
+  default: return effect;
+  }
+}
+#define ARENA_EFFECT_SWITCH(effect) ArenaRules_EffectHandler(effect)
+#else
+#define ARENA_EFFECT_SWITCH(effect) (effect)
+#endif
 
