+#if ARENA_RULES_SUMMON_TURNS
+/// Arena romhack (Golden Sun Reloaded, forum topic 2779): the summons that cost
+/// three Djinn wait for the second turn and those that cost four for the third.
+/// BattleWork.arenaTurn counts the turns the battle has finished: Battle_Run
+/// zeroes it with the rest of the work, BattleUnit_Collect clears it again and
+/// Battle_ProcessTurnEnd counts it.
+
+/// The summons that may be called on turn `turn` (from 0), one bit each, by id:
+/// ids 0 to 7 (one and two Djinn) from the start, 8 to 11 (three) from turn 1,
+/// the rest from turn 2.
+static u32 ArenaRules_SummonTierMask(s32 turn) {
+  if (turn <= 0)
+    return 0xff;
+  if (turn == 1)
+    return 0xfff;
+  return 0xffff;
+}
+#endif
+
