index fd018d95bb..2a739b49d2 100644
--- a/games/tbs/include/arena_config.h
+++ b/games/tbs/include/arena_config.h
@@ -40,6 +40,68 @@
 #ifndef ARENA_RULES_DAMAGE
 #define ARENA_RULES_DAMAGE 1 ///< the base damage formula, summon HP damage and class ward
 #endif
+#ifndef ARENA_RULES_GUARD
+#define ARENA_RULES_GUARD 1 ///< Total Defense takes a third of the damage, not a tenth
+#endif
+#ifndef ARENA_RULES_HEAL
+#define ARENA_RULES_HEAL 1 ///< healing: a smaller element multiplier; Ember restores a tenth of max PP
+#endif
+#ifndef ARENA_RULES_REVIVE
+#define ARENA_RULES_REVIVE 1 ///< a revival's HP comes from the ability's power (tenths of a percent)
+#endif
+#ifndef ARENA_RULES_EFFECT_IDS
+#define ARENA_RULES_EFFECT_IDS 1 ///< several effect ids are aliases of one handler with their own odds (needs the ability data)
+#endif
+#ifndef ARENA_RULES_DURATIONS
+#define ARENA_RULES_DURATIONS 1 ///< Impact, Guard and Ward last 5 turns, Luff is a Bind, the curse counts 4
+#endif
+#ifndef ARENA_RULES_STAGES
+#define ARENA_RULES_STAGES 1 ///< a Defense stage is worth 3/16, a Resistance stage 15
+#endif
+#ifndef ARENA_RULES_RECOVERY
+#define ARENA_RULES_RECOVERY 1 ///< the chances to shake off a debuff or status early
+#endif
+#ifndef ARENA_RULES_STATUS
+#define ARENA_RULES_STATUS 1 ///< haunt 40 percent, delusion misses 70 percent and stops unleashes
+#endif
+#ifndef ARENA_RULES_CLASS20
+#define ARENA_RULES_CLASS20 1 ///< class multipliers are in twentieths (needs the class data doubled)
+#endif
+#ifndef ARENA_RULES_CAPS
+#define ARENA_RULES_CAPS 1 ///< element power and resistance and PP regeneration are capped at 255
+#endif
+#ifndef ARENA_RULES_ITEMS
+#define ARENA_RULES_ITEMS 1 ///< stat-boost items give their stated amount, with no random part
+#endif
+#ifndef ARENA_RULES_SUMMON_TURNS
+#define ARENA_RULES_SUMMON_TURNS 1 ///< the 3- and 4-Djinn summons wait for the second and third turn
+#endif
+
+#if ARENA_RULES_STATUS
+/// A deluded unit's attack misses on a roll of 0 to this out of 255 (Reloaded: 70
+/// percent; stock 60).
+#define ARENA_DELUSION_MISS 179
+#else
+#define ARENA_DELUSION_MISS 152
+#endif
+
+#if ARENA_RULES_REVIVE
+/// The HP a revival restores: the target's max HP times the ability's power in
+/// tenths of a percent, plus 1, at most the max (Golden Sun Reloaded, forum
+/// topic 2779: Water of Life revives to 25 percent, power 250). A power of 0, as
+/// the stock data has, keeps the stock amount `stockHp`. Used by the battle
+/// and the item menu.
+static inline int ArenaRules_ReviveHp(int hpMax, int power, int stockHp) {
+  unsigned amount;
+
+  if (power == 0)
+    return stockHp;
+  amount = (unsigned)hpMax * (unsigned)power / 1000u;
+  if (amount >= (unsigned)hpMax)
+    return hpMax;
+  return (int)amount + 1;
+}
+#endif
 
 #ifndef ARENA_LINK4
 #define ARENA_LINK4 1
