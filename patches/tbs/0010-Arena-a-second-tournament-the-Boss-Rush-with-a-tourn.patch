@@ -1,16 +1,34 @@
 /// @file
-/// Arena romhack: a monster series you can leave and come back to. It is a
-/// Gauntlet of ARENA_LADDER_COUNT rounds. After a win the series stays running
-/// and the player steps back into the circle when ready; talking to the attendant
-/// while it runs offers to give up; clearing the last round ends it as a win; a
-/// loss ends it (stock). Giving up and clearing are not losses.
+/// Arena romhack: a monster series you can leave and come back to. A series is
+/// one tournament (FLAG_ARENA_TOURNAMENT) of ARENA_ROUNDS(tournament) rounds.
+/// After a win the series stays running and the player steps back into the
+/// circle when ready; talking to the attendant while it runs offers to give up;
+/// clearing the last round ends it as a win; a loss ends it (stock). Giving up and
+/// clearing are not losses.
 // Part of battle_arena.c: it uses that file's statics.
 
 #include "static_assert.h"
 
-// MsgArenaGiveUpPrompt and MsgArenaNextRound say "of 12": a field message reads
-// every number blank from the first number pushed, so the count is in the text.
-STATIC_ASSERT(ARENA_LADDER_COUNT == 12);
+// The messages say their tournament's round count ("of 12", "of 6"): a field
+// message reads every number blank from the first number pushed, so the count is
+// in the text. Each tournament has three consecutive messages, in the order the
+// ARENA_MSG kinds below name, and tournament t's are 3 * t after the first's.
+STATIC_ASSERT(ARENA_GAUNTLET_ROUNDS == 12);
+STATIC_ASSERT(ARENA_BOSS_RUSH_ROUNDS == 6);
+#define ARENA_MSG_GIVE_UP 0
+#define ARENA_MSG_NEXT_ROUND 1
+#define ARENA_MSG_CLEARED 2
+#define ARENA_MSG(kind, tournament)                                            \
+  (MsgArenaGiveUpPrompt + 3 * (tournament) + (kind))
+
+/// The tournament of the running series, from its persistent byte; anything out
+/// of range (a file from before tournaments) is the Gauntlet.
+static s32 ArenaSeries_Tournament(void) {
+  s32 tournament = FieldGameFlag_GetByte(FLAG_ARENA_TOURNAMENT);
+
+  return tournament < ARENA_TOURNAMENT_COUNT ? tournament
+                                             : ARENA_TOURNAMENT_GAUNTLET;
+}
 
 /// The series is over. As the stock "No" after a win ends it: the flag and the
 /// win count are cleared, the attendant reports the run and the best streak is
@@ -45,7 +63,7 @@ static void ArenaSeries_GiveUp(void) {
   MessageArgument_Push(
       gMainRoutineWork.linkTallies[LINK_TALLY_MONSTER_STREAK] + 1,
       MESSAGE_ARGUMENT_NUMBER);
-  Event_SetMessageId(MsgArenaGiveUpPrompt);
+  Event_SetMessageId(ARENA_MSG(ARENA_MSG_GIVE_UP, ArenaSeries_Tournament()));
   FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
   if (Event_AskYesNoWithActorAnimation(0, 0) == YES) {
     ArenaSeries_End();
@@ -60,16 +78,17 @@ static void ArenaSeries_GiveUp(void) {
 /// say the tournament is cleared and end it as a win.
 static void ArenaSeries_AfterWin(void) {
   s32 won = gMainRoutineWork.linkTallies[LINK_TALLY_MONSTER_STREAK];
+  s32 tournament = ArenaSeries_Tournament();
 
   Actor_SetAngleToward(ACTOR_ATTENDANT, gMainRoutineWork.leaderActorId, 0);
-  if (won >= ARENA_LADDER_COUNT) {
-    Event_SetMessageId(MsgArenaGauntletCleared);
+  if (won >= ARENA_ROUNDS(tournament)) {
+    Event_SetMessageId(ARENA_MSG(ARENA_MSG_CLEARED, tournament));
     FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
     ArenaSeries_End();
     return;
   }
   MessageArgument_ClearAll();
   MessageArgument_Push(won, MESSAGE_ARGUMENT_NUMBER);
-  Event_SetMessageId(MsgArenaNextRound);
+  Event_SetMessageId(ARENA_MSG(ARENA_MSG_NEXT_ROUND, tournament));
   FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
 }
