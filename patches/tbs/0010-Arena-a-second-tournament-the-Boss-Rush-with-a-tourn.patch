-/// The rounds in the Monster Gauntlet: the rungs of gArenaLadder. Clearing the last
-/// is a win and ends the series.
-#define ARENA_LADDER_COUNT 12
+// Tournaments. The player chooses one at the attendant; it is kept in a
+// persistent byte flag, so a save remembers it. Flags 0x7f8 to 0x7ff are the byte
+// at index 0xff of the game flags: no name in flags.h refers to them and no code
+// computes a flag number there (the computed ranges are the Djinn, the Psynergy
+// tints, the shop stock at 0x400 plus a row, and ENEMY_DEFEATED_FLAG at 0x600 plus
+// an enemy). More bytes can be claimed downward from here, and listed here.
+#define FLAG_ARENA_TOURNAMENT 0x7f8
+
+#define ARENA_TOURNAMENT_GAUNTLET 0
+#define ARENA_TOURNAMENT_BOSS_RUSH 1
+#define ARENA_TOURNAMENT_COUNT 2
+
+/// The rounds of each tournament: the rungs of its ladder in arena_ladder.c.
+/// Clearing the last is a win and ends the series. The messages for a
+/// tournament say its round count (a field message with two number blanks shows
+/// the first twice), and arena_series.c asserts these.
+#define ARENA_GAUNTLET_ROUNDS 12
+#define ARENA_BOSS_RUSH_ROUNDS 6
+#define ARENA_ROUNDS(tournament) \
+  ((tournament) == ARENA_TOURNAMENT_BOSS_RUSH ? ARENA_BOSS_RUSH_ROUNDS \
+                                              : ARENA_GAUNTLET_ROUNDS)
+
+/// Whether the party is healed after each win and on leaving the manager while a
+/// series runs. A tournament can turn it off: the Boss Rush does.
+#define ARENA_HEALS(tournament) ((tournament) != ARENA_TOURNAMENT_BOSS_RUSH)
 
