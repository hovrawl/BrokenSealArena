From 46b3c1ed8e9ceb9ecbc8ab677700383523adbddb Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Sun, 1 Nov 2026 16:34:09 +1100
Subject: [PATCH] Arena: the wary visitor stands on the upper left landing

At (172, 228) he blocked the walk to the attendant (the 4v4 link script never reached her).
He now stands at (84, 124), clear of every route.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/scene/battle_arena.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/games/tbs/src/scene/battle_arena.c b/games/tbs/src/scene/battle_arena.c
index fe9eb78544..a8b1402664 100644
--- a/games/tbs/src/scene/battle_arena.c
+++ b/games/tbs/src/scene/battle_arena.c
@@ -1936,7 +1936,7 @@ struct ActorPlacement gBattleArenaActorPlacements[] = {
     ACTOR_PLACEMENT(SPRITE_WOMAN_WITH_FAIR_HAIR, CONDITION_ALWAYS, MOVEMENT_TYPE_STAND,
         328, 0, 88, FACING_SOUTH, TALK_FACING_PARTY_AND_BACK, 0),
     ACTOR_PLACEMENT(SPRITE_STRONGMAN, CONDITION_ALWAYS, MOVEMENT_TYPE_STAND,
-        172, 0, 228, FACING_EAST, TALK_FACING_PARTY_AND_BACK, 0),
+        84, 0, 124, FACING_EAST, TALK_FACING_PARTY_AND_BACK, 0),
     // Trophies (ACTOR_TROPHY_FIRST on), one for each cup, once it is cleared.
     ACTOR_PLACEMENT(309, IF_FLAG_SET(FLAG_ARENA_TROPHY_FIRST + 0), MOVEMENT_TYPE_STAND,
         70, 7, 288, FACING_SOUTH, TALK_FACING_PARTY_AND_BACK, 0),
@@ -2028,7 +2028,7 @@ struct ActorPlacement gBattleArenaBattleActorPlacements[] = {
     ACTOR_PLACEMENT(SPRITE_WOMAN_WITH_FAIR_HAIR, CONDITION_ALWAYS, MOVEMENT_TYPE_STAND,
         328, 0, 88, FACING_SOUTH, TALK_FACING_PARTY_AND_BACK, 0),
     ACTOR_PLACEMENT(SPRITE_STRONGMAN, CONDITION_ALWAYS, MOVEMENT_TYPE_STAND,
-        172, 0, 228, FACING_EAST, TALK_FACING_PARTY_AND_BACK, 0),
+        84, 0, 124, FACING_EAST, TALK_FACING_PARTY_AND_BACK, 0),
     // Trophies (ACTOR_TROPHY_FIRST on), one for each cup, once it is cleared.
     ACTOR_PLACEMENT(309, IF_FLAG_SET(FLAG_ARENA_TROPHY_FIRST + 0), MOVEMENT_TYPE_STAND,
         70, 7, 288, FACING_SOUTH, TALK_FACING_PARTY_AND_BACK, 0),
-- 
