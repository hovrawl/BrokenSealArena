   return gains;
 }
 
+#if ARENA_RULES_LEVELUP
+/// Arena romhack: the base stats a character has at `level` from levelling
+/// alone, as Unit_LevelUp adds them without the random part, written to
+/// out[0..5] in the stat counter's order (HP, PP, Attack, Defense, Agility,
+/// Luck). A stat boost raises a base stat above this, so the stat counter
+/// takes boosts applied = (base now - this) / the boost's amount, and Reset sets
+/// the base back to this.
+void Unit_GetLevelBase(s32 unitId, s32 level, s32 *out) {
+  struct CharacterDefinition *growth = Character_GetDefinition(unitId);
+  s32 l;
+  s32 band;
+  s32 span;
+
+  for (l = 0; l < 6; l++)
+    out[l] = 0;
+  for (l = 1; l <= level; l++) {
+    if (l == 1) {
+      out[0] += growth->hp[0];
+      out[1] += growth->pp[0];
+      out[2] += growth->atk[0];
+      out[3] += growth->def[0];
+      out[4] += growth->agi[0];
+      out[5] += growth->luck[0];
+    }
+    band = l / 20;
+    CLAMP(band, 0, 4);
+    span = l >= 20 ? 20 : 19;
+#define ARENA_BASE_GAIN(stat, i)                                               \
+  out[i] += l * (growth->stat[band + 1] - growth->stat[band]) / span -        \
+            (l - 1) * (growth->stat[band + 1] - growth->stat[band]) / span
+    ARENA_BASE_GAIN(hp, 0);
+    ARENA_BASE_GAIN(pp, 1);
+    ARENA_BASE_GAIN(atk, 2);
+    ARENA_BASE_GAIN(def, 3);
+    ARENA_BASE_GAIN(agi, 4);
+    ARENA_BASE_GAIN(luck, 5);
+#undef ARENA_BASE_GAIN
+  }
+}
+#endif
+
