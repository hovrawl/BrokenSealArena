-/// A stock entry is a stat's number or a Djinni's: its element times seven plus
-/// its place among that element's. (The Psynergy counter is retired: after the
-/// Reloaded changes no Psynergy is limited to a shop.)
+/// The boosts of a stat the cups have given so far.
+static s32 ArenaBoost_Earned(s32 stat) {
+  return GameFlag_GetByteFar(FLAG_ARENA_BOOSTS + stat * 8);
+}
+
+/// The boosts of a stat applied to one character: what its base stat holds
+/// above the stat from levelling alone, in boosts.
+static s32 ArenaBoost_Applied(s32 unitId, s32 stat) {
+  s32 base[6];
+  s32 extra;
+
+  Unit_GetLevelBaseFar(unitId, Unit_GetFar(unitId)->level, base);
+  extra = ArenaStat_Value(Unit_GetFar(unitId), stat) - base[stat];
+  return extra > 0 ? extra / ArenaStat_Step(stat) : 0;
+}
+
+/// The boosts of a stat applied across the party.
+static s32 ArenaBoost_Used(s32 stat) {
+  struct ShopWork *shop = gMenuWork;
+  s32 used = 0;
+  s32 i;
+
+  for (i = 0; i < shop->partyMemberCount; i++)
+    used += ArenaBoost_Applied(shop->partyMemberIds[i], stat);
+  return used;
+}
+
+/// The boosts of a stat still to spend.
+static s32 ArenaBoost_Left(s32 stat) {
+  s32 left = ArenaBoost_Earned(stat) - ArenaBoost_Used(stat);
+
+  return left > 0 ? left : 0;
+}
+
+/// Takes every boost back: each base stat of the party goes to the stat from
+/// levelling alone.
+static void ArenaBoost_Reset(void) {
+  struct ShopWork *shop = gMenuWork;
+  s32 base[6];
+  s32 i;
+  s32 stat;
+
+  for (i = 0; i < shop->partyMemberCount; i++) {
+    s32 unitId = shop->partyMemberIds[i];
+
+    Unit_GetLevelBaseFar(unitId, Unit_GetFar(unitId)->level, base);
+    for (stat = 0; stat < ARENA_STAT_COUNT; stat++) {
+      s32 extra = ArenaStat_Value(Unit_GetFar(unitId), stat) - base[stat];
+
+      if (extra > 0)
+        ArenaStat_Add(Unit_GetFar(unitId), stat,
+                      -(extra / ArenaStat_Step(stat)) * ArenaStat_Step(stat));
+    }
+    Unit_CalculateFar(unitId);
+  }
+}
