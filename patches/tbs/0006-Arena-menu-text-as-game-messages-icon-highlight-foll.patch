-#define ARENA_MENU_LABEL_WIDTH 11
-
-/// Arena romhack: a prompt in a window across the top of the screen and a row
-/// of command icons across the bottom, as the shops draw them, with a label of
-/// the caller's own beside the icons. `icons` holds the command icon numbers
-/// (COMMAND_ICON_*, at most six) and `labels` the text shown for each. Returns
-/// the position chosen, or -1 for B. Left and Up, Right and Down move. The
-/// icons' own names are fixed messages, so the label is drawn here instead.
-/// Called from the Battle Arena overlay through WINDOW.S.
-s32 ArenaMenu_IconChoose(const u8 *prompt, const u8 *icons,
-                         const u8 *const *labels, s32 count) {
-  struct Window *top;
-  struct IconMenuWork *work;
-  s32 selection = 0;
-  s32 redraw = 1;
+#define ARENA_MENU_LABEL_WIDTH 13
+
+/// Arena romhack: a message window across the top of the screen and a row of
+/// command icons across the bottom, as the shops draw them. `prompt` is the
+/// message shown, `icons` the command icon numbers (COMMAND_ICON_*, at most
+/// six) and `labelBase` the first of that many consecutive messages naming
+/// them, as IconMenu_Center takes them. Returns the position chosen, or -1 for
+/// B. Called from the Battle Arena overlay through WINDOW.S.
+s32 ArenaMenu_IconChoose(s32 prompt, const u8 *icons, s32 labelBase,
+                         s32 count) {
   s32 result;
   s32 i;
 
   // Wait for the keys that opened it to be let go.
   while (gKeysHeld != 0)
     wait(1);
-  top = Window_Create(0, 0, 30, 6, WINDOW_FLAG_INSTANT);
-  Text_DrawStringInWindow(prompt, top, 8, 8);
+  // The prompt, as a shopkeeper's line is shown (Shop_ShowKeeperMessage).
+  Message_CloseFinishedWindows();
+  Message_OpenWindow(prompt, 5, 0, 0x22);
+  while (Message_AllTyped() == 0)
+    wait(1);
+  wait(1);
   IconMenu_Open();
   for (i = 0; i < count; i++)
     IconMenu_AddIcon(icons[i]);
-  IconMenu_Center(17, ARENA_MENU_LABEL_WIDTH, 0);
-  work = gIconMenuWork;
-  for (;;) {
-    if (redraw) {
-      WindowSprite_PrepareForRedraw(work->window);
-      Text_DrawStringInWindow(labels[selection], work->window, 0, 0);
-      redraw = 0;
-    }
-    wait(1);
-    if (gKeysPressed & KEY_A) {
-      Sound_PlayFar(SE_MENU_CONFIRM);
-      result = selection;
-      break;
-    }
-    if ((gKeysPressed & KEY_B) || (gKeysPressed & KEY_START)) {
-      Sound_PlayFar(SE_MENU_CANCEL);
-      result = -1;
-      break;
-    }
-    if ((gKeysRepeat & KEY_LEFT) || (gKeysRepeat & KEY_UP)) {
-      Sound_PlayFar(SE_MENU_CURSOR_MOVE);
-      if (--selection < 0)
-        selection = count - 1;
-      redraw = 1;
-    } else if ((gKeysRepeat & KEY_RIGHT) || (gKeysRepeat & KEY_DOWN)) {
-      Sound_PlayFar(SE_MENU_CURSOR_MOVE);
-      if (++selection >= count)
-        selection = 0;
-      redraw = 1;
-    }
-  }
+  IconMenu_Center(17, ARENA_MENU_LABEL_WIDTH, labelBase);
+  result = IconMenu_Run(0);
   IconMenu_Close();
-  Window_Close(top, 2);
+  Message_CloseFinishedWindows();
   return result;
 }
