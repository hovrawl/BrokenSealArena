+/// @file
+/// Arena romhack: a monster series you can leave and come back to. It is a
+/// Gauntlet of ARENA_LADDER_COUNT rounds. After a win the series stays running
+/// and the player steps back into the circle when ready; talking to the attendant
+/// while it runs offers to give up; clearing the last round ends it as a win; a
+/// loss ends it (stock). Giving up and clearing are not losses.
+// Part of battle_arena.c: it uses that file's statics.
+
+// Part of battle_arena.c (included before BattleArena_ChooseBattleMode), which has the includes.
+
+// MsgArenaGiveUpPrompt and MsgArenaNextRound say "of 12": a field message reads
+// every number blank from the first number pushed, so the count is in the text.
+STATIC_ASSERT(ARENA_LADDER_COUNT == 12);
+
+/// The series is over. As the stock "No" after a win ends it: the flag and the
+/// win count are cleared, the attendant reports the run and the best streak is
+/// kept. The record is not written into a file
+/// (BattleArena_SaveMonsterBattleResults does nothing under ARENA_TRAINING).
+/// Starting a series set FLAG_BATTLE_ARENA_PLAYER_APPLIED; the stock flow clears
+/// it when a battle begins, so a series ended before any fight clears it here, or
+/// the link poll reports the link lost.
+static void ArenaSeries_End(void) {
+  GameFlag_Clear(FLAG_MONSTER_BATTLE);
+  GameFlag_Clear(FLAG_BATTLE_ARENA_PLAYER_APPLIED);
+  FieldGameFlag_SetByte(FLAG_MONSTER_BATTLE_WINS, -1);
+  MessageArgument_ClearAll();
+  MessageArgument_Push(gMainRoutineState.linkTallies[LINK_TALLY_MONSTER_STREAK],
+                       MESSAGE_ARGUMENT_NUMBER);
+  if (gMainRoutineState.linkTallies[LINK_TALLY_MONSTER_BEST_STREAK] <
+      gMainRoutineState.linkTallies[LINK_TALLY_MONSTER_STREAK]) {
+    gMainRoutineState.linkTallies[LINK_TALLY_MONSTER_BEST_STREAK] =
+        gMainRoutineState.linkTallies[LINK_TALLY_MONSTER_STREAK];
+    Event_SetMessageId(MsgLobbyWonNumberBattleBroke);
+  } else {
+    Event_SetMessageId(MsgLobbyWonNumberBattle);
+  }
+  Event_OpenMessage(ACTOR_ATTENDANT, 0);
+  BattleArena_WriteSlotValue(BATTLE_ARENA_SLOT_SIGNATURE);
+}
+
+/// Talking to the attendant while a series runs: "Round n of m. Do you want to
+/// give up?" Yes ends the series (not a loss); No lets it carry on.
+static void ArenaSeries_GiveUp(void) {
+  MessageArgument_ClearAll();
+  MessageArgument_Push(
+      gMainRoutineState.linkTallies[LINK_TALLY_MONSTER_STREAK] + 1,
+      MESSAGE_ARGUMENT_NUMBER);
+  Event_SetMessageId(MsgArenaGiveUpPrompt);
+  Event_OpenMessage(ACTOR_ATTENDANT, 0);
+  if (Event_AskYesNoWithActorAnimation(0, 0) == YES) {
+    ArenaSeries_End();
+  } else {
+    Event_SetMessageId(MsgLobbyGoodLuck);
+    Event_OpenMessage(ACTOR_ATTENDANT, 0);
+  }
+}
+
+/// After a monster battle is won (the win and its coins are already counted):
+/// say the round is won and leave the series running, or, after the last round,
+/// say the tournament is cleared and end it as a win.
+static void ArenaSeries_AfterWin(void) {
+  s32 won = gMainRoutineState.linkTallies[LINK_TALLY_MONSTER_STREAK];
+
+  Actor_FaceActor(ACTOR_ATTENDANT, gMainRoutineState.leaderActorId, 0);
+  if (won >= ARENA_LADDER_COUNT) {
+    Event_SetMessageId(MsgArenaGauntletCleared);
+    Event_OpenMessage(ACTOR_ATTENDANT, 0);
+    ArenaSeries_End();
+    return;
+  }
+  MessageArgument_ClearAll();
+  MessageArgument_Push(won, MESSAGE_ARGUMENT_NUMBER);
+  Event_SetMessageId(MsgArenaNextRound);
+  Event_OpenMessage(ACTOR_ATTENDANT, 0);
+}
