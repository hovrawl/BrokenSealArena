   window = Message_OpenWindow(MsgLobbySavingMonsterBattle, 5, 4, 1);
@@ -1615,7 +1625,9 @@ s32 BattleArena_RunRoundResult(void) {
     if (gMainRoutineWork.coins > 999999)
       gMainRoutineWork.coins = 999999;
     ArenaMenu_ShowWin(ACTOR_ATTENDANT, reward);
-#endif
+    // The series stays running until it is lost, given up or cleared.
