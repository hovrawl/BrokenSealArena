-static const s32 sFileListTrophySprites[4] = {309, 310, 311, 313};
+/// The sprite of each cup's trophy, the same ones as in the lobby, in cup order.
+static const s32 sFileListTrophySprites[ARENA_CUP_COUNT] = {
+    309, 310, 311, 312, 313, 315, 316, 317, 318};
 
-/// Shows the four trophy sprites, one for each tier of cups, in a row from tile
-/// (x, y) inside `window`, and starts placing them every frame
-/// (FileList_PlaceTrophySprites). A tier with no cup cleared gets none. Does
+/// The cups on a page of the file list, and the pages (every file has them all,
+/// so a window never has stale text), and how far apart the trophies stand.
+#define FILE_LIST_CUPS_PER_PAGE 5
+#define FILE_LIST_CUP_PAGES                                                    \
+  ((ARENA_CUP_COUNT + FILE_LIST_CUPS_PER_PAGE - 1) / FILE_LIST_CUPS_PER_PAGE)
+#define FILE_LIST_CUP_SPACING 16
+
+/// Whether `summary`'s file has cleared `cup`.
+static s32 FileList_CupCleared(const struct SaveFileSummary *summary, s32 cup) {
+  return (summary->cupBits[cup >> 3] >> (cup & 7)) & 1;
+}
+
+/// The sprite slot of trophy `index` on a page: the Djinn figures' four slots
+/// and then the unused first of the Djinn menu's figure scales, which lies in
+/// a gap of the shop's work that the party sprites do not reach.
+static struct Sprite **FileList_TrophySlot(struct ItemMenuFiguresView *menu,
+                                           s32 index) {
+  if (index < 4)
+    return &menu->animations[index];
+  return (struct Sprite **)&menu->phases[index - 4];
+}
+
+/// Shows the trophies of page `page` of save file `summary`'s cups in a row from
+/// tile (x, y) inside `window`, and starts placing them every frame
+/// (FileList_PlaceTrophySprites). A cup not cleared is drawn in grey. Does
 /// nothing when `window` is NULL.
 void FileList_ShowTrophySprites(struct Window *window, s32 x, s32 y,
-                                struct SaveFileSummary *summary) {
+                                struct SaveFileSummary *summary, s32 page) {
   struct ItemMenuFiguresView *menu = gMenuWork;
   s32 i;
 
   if (window != NULL) {
-    for (i = 0; i < 4; i++) {
+    for (i = 0; i < FILE_LIST_CUPS_PER_PAGE; i++) {
       struct Sprite *sprite = NULL;
+      s32 cup = page * FILE_LIST_CUPS_PER_PAGE + i;
 
-      if (summary->cups[i] != 0) {
-        sprite = Sprite_CreateFar(sFileListTrophySprites[i]);
+      if (cup < ARENA_CUP_COUNT) {
+        sprite = Sprite_CreateFar(sFileListTrophySprites[cup]);
         if (sprite != NULL) {
           Sprite_StartAnimationFar(sprite, 2);
           sprite->flags = 0;
           sprite->image.priority = 0;
+          if (!FileList_CupCleared(summary, cup))
+            Sprite_SetAnimationColorModesFar(sprite, SPRITE_COLOR_GREY);
         }
       }
-
-      menu->animations[i] = sprite;
-      menu->positionsX[i] =
-          (window->x + x + i * FILE_LIST_SPRITE_SPACING) * 8 + 16;
-      // Three pixels lower than the Djinn were: a trophy is taller.
-      menu->positionsY[i] = (window->y + y) * 8 + 19;
+      *FileList_TrophySlot(menu, i) = sprite;
     }
+    // The first trophy's place; the others follow at FILE_LIST_CUP_SPACING.
+    menu->positionsX[0] = (window->x + x) * 8 + 16;
+    menu->positionsY[0] = (window->y + y) * 8 + 19;
 
     Task_Add(FileList_PlaceTrophySprites, FILE_LIST_SPRITE_PRIORITY);
   }
@@ -721,10 +744,12 @@ void FileList_HideTrophySprites(void) {
   s32 i;
 
   Task_Remove(FileList_PlaceTrophySprites);
-  for (i = 0; i < 4; i++) {
-    if (menu->animations[i] != NULL) {
-      Sprite_DestroyFar(menu->animations[i]);
-      menu->animations[i] = NULL;
+  for (i = 0; i < FILE_LIST_CUPS_PER_PAGE; i++) {
+    struct Sprite **slot = FileList_TrophySlot(menu, i);
+
+    if (*slot != NULL) {
+      Sprite_DestroyFar(*slot);
