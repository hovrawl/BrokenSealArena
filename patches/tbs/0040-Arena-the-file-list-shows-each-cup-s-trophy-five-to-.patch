+/// one before.
 #define FILE_LIST_SPRITE_SPACING 3
 /// Task priority of the tasks that place the sprites every frame.
 #define FILE_LIST_SPRITE_PRIORITY (200 << 4)
@@ -678,38 +678,61 @@ void FileList_PlacePartySprites(void) {
   }
