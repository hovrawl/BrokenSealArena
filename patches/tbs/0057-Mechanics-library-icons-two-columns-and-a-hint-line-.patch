-/// Scrolls so the chosen row shows.
+/// Makes the list a grid: `columns` entries to a line, `columnWidth` pixels
+/// apart, read across. Up and Down move a line, Left and Right an entry.
+void UiList_SetGrid(struct UiList *list, s32 columns, s32 columnWidth) {
+  s32 lines = ((list->window->height - 2) * 8 - list->top) / list->rowHeight;
+
+  if (lines < 1)
+    lines = 1;
+  list->columns = columns;
+  list->columnWidth = columnWidth;
+  list->visible = lines * columns;
+  if (list->visible > list->count)
+    list->visible = list->count;
+  list->first = 0;
+  UiList_Reveal(list);
+}
+
+/// Scrolls, a line at a time, so the chosen entry shows.
 void UiList_Reveal(struct UiList *list) {
+  s32 line = list->cursor - list->cursor % list->columns;
+
   if (list->cursor < list->first)
-    list->first = list->cursor;
+    list->first = line;
   if (list->cursor >= list->first + list->visible)
-    list->first = list->cursor - list->visible + 1;
+    list->first = line + list->columns - list->visible;
+  if (list->first < 0)
+    list->first = 0;
 }
 
-/// The y of a showing row's text (tile text sits on 8-pixel rows), in the
+/// The y of a showing entry's text (tile text sits on 8-pixel rows), in the
 /// window.
 static s32 UiList_RowY(const struct UiList *list, s32 row) {
-  return list->top + (row - list->first) * list->rowHeight +
+  return list->top + (row - list->first) / list->columns * list->rowHeight +
          (list->rowHeight - 8) / 2;
 }
 
+/// The x of an entry's text, in the window.
+static s32 UiList_TextX(const struct UiList *list, s32 row) {
+  return list->textX + (row - list->first) % list->columns * list->columnWidth;
+}
