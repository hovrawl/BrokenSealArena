From 7ac7ff5ed3776b1e806d0c7397ebaccd55efd5a6 Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Sun, 1 Nov 2026 09:06:03 +1100
Subject: [PATCH] Arena: Reloaded class data (multipliers in twentieths,
 Psynergy, vulnerabilities, ward)

Ported by scripts/port-reloaded-tables.py from the Golden Sun Reloaded v1.83a rebalance (forum.goldensunhacking.net topic 2779); the credit is in the table's header. ClassDefinition.weakEffects[3] becomes the named field ward.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/include/game/character.h    |   21 +-
 games/tbs/src/battle/battle/ability.c |    2 +-
 games/tbs/src/game/class_table.c      | 3702 +++++++++++++------------
 3 files changed, 1958 insertions(+), 1767 deletions(-)

diff --git a/games/tbs/include/game/character.h b/games/tbs/include/game/character.h
index 4086e02540..568bbbdf1e 100644
--- a/games/tbs/include/game/character.h
+++ b/games/tbs/include/game/character.h
@@ -57,17 +57,20 @@ struct ClassDefinition {
   /// The element levels the class needs, in tens: the last class of the
   /// series the character meets in all four is its class.
   u8 required[4];
-  u8 hp;                             ///< tenths of the base stat
-  u8 pp;                             ///< tenths of the base stat
-  u8 atk;                            ///< tenths of the base stat
-  u8 def;                            ///< tenths of the base stat
-  u8 agi;                            ///< tenths of the base stat
-  u8 luck;                           ///< tenths of the base stat
+  u8 hp;                             ///< twentieths of the base stat (tenths in stock; ARENA_RULES_CLASS20)
+  u8 pp;                             ///< twentieths of the base stat (tenths in stock; ARENA_RULES_CLASS20)
+  u8 atk;                            ///< twentieths of the base stat (tenths in stock; ARENA_RULES_CLASS20)
+  u8 def;                            ///< twentieths of the base stat (tenths in stock; ARENA_RULES_CLASS20)
+  u8 agi;                            ///< twentieths of the base stat (tenths in stock; ARENA_RULES_CLASS20)
+  u8 luck;                           ///< twentieths of the base stat (tenths in stock; ARENA_RULES_CLASS20)
   u8 padding[2];                     ///< padding
   struct ClassAbility abilities[16]; ///< the Psynergy the class teaches
-  /// [0] to [2]: the ability effects the class is weak to
-  /// (BattleAbility_IsWeakToEffect); [3] is 0 in every row and not read.
-  u8 weakEffects[4];
+  /// The ability effects the class is weak to (BattleAbility_IsWeakToEffect).
+  u8 weakEffects[3];
+  /// Arena romhack (Golden Sun Reloaded's class ward): the percent of a
+  /// Psynergy's power a party member of this class takes, 0 for no ward (stock
+  /// data; the byte is 0 and unread in the stock game). ARENA_RULES_DAMAGE.
+  u8 ward;
 };
 
 /// A Djinni: its ability and the stat bonuses it gives while set.
diff --git a/games/tbs/src/battle/battle/ability.c b/games/tbs/src/battle/battle/ability.c
index 3e69fb6bfd..b9516ae44e 100644
--- a/games/tbs/src/battle/battle/ability.c
+++ b/games/tbs/src/battle/battle/ability.c
@@ -676,7 +676,7 @@ s32 BattleAbility_ApplyToTarget(struct BattleActionRun *plan, s32 slot) {
           power += (u32)(casterPpMax * power) >> 10;
           // A party member's class has a ward, a percent of the power it takes.
           if (IS_PARTY_UNIT(targetId)) {
-            s32 ward = gClass_DefinitionTable[target->classId].weakEffects[3];
+            s32 ward = gClass_DefinitionTable[target->classId].ward;
 
             if (ward != 0)
               power = power * ward / 100;
