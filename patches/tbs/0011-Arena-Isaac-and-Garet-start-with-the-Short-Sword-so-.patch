From 178f3970e7895ae102139fc41f0eaa08af336a1a Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Fri, 30 Oct 2026 16:54:59 +1100
Subject: [PATCH] Arena: Isaac and Garet start with the Short Sword, so their
 battle sprites are the normal ones

A new game gives Isaac and Garet a Machete. While one is equipped, the battle draws
it as part of their own prologue sprites (SPRITE_ISAAC_MACHETE, SPRITE_GARET_MACHETE,
no weapon overlay; battle/placement.c). The game swaps it for an equipped Short Sword
when the prologue ends (Party_EndChildhood), which gives the normal sprites with the
weapon drawn over them. The arena's New Game skips the prologue, so it stayed on the
first sprites. ArenaBoot_NewGame now does the weapon swap for the two of them before
calculating their stats (Attack rises by 2 from the Short Sword). The rest of
Party_EndChildhood (300 coins, Move, Retreat, Mind Read) is deliberately not done.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/scene/arena_boot.c         | 19 +++++++++++++++++++
 games/tbs/src/scene/import/file_screen.s |  1 +
 2 files changed, 20 insertions(+)

diff --git a/games/tbs/src/scene/arena_boot.c b/games/tbs/src/scene/arena_boot.c
index 94a8dcd6ea..8a6d268610 100644
--- a/games/tbs/src/scene/arena_boot.c
+++ b/games/tbs/src/scene/arena_boot.c
@@ -48,17 +48,36 @@
 #include "map_grid_scroll.h"
 #include "flags.h"
 #include "title.h"
+#include "item_ids.h"
 #include "arena_config.h"
 #include "module/arena.h"
 
 #if ARENA_BOOT
 void ArenaBoot_NewGame(void) {
+  s32 unitId;
+  s32 slot;
+
   // "New Game" skips the prologue and enters the Battle Arena with a
   // ready-made level 30 party and 1500 coins to train with.
   gMainRoutineWork.coins = 1500;
   Party_AddMember(GARET);
   Party_AddMember(MIA);
   Party_AddMember(IVAN);
+  // Isaac and Garet start with a Machete, which the battle draws as part of
+  // their own prologue sprites (SPRITE_ISAAC_MACHETE, SPRITE_GARET_MACHETE, no
+  // weapon overlay; battle/placement.c). After the prologue the game swaps it
+  // for an equipped Short Sword (Party_EndChildhood), which gives the normal
+  // sprites. Do that part here, before the stats are calculated.
+  for (unitId = ISAAC; unitId <= GARET; unitId++) {
+    for (slot = 0; slot < INVENTORY_SLOTS; slot++) {
+      if ((gMainRoutineWork.units[unitId].inventory[slot] &
+           INVENTORY_ITEM_ID_MASK) == ITEM_MACHETE) {
+        gMainRoutineWork.units[unitId].inventory[slot] = ITEM_SHORT_SWORD;
+        Inventory_Equip(unitId, slot);
+        break;
+      }
+    }
+  }
   Unit_LevelUpTo(ISAAC, 30);
   Unit_LevelUpTo(GARET, 30);
   Unit_LevelUpTo(MIA, 30);
diff --git a/games/tbs/src/scene/import/file_screen.s b/games/tbs/src/scene/import/file_screen.s
index b275b4cda5..3e09157657 100644
--- a/games/tbs/src/scene/import/file_screen.s
+++ b/games/tbs/src/scene/import/file_screen.s
@@ -47,6 +47,7 @@
 	.set import.Party_StartChildhood, 1
 	.set import.Unit_LevelUpTo, 1
 	.set import.Unit_Calculate, 1
+	.set import.Inventory_Equip, 1
 	.set import.BuildStamp_GetTime, 1
 	.set import.InventorySnapshot_Restore, 1
 	.set import.Event_Wait, 1
-- 
2.53.0

