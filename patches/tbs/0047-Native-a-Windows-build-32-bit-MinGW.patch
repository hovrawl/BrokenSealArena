 u32 gNativeFrame;
 
 // --- memory ------------------------------------------------------------------
 
+#ifdef _WIN32
+static void MapRegion(u32 base, u32 size) {
+  // Reserved and committed at the GBA address (64 KB granularity; the image
+  // is linked at 0x08000000, clear of these regions).
+  void *at = VirtualAlloc((void *)(uintptr_t)base, size,
+                          MEM_RESERVE | MEM_COMMIT, PAGE_EXECUTE_READWRITE);
+
+  if (at != (void *)(uintptr_t)base) {
+    // Say what holds the address (a DLL, or which allocation).
+    MEMORY_BASIC_INFORMATION info;
+    char owner[MAX_PATH] = "";
+    DWORD error = GetLastError();
+
+    VirtualQuery((void *)(uintptr_t)base, &info, sizeof(info));
+    GetModuleFileNameA((HMODULE)info.AllocationBase, owner, sizeof(owner));
+    Native_Fatal("cannot map 0x%08x (%u bytes): error %lu; taken by 0x%08x+0x%x "
+                 "(state 0x%lx, type 0x%lx) %s",
+                 base, size, error, (u32)(uintptr_t)info.AllocationBase,
+                 (u32)info.RegionSize, info.State, info.Type, owner);
+  }
+}
+#else
 static void MapRegion(u32 base, u32 size) {
   u32 length = (size + 4095) & ~4095u;
   void *at = mmap((void *)(uintptr_t)base, length,
@@ -28,6 +55,7 @@ static void MapRegion(u32 base, u32 size) {
     Native_Fatal("cannot map 0x%08x (%u bytes): %s", base, length,
                  strerror(errno));
 }
+#endif
 
 void Native_MapMemory(void) {
   // RWX: the game copies routines into EWRAM and IWRAM and runs them there
@@ -40,25 +68,45 @@ void Native_MapMemory(void) {
   MapRegion(OAM_BASE, OAM_SIZE);
 }
 
-extern char __executable_start[], etext[];
-extern char __start_native_overlay_text[] __attribute__((weak));
-extern char __stop_native_overlay_text[] __attribute__((weak));
+// The image's code: from its start to the end of its text section (the
+// overlays' code is linked into the same section).
+#ifdef _WIN32
+extern char __ImageBase[];
+#define IMAGE_START __ImageBase
+#else
+extern char __executable_start[];
+#define IMAGE_START __executable_start
+#endif
+extern char etext[];
 
 int Native_IsCode(u32 address) {
-  if (address >= (u32)(uintptr_t)__executable_start &&
+  if (address >= (u32)(uintptr_t)IMAGE_START &&
       address < (u32)(uintptr_t)etext)
     return 1;
   return Native_IsOverlayCode(address);
 }
 
 int Native_IsOverlayCode(unsigned address) {
-  return __start_native_overlay_text != NULL &&
-         address >= (u32)(uintptr_t)__start_native_overlay_text &&
-         address < (u32)(uintptr_t)__stop_native_overlay_text;
+  int i;
+
+  for (i = 0; i < gNativeOverlayCount; i++) {
+    const struct NativeOverlay *o = &gNativeOverlays[i];
+
+    if (address >= (u32)(uintptr_t)o->textStart &&
+        address < (u32)(uintptr_t)o->textEnd)
+      return 1;
+  }
+  return 0;
 }
 
 // --- DMA -----------------------------------------------------------------------
 
+#ifdef _WIN32
+#define LOWEST_HOST_ADDRESS 0x00010000u // Windows maps nothing below 64 KB
+#else
+#define LOWEST_HOST_ADDRESS 0x02000000u
+#endif
+
 #define DMA_ENABLE_BIT 0x80000000u
 #define DMA_REPEAT_BIT (1u << 25)
 #define DMA_WORDS_BIT (1u << 26)
@@ -98,7 +146,9 @@ static void Dma_Transfer(int n) {
   case 2: stepSrc = 0; break;
   default: stepSrc = size; break;
   }
-  if (src < 0x02000000u || dst < 0x02000000u)
+  // Below the lowest host address: the BIOS or a null pointer the cartridge
+  // would have read (Windows puts the stack and heap below EWRAM, Linux above).
+  if (src < LOWEST_HOST_ADDRESS || dst < LOWEST_HOST_ADDRESS)
     Native_Fatal("DMA%d from 0x%08x to 0x%08x (control 0x%08x)", n, src, dst,
                  control);
   if (size == 4) {
@@ -295,7 +345,16 @@ static char **sArgv;
 void Native_SoftReset(void) {
   Native_Log("soft reset: restarting");
   Platform_Shutdown();
+#ifdef _WIN32
+  {
+    char self[MAX_PATH];
+
+    if (GetModuleFileNameA(NULL, self, sizeof(self)))
+      _execv(self, (const char *const *)sArgv);
+  }
+#else
   execv("/proc/self/exe", sArgv);
+#endif
   Native_Fatal("cannot restart: %s", strerror(errno));
 }
 
@@ -373,11 +432,32 @@ void Native_Fatal(const char *format, ...) {
 
 void System_Initialize(void);
 
+#ifdef _WIN32
+/// A crash: where it happened, for addr2line (Windows has no core dump).
+static LONG WINAPI Native_Crash(EXCEPTION_POINTERS *info) {
+  EXCEPTION_RECORD *r = info->ExceptionRecord;
+
+  fprintf(stderr, "[%6u] crash: exception 0x%08lx at 0x%08x", gNativeFrame,
+          r->ExceptionCode, (u32)(uintptr_t)r->ExceptionAddress);
+  if (r->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && r->NumberParameters >= 2)
+    fprintf(stderr, " (%s 0x%08x)", r->ExceptionInformation[0] ? "write" : "read",
+            (u32)r->ExceptionInformation[1]);
+  fprintf(stderr, ", stack from 0x%08x\n", (u32)info->ContextRecord->Esp);
+  fflush(stderr);
+  return EXCEPTION_EXECUTE_HANDLER;
+}
+#endif
+
 int main(int argc, char **argv) {
   sArgv = argv;
+#ifdef _WIN32
+  SetUnhandledExceptionFilter(Native_Crash);
+#endif
+  // The GBA regions first, before the platform loads libraries that could
+  // take their addresses.
+  Native_MapMemory();
   if (Platform_Init(argc, argv) != 0)
     return 1;
-  Native_MapMemory();
   Overlay_Snapshot();
   IO_REG16(REG_KEYINPUT_OFFSET) = 0x3ff;
   // System_Entry: the stacks are the host's; the game starts here and never
