+PREFIX = os.environ.get('SYMBOL_PREFIX', '')
+
 def exports(path):
     for raw in open(path):
         m = re.match(r'\s*export\s+(\w+)\s*,\s*(\w+)', raw.split('@')[0])
@@ -34,7 +37,7 @@ def main():
         return t if t == n or t in seen else resolve(t, seen + (n,))
