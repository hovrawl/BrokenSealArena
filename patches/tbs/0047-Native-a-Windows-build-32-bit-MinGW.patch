diff --git a/port/Makefile b/port/Makefile
index 23557ead31..46f522925f 100644
--- a/port/Makefile
+++ b/port/Makefile
@@ -15,7 +15,32 @@ DEFINE   := TBS_EDITION_EN
 GBA      := out/$(EDITION)
 HEADLESS ?= 0
 BUILD    ?= out/native-$(EDITION)$(if $(filter 1,$(HEADLESS)),-headless)
-TARGET   := $(BUILD)/tbs-native
+
+# 32-bit Windows (MSYS2's MINGW32 shell): a PE image whose C symbols start
+# with an underscore. The generated assembly gets the prefix after it is
+# assembled (objcopy --prefix-symbols), the overlay and alias scripts take it
+# from SYMBOL_PREFIX, and GCC lays out bitfields as on the GBA, not as MSVC.
+ifeq ($(OS),Windows_NT)
+WINDOWS       := 1
+EXE           := .exe
+SYMBOL_PREFIX := _
+LD_EMULATION  := i386pe
+COFF          := --coff
+TARGET_CFLAGS := -mno-ms-bitfields
+PREFIX_SYMBOLS = objcopy --prefix-symbols=_ $@
+ifeq ($(origin CC),default)
+CC            := gcc
+endif
+else
+EXE           :=
+SYMBOL_PREFIX :=
+LD_EMULATION  := elf_i386
+COFF          :=
+TARGET_CFLAGS :=
+PREFIX_SYMBOLS = @:
+endif
+export SYMBOL_PREFIX LD_EMULATION
+TARGET   := $(BUILD)/tbs-native$(EXE)
 
 CC       ?= gcc
 AS_HOST  ?= as
@@ -34,15 +59,22 @@ PLATFORM := port/src/platform_sdl.c
 PLATFORM_LIBS := $(SDL_LIBS)
 endif
 
-GAME_CFLAGS := $(ARCH) -std=gnu89 -O2 -g -fno-strict-aliasing -fwrapv -fno-pie \
+GAME_CFLAGS := $(ARCH) $(TARGET_CFLAGS) -std=gnu89 -O2 -g -fno-strict-aliasing -fwrapv -fno-pie \
                -fno-stack-protector -ffreestanding -nostdinc -fcommon \
                -DMODERN=1 -DNATIVE=1 -DUBFIX=1 -D$(DEFINE)=1 \
                -Iport/include -Igames/$(GAME)/include -I$(GBA) -w
-PORT_CFLAGS := $(ARCH) -std=gnu99 -O2 -g -fno-strict-aliasing -fwrapv -fno-pie \
+PORT_CFLAGS := $(ARCH) $(TARGET_CFLAGS) -std=gnu99 -O2 -g -fno-strict-aliasing -fwrapv -fno-pie \
                -DNATIVE=1 -D$(DEFINE)=1 -Iport/include -Wall -Wno-unused-function
 # Routines the game copies to RAM or the stack run there (as jumps back to
 # the host code), so EWRAM, IWRAM and the stack are executable.
+ifdef WINDOWS
+# The same on Windows: no DEP for the process (no NX-compatible flag), no
+# relocation, and the image at 0x08000000 (the cartridge ROM's range, as the
+# Linux image at 0x08048000 is), clear of the RAM regions.
+LDFLAGS     := $(ARCH) -g -Wl,--image-base=0x08000000 -Wl,--disable-dynamicbase -Wl,--disable-nxcompat
+else
 LDFLAGS     := $(ARCH) -no-pie -g -z execstack
+endif
 
 .SUFFIXES:
 .SECONDARY:
@@ -106,8 +138,9 @@ $(BUILD)/obj/%.o: %.c
 # Game data in assembly, made host-assembler friendly first.
 $(BUILD)/obj/%.o: %.s port/tools/arm2host_s.py
 	@mkdir -p $(@D)
-	$(PYTHON) port/tools/arm2host_s.py $< $(@:.o=.host.s) -I $(GBA) --defsym $(DEFINE)=1
+	$(PYTHON) port/tools/arm2host_s.py $< $(@:.o=.host.s) -I $(GBA) --defsym $(DEFINE)=1 $(COFF)
 	$(AS_HOST) $(ASARCH) -I $(GBA) -o $@ $(@:.o=.host.s)
+	$(PREFIX_SYMBOLS)
 # The platform layer.
 $(BUILD)/port/%.o: port/src/%.c
 	@mkdir -p $(@D)
@@ -139,6 +172,7 @@ $(BUILD)/gen/overlay_table.c: port/tools/overlay_table.py $(GBA)/objects.mk
 	$(PYTHON) $< $@ $(OVERLAYS)
 $(BUILD)/gen/%.o: $(BUILD)/gen/%.s
 	$(AS_HOST) $(ASARCH) -o $@ $<
+	$(PREFIX_SYMBOLS)
 $(BUILD)/gen/%.o: $(BUILD)/gen/%.c
 	$(CC) $(PORT_CFLAGS) -c -o $@ $<
 
