index 24f651362d..2acbb69fb8 100644
--- a/port/include/native/asm.h
+++ b/port/include/native/asm.h
@@ -48,13 +48,18 @@ void Native_DmaStart(volatile void *channel, unsigned source,
 
 /// The host keeps its own stack: wait() never moves it. Reading gives an
 /// address above every GBA region, so the frame wait's stack swap is skipped.
-#define ASM_STACK_POINTER_GET(variable)                                        \
-  ((variable) = (void *)__builtin_frame_address(0))
+/// (A fixed one: the host stack can be anywhere, below EWRAM on Windows.)
+#define ASM_STACK_POINTER_GET(variable) ((variable) = (void *)0xfffffff0u)
 #define ASM_STACK_POINTER_SET(value) ((void)(value))
 
 /// A local pinned to an ARM register is a plain local.
 #define ASM_REGISTER(declaration, name) declaration
 #define ASM_NOTHING() ((void)0)
-#define ASM_LINKED_NAME(symbol, name) extern char symbol[] __asm__(name)
+/// A C name for an assembly symbol: with the target's C symbol prefix (an
+/// underscore on 32-bit Windows), as the compiler would spell it.
+#define NATIVE_STRINGIFY_(x) #x
+#define NATIVE_STRINGIFY(x) NATIVE_STRINGIFY_(x)
+#define ASM_LINKED_NAME(symbol, name)                                          \
+  extern char symbol[] __asm__(NATIVE_STRINGIFY(__USER_LABEL_PREFIX__) name)
 
 #endif
