+#ifndef GUARD_ARENA_UI_KIT_H
+#define GUARD_ARENA_UI_KIT_H
+
+/// @file
+/// The UI kit: what our screens ask to lay themselves out, so one screen's code
+/// serves every build. A screen has a classic layout (the GBA's 30 by 20
+/// tiles, as the game's own screens are) and may have a touch layout (the full
+/// width of the screen, header buttons, rows big enough to tap). Both are drawn
+/// from the game's own windows, font, hand and icons (docs/UI.md, "Source
+/// accurate"). The GBA build always takes the classic layout, so the touch
+/// code compiles away there.
+///
+/// Desktop and phone builds choose with --ui classic|touch (default touch) and
+/// size the touch layout's rows with --ui-size 16|24 (default 24, about a
+/// fingertip on a phone; port/src/native_screen.c).
+
+#ifdef NATIVE
+extern int gUiTouch;     ///< 1: screens take their touch layouts
+extern int gUiRowHeight; ///< a touch layout's row, in pixels
+void Screen_SetUiSafeArea(int on);
+#define UI_TOUCH_LAYOUT (gUiTouch != 0)
+#define UI_ROW_HEIGHT gUiRowHeight
+/// A touch layout spans the whole screen: the 240-pixel safe area is off
+/// while it is open (DISPLAY_WIDTH is then the screen's width).
+#define UiScreen_BeginFullWidth() Screen_SetUiSafeArea(0)
+#define UiScreen_EndFullWidth() Screen_SetUiSafeArea(1)
+#else
+#define UI_TOUCH_LAYOUT 0
+#define UI_ROW_HEIGHT 16
+#define UiScreen_BeginFullWidth()
+#define UiScreen_EndFullWidth()
+#endif
+
+/// The screen's width in tiles: 30 on the GBA and in a classic layout, more in
+/// a full-width touch layout.
+#define UI_SCREEN_TILES (DISPLAY_WIDTH / 8)
+
+#endif
