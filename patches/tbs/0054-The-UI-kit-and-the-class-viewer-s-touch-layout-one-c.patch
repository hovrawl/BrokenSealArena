@@ -36,13 +36,34 @@ static int Width_Parse(const char *text) {
   return width;
 }
 
+// The UI kit's choices (include/arena/ui_kit.h): touch layouts, and their
+// rows' height.
+int gUiTouch = 1;
+int gUiRowHeight = 24;
+
 void Screen_ChooseWidth(int argc, char **argv) {
   const char *choice = getenv("TBS_WIDTH");
+  const char *ui = getenv("TBS_UI");
+  const char *size = getenv("TBS_UI_SIZE");
   int i;
 
-  for (i = 1; i + 1 < argc; i++)
+  for (i = 1; i + 1 < argc; i++) {
     if (!strcmp(argv[i], "--width"))
       choice = argv[i + 1];
+    else if (!strcmp(argv[i], "--ui"))
+      ui = argv[i + 1];
+    else if (!strcmp(argv[i], "--ui-size"))
+      size = argv[i + 1];
+  }
+  if (ui && *ui)
+    gUiTouch = strcmp(ui, "classic") != 0;
+  if (size && *size) {
+    gUiRowHeight = atoi(size);
+    if (gUiRowHeight < 16)
+      gUiRowHeight = 16;
+    if (gUiRowHeight > 24)
+      gUiRowHeight = 24; // larger rows need scrolling lists (not yet)
+  }
   if (choice && *choice)
     gNativeDisplayWidth = Width_Parse(choice);
   Screen_SetUiSafeArea(1);
