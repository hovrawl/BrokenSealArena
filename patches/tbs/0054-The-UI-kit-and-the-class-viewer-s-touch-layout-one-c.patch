+/// A window's place, in tiles.
+struct CvRect {
+  s8 x, y, width, height;
+};
+
+/// Where the class viewer's parts go. The classic layout is the GBA's screen
+/// (a 30 by 11 panel over a 30 by 9 list, the same two windows for both
+/// steps); the touch layout spans the screen with a header of buttons, the
+/// line as a grid of big rows and the detail under it, and its own windows for
+/// the Psynergy step (docs/UI-SPECS.md, "Class viewer"; ui_kit.h).
+struct CvLayout {
+  s8 touch;
+  struct CvRect header;               ///< touch only: the buttons
+  struct CvRect grid[2];              ///< by step: the classes, the Psynergy
+  struct CvRect info[2];              ///< by step: the detail under or over it
+  s16 inner;                          ///< pixels inside a full-width window
+  s16 columns, columnWidth, rowHeight; ///< the class grid
+  s16 psyColumns, psyRows, psyColumnWidth, psyRowHeight;
+  s16 infoTop;  ///< the detail's first row: under the heading (classic) or 0
+  s16 titleX;   ///< touch: the header's line number or page
+  s16 filterX;  ///< touch: the filter button's left edge
+  s16 backX;    ///< touch: the Back button's left edge
+  s16 lineWord; ///< touch: room for the word "Line"
+};
+
+static void CvRect_Set(struct CvRect *rect, s32 x, s32 y, s32 width,
+                       s32 height) {
+  rect->x = x;
+  rect->y = y;
+  rect->width = width;
+  rect->height = height;
+}
+
+static void ClassViewer_Layout(struct CvLayout *l) {
+  s32 tiles = UI_SCREEN_TILES;
+  s32 row = UI_ROW_HEIGHT;
+  s32 gridTiles;
+
+  l->inner = (tiles - 2) * 8;
+  if (!UI_TOUCH_LAYOUT) {
+    l->touch = 0;
+    CvRect_Set(&l->grid[0], 0, 11, 30, 9);
+    CvRect_Set(&l->info[0], 0, 0, 30, 11);
+    CvRect_Set(&l->grid[1], 0, 0, 30, 11);
+    CvRect_Set(&l->info[1], 0, 11, 30, 9);
+    l->columns = 2;
+    l->columnWidth = CV_LIST_COLUMN_WIDTH;
+    l->rowHeight = 16;
+    l->psyColumns = 2;
+    l->psyRows = CV_PSY_PER_PAGE / 2;
+    l->psyColumnWidth = CV_LIST_COLUMN_WIDTH;
+    l->psyRowHeight = 16;
+    l->infoTop = 8;
+    return;
+  }
+  // Header 3 tiles (its buttons take taps across its whole 24 pixels), the
+  // line in two rows, the detail in what is left.
+  l->touch = 1;
+  gridTiles = 2 * row / 8 + 2;
+  CvRect_Set(&l->header, 0, 0, tiles, 3);
+  CvRect_Set(&l->grid[0], 0, 3, tiles, gridTiles);
+  CvRect_Set(&l->info[0], 0, 3 + gridTiles, tiles, 17 - gridTiles);
+  CvRect_Set(&l->grid[1], 0, 3, tiles, 3 * row / 8 + 2);
+  CvRect_Set(&l->info[1], 0, 3 + l->grid[1].height, tiles,
+             17 - l->grid[1].height);
+  l->columns = 3;
+  l->columnWidth = l->inner / 3;
+  l->rowHeight = row;
+  l->psyColumns = 2;
+  l->psyRows = 3;
+  l->psyColumnWidth = l->inner / 2;
+  l->psyRowHeight = row;
+  l->infoTop = 0;
+  // [L][R] Line 1/20 ... filter ... Back: the word "Line" when it fits.
+  l->titleX = 54;
+  l->lineWord = l->inner >= 256;
+  l->filterX = l->titleX + (l->lineWord ? 74 : 40) + 4;
+  l->backX = l->inner - 40;
+}
+
+static s32 CvWindow_Is(struct Window *window, const struct CvRect *rect) {
+  return window != 0 && window->x == rect->x && window->y == rect->y &&
+         window->width == rect->width && window->height == rect->height;
+}
+
+/// Opens step `stage`'s windows, keeping an open one already in its place
+/// (the classic layout's two windows serve both steps) and closing the rest.
+static void ClassViewer_OpenStage(const struct CvLayout *l, s32 stage,
+                                  struct Window **grid, struct Window **info) {
+  struct Window *open[2];
+  struct Window *keepGrid = 0;
+  struct Window *keepInfo = 0;
+  s32 i;
+
+  open[0] = *grid;
+  open[1] = *info;
+  for (i = 0; i < 2; i++) {
+    if (keepGrid == 0 && CvWindow_Is(open[i], &l->grid[stage])) {
+      keepGrid = open[i];
+      open[i] = 0;
+    } else if (keepInfo == 0 && CvWindow_Is(open[i], &l->info[stage])) {
+      keepInfo = open[i];
+      open[i] = 0;
+    }
+  }
+  for (i = 0; i < 2; i++) {
+    if (open[i] != 0)
+      Window_CloseFar(open[i], 2);
+  }
+  if (keepInfo == 0)
+    keepInfo = Window_CreateFar(l->info[stage].x, l->info[stage].y,
+                                l->info[stage].width, l->info[stage].height,
+                                WINDOW_FLAG_INSTANT);
+  if (keepGrid == 0)
+    keepGrid = Window_CreateFar(l->grid[stage].x, l->grid[stage].y,
+                                l->grid[stage].width, l->grid[stage].height,
+                                WINDOW_FLAG_INSTANT);
+  *grid = keepGrid;
+  *info = keepInfo;
+}
+
+/// The touch header's buttons: [L] [R] at the left, Back at the right; the
+/// title and the filter (or the page) are drawn by the step.
+static void ClassViewer_DrawHeader(const struct CvLayout *l,
+                                   struct Window *header) {
+  WindowSprite_PrepareForRedrawFar(header);
+  Text_DrawMessageAsTilesFar(MsgArenaUiPrevious, header, 6, 0);
+  Text_DrawMessageAsTilesFar(MsgArenaUiNext, header, 32, 0);
+  Text_DrawMessageAsTilesFar(MsgArenaUiBack, header, l->backX + 4, 0);
+}
