-/// Reads one frame of the D-pad and buttons for a list of count rows: 1 for A,
-/// -1 for B, 2 when the cursor moved, else 0.
-static s32 Training_Navigate(s32 *cursor, s32 count) {
-  wait(1);
-  if (gKeysRepeat & KEY_B)
-    return -1;
-  if (gKeysRepeat & KEY_A)
-    return 1;
-  if (gKeysRepeat & KEY_DOWN) {
-    if (++*cursor >= count)
-      *cursor = 0;
-    return 2;
-  }
-  if (gKeysRepeat & KEY_UP) {
-    if (--*cursor < 0)
-      *cursor = count - 1;
-    return 2;
-  }
-  return 0;
