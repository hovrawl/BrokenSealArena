-/// One character's stats, each raised for coins. A row past the stats leaves.
-static void Training_RunStats(s32 unitId) {
-  struct Window *window = Training_OpenScreen();
-  s32 count = TRAIN_STAT_COUNT;
-  s32 cursor = 0;
-  s32 redraw = 1;
-  s32 notice = 0;
-  s32 key;
-  s32 stat;
-
-  for (;;) {
-    if (redraw) {
-      struct Unit *unit = Unit_Get(unitId);
-
-      Training_Clear(window);
-      Training_DrawHeader(window, unitId);
-      for (stat = 0; stat < TRAIN_STAT_COUNT; stat++) {
-        s32 y = (stat + 1) * TRAINING_ROW_HEIGHT;
-
-        if (stat == cursor)
-          Training_DrawCursor(window, stat + 1);
-        Text_DrawMessageAsTiles(MsgArenaStatHp + stat, window,
-                                TRAINING_LABEL_X, y);
-        Training_DrawNumber(window, Training_StatValue(unit, stat),
-                            TRAINING_VALUE_X, y);
-        if (Training_StatValue(unit, stat) + Training_StatStep(stat) >
-            Training_StatCap(stat))
-          Text_DrawMessageAsTiles(MsgArenaMax, window, TRAINING_PRICE_X, y);
-        else
-          Training_DrawNumber(window, Training_StatCost(unit, stat),
-                              TRAINING_PRICE_X, y);
-      }
-      if (notice != 0)
-        Training_DrawNotice(window, notice);
-      redraw = 0;
-    }
-    key = Training_Navigate(&cursor, count);
-    if (notice != 0)
-      redraw = 1;
-    notice = 0;
-    if (key == -1)
-      break;
-    if (key == 2)
-      redraw = 1;
-    if (key == 1) {
-      struct Unit *unit = Unit_Get(unitId);
-      s32 cost = Training_StatCost(unit, cursor);
-
-      redraw = 1;
-      if (Training_StatValue(unit, cursor) + Training_StatStep(cursor) >
-          Training_StatCap(cursor)) {
-        // At its cap.
-      } else if (gMainRoutineWork.coins < cost) {
-        notice = MsgArenaNoCoins;
-      } else {
-        gMainRoutineWork.coins -= cost;
-        Training_StatAdd(unit, cursor, Training_StatStep(cursor));
-        Unit_Calculate(unitId);
-      }
-    }
-  }
-  Window_Close(window, 2);
-}
