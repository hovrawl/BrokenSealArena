diff --git a/games/tbs/src/menu/menu_shared.c b/games/tbs/src/menu/menu_shared.c
index 7265887a23..073d1d9632 100644
--- a/games/tbs/src/menu/menu_shared.c
+++ b/games/tbs/src/menu/menu_shared.c
@@ -471,6 +471,15 @@ struct Window *MenuCursor_Create(void *source) {
   // No screen ever makes a second marker: sideIcon[1] stays NULL, as the
   // menu state was cleared, and this store and the screens' others through it
   // land in the BIOS, which ignores them.
+#ifdef NATIVE
+  // The desktop build has no BIOS to take them: a marker no window carries
+  // (so it never draws) takes them instead.
+  if (menu->sideIcon[1] == NULL) {
+    static struct WindowSprite sUnusedMarker;
+
+    menu->sideIcon[1] = &sUnusedMarker;
+  }
+#endif
   menu->sideIcon[1]->depth = OAM_DEPTH_FRONT;
   return window;
 }
