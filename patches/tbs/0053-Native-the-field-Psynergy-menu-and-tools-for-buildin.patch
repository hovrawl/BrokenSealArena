     } else if (!strcmp(argv[i], "--width") && i + 1 < argc) {
       i++; // Screen_ChooseWidth took it
+    } else if (!strcmp(argv[i], "--screen") && i + 1 < argc) {
+      i++; // NativeDev_ChooseScreen took it
+    } else if (!strcmp(argv[i], "--resume") && i + 1 < argc) {
