--- /dev/null
+++ b/port/include/native/dev.h
@@ -0,0 +1,23 @@
+#ifndef NATIVE_DEV_H
+#define NATIVE_DEV_H
+
+/// @file
+/// Desktop tools for building screens (native_dev.c): open a screen straight
+/// from the field, by name (--screen NAME, TBS_SCREEN, or the headless
+/// script's "screen NAME").
+
+enum {
+  NATIVE_SCREEN_NONE,
+  NATIVE_SCREEN_CLASS_VIEWER, ///< "classviewer": the scholar's, for Isaac
+  NATIVE_SCREEN_MECHANICS,    ///< "mechanics": the mechanics guide's topics
+};
+
+/// The screen to open on the next field frame with the player in control, or
+/// NATIVE_SCREEN_NONE; the field loop clears it.
+extern int gNativeScreenRequest;
+
+int NativeDev_ScreenByName(const char *name);
+void NativeDev_ChooseScreen(int argc, char **argv);
+void NativeDev_OpenScreen(int id);
+
+#endif
diff --git a/port/src/native_dev.c b/port/src/native_dev.c
new file mode 100644
index 0000000000..5f9fec948c
--- /dev/null
+++ b/port/src/native_dev.c
@@ -0,0 +1,57 @@
+// Opening a screen straight from the field, for building and testing screens
+// without walking to them: `--screen NAME` (or TBS_SCREEN) opens it on the
+// first field frame the player has control, and the headless script command
+// `screen NAME` opens it then. The field loop asks gNativeScreenRequest each
+// frame (field_sequence_run.c) and calls NativeDev_OpenScreen.
+
+#include "native/native.h"
+#include "native/dev.h"
+
+#include <stdlib.h>
+
+int gNativeScreenRequest;
+
+// The screens, by name (all far-call exports of the main image).
+extern int ClassViewer_Run(int unitId);
+extern int MechanicsGuide_Choose(int first);
+
+static const struct {
+  const char *name;
+  int id;
+} sScreens[] = {
+    {"classviewer", NATIVE_SCREEN_CLASS_VIEWER},
+    {"mechanics", NATIVE_SCREEN_MECHANICS},
+};
+
+int NativeDev_ScreenByName(const char *name) {
+  unsigned i;
+
+  for (i = 0; i < sizeof(sScreens) / sizeof(sScreens[0]); i++)
+    if (!strcmp(name, sScreens[i].name))
+      return sScreens[i].id;
+  Native_Log("screen: no screen named %s", name);
+  return 0;
+}
+
+void NativeDev_ChooseScreen(int argc, char **argv) {
+  const char *choice = getenv("TBS_SCREEN");
+  int i;
+
+  for (i = 1; i + 1 < argc; i++)
+    if (!strcmp(argv[i], "--screen"))
+      choice = argv[i + 1];
+  if (choice && *choice)
+    gNativeScreenRequest = NativeDev_ScreenByName(choice);
+}
+
+void NativeDev_OpenScreen(int id) {
+  Native_Log("screen %d", id);
+  switch (id) {
+  case NATIVE_SCREEN_CLASS_VIEWER:
+    ClassViewer_Run(0); // Isaac
+    break;
+  case NATIVE_SCREEN_MECHANICS:
+    MechanicsGuide_Choose(0);
+    break;
+  }
+}
