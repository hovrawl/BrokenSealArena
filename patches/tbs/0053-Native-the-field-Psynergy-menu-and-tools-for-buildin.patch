     } else {
       fprintf(stderr,
               "usage: %s [--script FILE] [--shots DIR] [--frames N] [--scale N] [--width W]\n",
@@ -358,6 +407,8 @@ int Platform_Init(int argc, char **argv) {
       return 1;
     }
   }
+  if (resume > 0 && resume <= sCount)
+    sNext = resume;
 #ifdef _WIN32
   mkdir(sShotDir);
