 }
 
+/// The console's reset: the game starts again from power on, keeping the save
+/// (already on disk), by starting this program again with the same arguments
+/// and --resume at the command after this one.
+static void Reset(void) {
+  char next[16];
+  char *args[64];
+  int n = 0, i;
+
+  for (i = 0; sArgv[i] && n < 60; i++) {
+    if (!strcmp(sArgv[i], "--resume") && sArgv[i + 1]) {
+      i++;
+      continue;
+    }
+    args[n++] = sArgv[i];
+  }
+  snprintf(next, sizeof(next), "%d", sNext);
+  args[n++] = "--resume";
+  args[n++] = next;
+  args[n] = NULL;
+  Native_Log("reset");
+  fflush(stdout);
+  fflush(stderr);
+  execv(sArgv[0], args);
+  Native_Log("reset: could not start again (%s)", strerror(errno));
+  sDone = 1;
+}
+
 /// Runs the script up to the next frame that holds keys or waits.
 static void Script_Step(void) {
   if (sHoldLeft && --sHoldLeft)
@@ -329,6 +367,12 @@ static void Script_Step(void) {
       else
         *at = c->value;
       break;
+    case CMD_RESET:
