diff --git a/port/include/native/wide_map.h b/port/include/native/wide_map.h
new file mode 100644
index 0000000000..1d3a4e58c7
--- /dev/null
+++ b/port/include/native/wide_map.h
@@ -0,0 +1,24 @@
+#ifndef NATIVE_WIDE_MAP_H
+#define NATIVE_WIDE_MAP_H
+
+/// @file
+/// Wide BG maps for the desktop build. A GBA text background's map is 32 or 64
+/// tiles wide in 2 KB screen blocks of VRAM, and VRAM has no room for the
+/// field's three layers at 64 tiles. On the desktop a text background whose
+/// control register has bit 13 set (unused by text backgrounds on the GBA:
+/// it is the affine wrap bit) reads its map from gNativeWideMaps instead:
+/// 64 by 32 tiles, row after row, chosen by the register's screen base. The
+/// bit lives in the register, so a screen that sets up its own backgrounds
+/// leaves it behind without clearing anything.
+
+#define BGCNT_NATIVE_WIDE 0x2000
+#define NATIVE_WIDE_MAP_WIDTH 64
+#define NATIVE_WIDE_MAP_HEIGHT 32
+
+extern unsigned short gNativeWideMaps[32][NATIVE_WIDE_MAP_WIDTH *
+                                         NATIVE_WIDE_MAP_HEIGHT];
+
+/// Screen base `base`'s wide map, as bytes.
+#define NATIVE_WIDE_MAP(base) ((unsigned char *)gNativeWideMaps[base])
+
+#endif
