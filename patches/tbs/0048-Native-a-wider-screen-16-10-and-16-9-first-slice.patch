 /// A REG_WINxH or REG_WINxV value: the window covers start up to, but not
 /// including, end.
+#ifdef NATIVE
+// A window register holds 8-bit edges; on the desktop's wider screen a right
+// edge past 255 (the screen's width) is written as 240, which the display
+// takes as the screen's right edge (port/src/ppu.c).
+#define WIN_RANGE(start, end) (((start) << 8) | ((end) > 255 ? 240 : (end)))
+#else
