diff --git a/port/src/native_screen.c b/port/src/native_screen.c
new file mode 100644
index 0000000000..639b7d659c
--- /dev/null
+++ b/port/src/native_screen.c
@@ -0,0 +1,41 @@
+// The screen's width. The GBA's is 240; the desktop build can be wider so a
+// 16:10 or 16:9 window fills with game rather than black bars. The game reads
+// the width as DISPLAY_WIDTH (io_reg.h), so the camera and the windows that
+// already go by it follow; the rest is fixed screen by screen.
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "native/native.h"
+
+int gNativeDisplayWidth = 240;
+
+static int Width_Parse(const char *text) {
+  int width;
+
+  if (!strcmp(text, "3:2"))
+    return 240;
+  if (!strcmp(text, "16:10"))
+    return 256;
+  if (!strcmp(text, "16:9"))
+    return 288;
+  width = atoi(text);
+  if (width < 240 || width > SCREEN_MAX_WIDTH || width % 8) {
+    Native_Log("width %s: use 240 (3:2), 256 (16:10) or 288 (16:9); "
+               "keeping 240",
+               text);
+    return 240;
+  }
+  return width;
+}
+
+void Screen_ChooseWidth(int argc, char **argv) {
+  const char *choice = getenv("TBS_WIDTH");
+  int i;
+
+  for (i = 1; i + 1 < argc; i++)
+    if (!strcmp(argv[i], "--width"))
+      choice = argv[i + 1];
+  if (choice && *choice)
+    gNativeDisplayWidth = Width_Parse(choice);
+}
