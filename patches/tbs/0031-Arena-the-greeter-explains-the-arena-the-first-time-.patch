diff --git a/games/tbs/src/scene/battle_arena.c b/games/tbs/src/scene/battle_arena.c
index 6bbaa9ce5e..e60246f5ba 100644
--- a/games/tbs/src/scene/battle_arena.c
+++ b/games/tbs/src/scene/battle_arena.c
@@ -1516,6 +1516,33 @@ static s32 BattleArena_TalkToVisitor(s32 actorId) {
 #endif
 }
 
+#if ARENA_ONBOARDING
+/// Talking to ACTOR_GREETER. The first time on a save she explains the arena in
+/// two messages (MsgArenaGreeterIntro1 and 2) and sets FLAG_ARENA_ONBOARDED
+/// (New Game clears it); after that she says her stock welcome.
+static s32 BattleArena_TalkToGreeter(s32 actorId) {
+  s32 first;
+
+  Event_Start();
+  Actor_SetAngleToward(actorId, gMainRoutineWork.leaderActorId, 0);
+  first = FieldGameFlag_GetByte(FLAG_ARENA_ONBOARDED) == 0;
+  if (first) {
+    Event_SetMessageId(MsgArenaGreeterIntro1);
+    FieldMessage_ShowAtActor(actorId, 0);
+    Event_SetMessageId(MsgArenaGreeterIntro2);
+    FieldMessage_ShowAtActor(actorId, 0);
+    FieldGameFlag_SetByte(FLAG_ARENA_ONBOARDED, 1);
+  } else {
+    Event_SetMessageId(MsgFieldWelcomeToBattleArenaWherePeople);
+    FieldMessage_ShowAtActor(actorId, 0);
+  }
+  Event_End();
+#ifdef UBFIX
+  return 0;
+#endif
+}
+#endif
+
 /// Talking to ACTOR_PARTY_ORDER_VISITOR, who alternates, by
 /// FLAG_BATTLE_ARENA_PARTY_ORDER_NEXT, between the linked finals' limit of
 /// three allies (worded for the party's size) and how to change the party's
@@ -2009,8 +2036,13 @@ struct Trigger gBattleArenaTriggers[] = {
 #endif
     {TRIGGER_TALK, ACTOR_HEALER, CONDITION_ALWAYS,
      EVENT(BattleArena_OpenSanctum)},
+#if ARENA_ONBOARDING
+    {TRIGGER_TALK, ACTOR_GREETER, CONDITION_ALWAYS,
+     EVENT(BattleArena_TalkToGreeter)},
+#else
     {TRIGGER_TALK, ACTOR_GREETER, CONDITION_ALWAYS,
      MSGNO(MsgFieldWelcomeToBattleArenaWherePeople)},
+#endif
     {TRIGGER_TALK, ACTOR_TRAVELING_WARRIOR, CONDITION_ALWAYS,
      EVENT(BattleArena_TalkToVisitor)},
     {TRIGGER_TALK, ACTOR_FINALS_VISITOR, CONDITION_ALWAYS,
