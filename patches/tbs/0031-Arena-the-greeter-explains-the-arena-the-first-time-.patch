 //   0x7f0 FLAG_ARENA_PROGRESS     main cups cleared, 0 to ARENA_MAIN_CUPS (byte)
 //   0x7e8 FLAG_ARENA_SIDE_CLEARED bit n: side cup n cleared (byte)
-//   0x7e0                         reserved (byte)
+//   0x7e0 FLAG_ARENA_ONBOARDED    1 once the greeter has explained the arena
+//                                 (byte; New Game clears it)
 //   0x7a0 to 0x7df                one bit for each reward given
 //                                 (ARENA_REWARD_FLAG_FIRST in arena_cups.h)
