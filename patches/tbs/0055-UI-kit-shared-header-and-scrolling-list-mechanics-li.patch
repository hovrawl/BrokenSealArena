@@ -35,4 +35,42 @@ void Screen_SetUiSafeArea(int on);
 /// a full-width touch layout.
 #define UI_SCREEN_TILES (DISPLAY_WIDTH / 8)
 
+/// The header's buttons (UiHeader_Draw, UiHeader_Touch).
+#define UI_HEADER_PAGES 1       ///< [L] [R] at the left
+#define UI_HEADER_BACK_BUTTON 2 ///< B Back at the right
+/// Where a header's title starts after [L] [R], in pixels inside it.
+#define UI_HEADER_TITLE_X 54
+
+struct Window;
+
+/// A list of message rows in a window (arena_ui_kit.c).
+struct UiList {
+  struct Window *window;
+  s16 count, visible, first, cursor;
+  s16 rowHeight, top, textX;
+  s32 labelBase;
+};
+
+/// What UiList_Step saw this frame.
+enum {
+  UI_LIST_NONE,
+  UI_LIST_MOVED,     ///< the hand or the scroll moved: draw again
+  UI_LIST_CHOSEN,    ///< A, or a tap on the chosen row
+  UI_LIST_CANCELLED, ///< B (or Back)
+};
+
+struct Window *UiHeader_Open(void);
+void UiHeader_Draw(struct Window *header, s32 buttons);
+s32 UiHeader_BackX(struct Window *header);
+#ifdef NATIVE
+void UiHeader_Touch(struct Window *header, s32 buttons);
+#else
+#define UiHeader_Touch(header, buttons)
+#endif
+void UiList_Init(struct UiList *list, struct Window *window, s32 count,
+                 s32 labelBase, s32 rowHeight, s32 top, s32 textX, s32 cursor);
+void UiList_Reveal(struct UiList *list);
+void UiList_Draw(struct UiList *list);
+s32 UiList_Step(struct UiList *list);
+
 #endif
