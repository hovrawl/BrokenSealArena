+/// @file
+/// Arena romhack: the UI kit's widgets (include/arena/ui_kit.h), built from
+/// the game's own windows, font, hand cursor and the shops' hopping arrows.
+/// - The header: a window across the top of a touch layout with the
+///   buttons [L] [R] and B Back, each pressing its key when tapped.
+/// - The list: rows of messages in a window, the hand on the chosen one, the
+///   shop's arrows when there are more rows than fit; it scrolls.
+// Part of shop.c.
+
+#include "shop_internal.h"
+#include "arena/ui_kit.h"
+
+/// The header's [L] [R] buttons are 26 pixels each from the left; Back the
+/// last 40 pixels of the window's inside.
+#define UI_HEADER_BUTTON 26
+#define UI_HEADER_BACK 40
+
+/// The touch layout's header: a window 3 tiles tall across the top.
+struct Window *UiHeader_Open(void) {
+  return Window_CreateFar(0, 0, UI_SCREEN_TILES, 3, WINDOW_FLAG_INSTANT);
+}
+
+/// Clears the header and draws its buttons: UI_HEADER_PAGES ([L] [R]) and
+/// UI_HEADER_BACK_BUTTON (B Back). A screen draws its title after, from
+/// UI_HEADER_TITLE_X when it has [L] [R].
+void UiHeader_Draw(struct Window *header, s32 buttons) {
+  WindowSprite_PrepareForRedrawFar(header);
+  if (buttons & UI_HEADER_PAGES) {
+    Text_DrawMessageAsTilesFar(MsgArenaUiPrevious, header, 6, 0);
+    Text_DrawMessageAsTilesFar(MsgArenaUiNext, header, 32, 0);
+  }
+  if (buttons & UI_HEADER_BACK_BUTTON)
+    Text_DrawMessageAsTilesFar(MsgArenaUiBack, header,
+                               UiHeader_BackX(header) + 4, 0);
+}
+
+/// Where Back starts, in pixels inside the header.
+s32 UiHeader_BackX(struct Window *header) {
+  return (header->width - 2) * 8 - UI_HEADER_BACK;
+}
+
+#ifdef NATIVE
+/// Touch: a tap on a header button presses its key (L, R, B) for this frame,
+/// so the screen's own key code runs. Each button takes taps over the
+/// header's whole 24 pixels.
+void UiHeader_Touch(struct Window *header, s32 buttons) {
+  s32 backX;
+
+  if (header == 0)
+    return;
+  backX = UiHeader_BackX(header);
+  if ((buttons & UI_HEADER_PAGES) &&
+      WindowTouch_Cell(header, 0, -8, UI_HEADER_BUTTON, 24, 1, 1) == 0)
+    gKeysPressed |= KEY_L;
+  else if ((buttons & UI_HEADER_PAGES) &&
+           WindowTouch_Cell(header, UI_HEADER_BUTTON, -8, UI_HEADER_BUTTON, 24,
+                            1, 1) == 0)
+    gKeysPressed |= KEY_R;
+  else if ((buttons & UI_HEADER_BACK_BUTTON) &&
+           WindowTouch_Cell(header, backX, -8, UI_HEADER_BACK, 24, 1, 1) == 0)
+    gKeysPressed |= KEY_B;
+}
+#endif
+
+/// Sets a list up in `window`: `count` rows, messages labelBase + row, rows of
+/// `rowHeight` pixels from `top` inside the window, the text `textX` in (the
+/// hand sits 22 pixels before it), as many rows as fit showing.
+void UiList_Init(struct UiList *list, struct Window *window, s32 count,
+                 s32 labelBase, s32 rowHeight, s32 top, s32 textX,
+                 s32 cursor) {
+  s32 inside = (window->height - 2) * 8 - top;
+
+  list->window = window;
+  list->count = count;
+  list->labelBase = labelBase;
+  list->rowHeight = rowHeight;
+  list->top = top;
+  list->textX = textX;
+  list->visible = inside / rowHeight;
+  if (list->visible > count)
+    list->visible = count;
+  if (list->visible < 1)
+    list->visible = 1;
+  list->cursor = cursor;
+  list->first = 0;
+  UiList_Reveal(list);
+}
+
+/// Scrolls so the chosen row shows.
+void UiList_Reveal(struct UiList *list) {
+  if (list->cursor < list->first)
+    list->first = list->cursor;
+  if (list->cursor >= list->first + list->visible)
+    list->first = list->cursor - list->visible + 1;
+}
+
+/// The y of a showing row's text (tile text sits on 8-pixel rows), in the
+/// window.
+static s32 UiList_RowY(const struct UiList *list, s32 row) {
+  return list->top + (row - list->first) * list->rowHeight +
+         (list->rowHeight - 8) / 2;
+}
+
+/// Draws the showing rows, the arrows (the shop's own, hopping) when rows are
+/// hidden above or below, and puts the hand on the chosen row.
+void UiList_Draw(struct UiList *list) {
+  struct ShopState *shop = gMenuState;
+  struct Window *window = list->window;
+  s32 arrowX = (window->width - 2) * 8 - 16;
+  s32 row;
+
+  WindowSprite_PrepareForRedrawFar(window);
+  for (row = list->first;
+       row < list->first + list->visible && row < list->count; row++)
+    Text_DrawMessageAsTilesFar(list->labelBase + row, window, list->textX,
+                               UiList_RowY(list, row));
+  if (list->first > 0) {
+    struct WindowSprite *icon = WindowSprite_CreateFar(
+        shop->previousPageIcon, WINDOW_SPRITE_SIZE_16X16, window, arrowX, -8);
+
+    icon->kind = WINDOW_SPRITE_PLAIN;
+    icon->motion = WINDOW_SPRITE_MOTION_HOP_UP;
+    icon->animationStep = 0;
+  }
+  if (list->first + list->visible < list->count) {
+    struct WindowSprite *icon = WindowSprite_CreateFar(
+        shop->nextPageIcon, WINDOW_SPRITE_SIZE_16X16, window, arrowX,
+        (window->height - 2) * 8 - 8);
+
+    icon->kind = WINDOW_SPRITE_PLAIN;
+    icon->motion = WINDOW_SPRITE_MOTION_HOP_DOWN_NEXT_PAGE;
+    icon->animationStep = 0;
+  }
+  MenuCursor_Place(window, list->textX - 22,
+                   UiList_RowY(list, list->cursor));
+}
+
+/// One frame of input: touch (a tap on a row selects it, on the chosen row
+/// chooses it; a tap on an arrow scrolls a page) and keys (Up and Down move
+/// and wrap, A chooses, B cancels), with the shops' sounds. Returns
+/// UI_LIST_CHOSEN, UI_LIST_CANCELLED, UI_LIST_MOVED (redraw) or 0.
+s32 UiList_Step(struct UiList *list) {
+#ifdef NATIVE
+  {
+    struct Window *window = list->window;
+    s32 arrowX = (window->width - 2) * 8 - 20;
+    s32 slot = list->cursor - list->first;
+    s32 showing = list->count - list->first < list->visible
+                      ? list->count - list->first
+                      : list->visible;
+
+    if (list->first > 0 &&
+        WindowTouch_Cell(window, arrowX, -12, 24, 24, 1, 1) == 0) {
+      Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+      list->cursor -= list->visible;
+      if (list->cursor < 0)
+        list->cursor = 0;
+      list->first = list->cursor;
+      return UI_LIST_MOVED;
+    }
+    if (list->first + list->visible < list->count &&
+        WindowTouch_Cell(window, arrowX, (window->height - 2) * 8 - 12, 24, 24,
+                         1, 1) == 0) {
+      Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+      list->first += list->visible;
+      if (list->first > list->count - list->visible)
+        list->first = list->count - list->visible;
+      list->cursor = list->first;
+      return UI_LIST_MOVED;
+    }
+    if (WindowTouch_Pick(window, 0, list->top, arrowX - 4, list->rowHeight, 1,
+                         showing, &slot)) {
+      list->cursor = list->first + slot;
+      return UI_LIST_MOVED;
+    }
+  }
+#endif
+  if ((gKeysPressed & KEY_A) != 0) {
+    Sound_PlayFar(SE_MENU_CONFIRM);
+    return UI_LIST_CHOSEN;
+  }
+  if ((gKeysPressed & KEY_B) != 0) {
+    Sound_PlayFar(SE_MENU_CANCEL);
+    return UI_LIST_CANCELLED;
+  }
+  if ((gKeysRepeat & KEY_UP) != 0) {
+    Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+    list->cursor = (list->cursor + list->count - 1) % list->count;
+    UiList_Reveal(list);
+    return UI_LIST_MOVED;
+  }
+  if ((gKeysRepeat & KEY_DOWN) != 0) {
+    Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+    list->cursor = (list->cursor + 1) % list->count;
+    UiList_Reveal(list);
+    return UI_LIST_MOVED;
+  }
+  return 0;
+}
+
+#undef UI_HEADER_BUTTON
+#undef UI_HEADER_BACK
