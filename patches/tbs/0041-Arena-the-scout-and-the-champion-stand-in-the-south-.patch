From 1655a842fc40d0f0e5f39b6d463d98a046e44ffb Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Mon, 2 Nov 2026 08:59:54 +1100
Subject: [PATCH] Arena: the scout and the champion stand in the south strip of
 the hall

They stood beside the door, next to the old man. The scout now stands at
(160, 268) facing east and the champion at (272, 268) facing west, above the
pits' edges, clear of the door, the counters' fronts, the circle, the spawn
lane (216, 288), the wing entrances and the cases. Both placement tables.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/scene/battle_arena.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/games/tbs/src/scene/battle_arena.c b/games/tbs/src/scene/battle_arena.c
index 413f4b429f..63e8dceb70 100644
--- a/games/tbs/src/scene/battle_arena.c
+++ b/games/tbs/src/scene/battle_arena.c
@@ -1959,9 +1959,9 @@ struct ActorPlacement gBattleArenaActorPlacements[] = {
     // Arena romhack: two visitors who come once cups are cleared: the champion
     // after the last main cup, the scout after the third.
     ACTOR_PLACEMENT(SPRITE_MAN_WITH_GLASSES, IF_FLAG_SET(FLAG_ARENA_TROPHY_FIRST + 6), MOVEMENT_TYPE_STAND,
-        198, 0, 186, FACING_SOUTH, TALK_FACING_PARTY_AND_BACK, 0),
+        272, 0, 268, FACING_WEST, TALK_FACING_PARTY_AND_BACK, 0),
     ACTOR_PLACEMENT(SPRITE_MAN_WITH_PICKAXE, IF_FLAG_SET(FLAG_ARENA_TROPHY_FIRST + 2), MOVEMENT_TYPE_STAND,
-        234, 0, 190, FACING_SOUTH, TALK_FACING_PARTY_AND_BACK, 0),
+        160, 0, 268, FACING_EAST, TALK_FACING_PARTY_AND_BACK, 0),
     ACTOR_PLACEMENT(GARET, IF_FLAG_SET(FLAG_IN_PARTY(GARET)), MOVEMENT_TYPE_STAND,
         352, 0, 108, FACING_SOUTH, TALK_FACING_PARTY_AND_BACK, 0),
     ACTOR_PLACEMENT(IVAN, IF_FLAG_SET(FLAG_IN_PARTY(IVAN)), MOVEMENT_TYPE_STAND,
@@ -2051,9 +2051,9 @@ struct ActorPlacement gBattleArenaBattleActorPlacements[] = {
     // Arena romhack: two visitors who come once cups are cleared: the champion
     // after the last main cup, the scout after the third.
     ACTOR_PLACEMENT(SPRITE_MAN_WITH_GLASSES, IF_FLAG_SET(FLAG_ARENA_TROPHY_FIRST + 6), MOVEMENT_TYPE_STAND,
-        198, 0, 186, FACING_SOUTH, TALK_FACING_PARTY_AND_BACK, 0),
+        272, 0, 268, FACING_WEST, TALK_FACING_PARTY_AND_BACK, 0),
     ACTOR_PLACEMENT(SPRITE_MAN_WITH_PICKAXE, IF_FLAG_SET(FLAG_ARENA_TROPHY_FIRST + 2), MOVEMENT_TYPE_STAND,
-        234, 0, 190, FACING_SOUTH, TALK_FACING_PARTY_AND_BACK, 0),
+        160, 0, 268, FACING_EAST, TALK_FACING_PARTY_AND_BACK, 0),
     ACTOR_PLACEMENT(GARET, IF_FLAG_SET(FLAG_IN_PARTY(GARET)), MOVEMENT_TYPE_STAND,
         104, 0, 144, FACING_EAST, TALK_FACING_PARTY_AND_BACK, 0),
     ACTOR_PLACEMENT(IVAN, IF_FLAG_SET(FLAG_IN_PARTY(IVAN)), MOVEMENT_TYPE_STAND,
