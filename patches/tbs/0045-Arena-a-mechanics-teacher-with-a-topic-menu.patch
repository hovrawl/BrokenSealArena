   Shop_ReleaseWork();
   return 0;
 }
+
+/// Topics the mechanics teacher offers, one row of sixteen pixels each.
+#define MG_TOPIC_COUNT 6
+
+/// Arena romhack: the mechanics teacher's topic list. A window of six rows
+/// (MsgArenaMechTopic0 on) with the hand on `first`; Up and Down move (and
+/// wrap), A returns the row, B returns -1. The window closes before returning,
+/// so the topic's text can be shown. Far-called from the Battle Arena overlay.
+s32 MechanicsGuide_Choose(s32 first) {
+  struct ShopWork *shop;
+  struct Window *anchorWindow;
+  struct Window *list;
+  struct WindowSprite *anchor;
+  s32 cursor = first;
+  s32 result = -1;
+  s32 redraw = 1;
+  s32 i;
+
+  while (gKeysHeld != 0)
+    wait(1);
+  // Let a message window that has just closed finish clearing.
+  wait(30);
+  Shop_InitializeWork();
+  shop = gMenuWork;
+  anchorWindow = Window_CreateFar(-5, 0, 5, 5, WINDOW_FLAG_INSTANT);
+  anchor = WindowSprite_CreateFar(shop->cursorIcon, OUTPUT_SIZE_16X16,
+                                  anchorWindow, 0, 0);
+  anchor->motion = WINDOW_SPRITE_MOTION_WOBBLE;
+  anchor->kind = 0;
+  MenuCursor_SetPositionImmediate(&shop->cursor, -32, 112);
+  shop->cursor.anchor = anchor;
+  list = Window_CreateFar(4, 2, 22, 15, WINDOW_FLAG_INSTANT);
+  shop->mode = 12;
+
+  for (;;) {
+    if (redraw != 0) {
+      redraw = 0;
+      WindowSprite_PrepareForRedrawFar(list);
+      for (i = 0; i < MG_TOPIC_COUNT; i++)
+        Text_DrawMessageAsTilesFar(MsgArenaMechTopic0 + i, list, 24, i * 16 + 8);
+      MenuCursor_Place(list, 2, cursor * 16 + 8);
+    }
+    wait(1);
+    if ((gKeysPressed & KEY_B) != 0) {
+      Sound_PlayFar(SE_MENU_CANCEL);
+      break;
+    }
+    if ((gKeysPressed & KEY_A) != 0) {
+      Sound_PlayFar(SE_MENU_CONFIRM);
+      result = cursor;
+      break;
+    }
+    if ((gKeysRepeat & KEY_UP) != 0) {
+      Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+      cursor = (cursor + MG_TOPIC_COUNT - 1) % MG_TOPIC_COUNT;
+      redraw = 1;
+    }
+    if ((gKeysRepeat & KEY_DOWN) != 0) {
+      Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+      cursor = (cursor + 1) % MG_TOPIC_COUNT;
+      redraw = 1;
+    }
+  }
+
+  Window_CloseFar(list, 2);
+  Window_CloseFar(anchorWindow, 2);
+  wait(1);
+  Shop_ReleaseWork();
+  return result;
+}
