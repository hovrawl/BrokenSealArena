+/// Talking to the mechanics teacher (ACTOR_MECHANICS_GUIDE): a list of six
+/// topics (MechanicsGuide_Choose); each opens a few pages of text, then the
+/// list returns on the topic read. B leaves. Nothing about the party changes.
+s32 BattleArena_MechanicsGuide(s32 actorId) {
+  s32 topic = 0;
+
+  Event_Start();
+  Actor_SetAngleToward(actorId, gMainRoutineWork.leaderActorId, 0);
+  for (;;) {
+    topic = MechanicsGuide_Choose(topic);
+    if (topic < 0)
+      break;
+    Event_SetMessageId(MsgArenaMechText0 + topic);
+    FieldMessage_ShowAtActor(actorId, 0);
+  }
+  Event_End();
+  return 0;
+}
