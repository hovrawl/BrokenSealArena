diff --git a/games/tbs/src/game/game/arena_rules.c b/games/tbs/src/game/game/arena_rules.c
new file mode 100644
index 0000000000..3c8e3d9b9c
--- /dev/null
+++ b/games/tbs/src/game/game/arena_rules.c
@@ -0,0 +1,72 @@
+/// @file
+/// Arena romhack: the rules of the Golden Sun Reloaded rebalance that are code,
+/// not data (engine side), each behind its own switch in arena_config.h.
+/// The rebalance is by its authors (forum.goldensunhacking.net, topic 2779);
+/// the rules here were read from its patch and written again in C, see
+/// docs/RELOADED.md in the romhack's repository.
+// Part of game.c.
+
+#include "arena_config.h"
+
+#if ARENA_RULES_LEVELUP
+/// A level's gain in one stat, with no random part: the growth difference over
+/// the level's band (the 20 levels from one growth point to the next) is spread
+/// by dividing level times difference by 20, taking away what the level before
+/// had, so the gains of a band add up to the difference exactly (band 0, levels
+/// 1 to 19, divides by 19 for the same reason). Stock adds 0 to 19 at random to
+/// the difference and divides by 20. `level` is the level being reached.
+static s32 ArenaRules_LevelGain(s32 growthDifference, s32 level) {
+  s32 span = level >= 20 ? 20 : 19;
+
+  return level * growthDifference / span -
+         (level - 1) * growthDifference / span;
+}
+#endif
+
+#if ARENA_RULES_AILMENTS
+/// The unit's Ailment attribute: a bonus, in percent, to the chance of an effect
+/// it casts. It is kept in the byte of a unit record that no stock code names
+/// (Unit.unused[0], offset 0x46), set by Unit_Calculate from equipment.
+#define UNIT_AILMENT(unit) ((unit)->unused[0])
+
+/// The effects' base chances, in percent, by effect (enum AbilityEffect), for a
+/// target below luck 40 and for one at or above it (bosses). 151 and up is a
+/// fixed chance that neither levels nor luck change, less 151: so 251 always
+/// works and 151 never does (the target is immune). Below 151 the chance goes
+/// on to be adjusted by level, luck, the Ailment attribute and weaknesses.
+#define ARENA_EFFECT_RATE_COUNT 71
+#define ARENA_EFFECT_RATE_LUCK 40
+// clang-format off
+static const u8 sArenaRules_EffectRates[2][ARENA_EFFECT_RATE_COUNT] = {
+    {
+    251, 251, 251, 251, 251, 251, 251, 251, 75, 125, 251, 251,
+    75, 125, 251, 251, 75, 125, 45, 40, 70, 50, 40, 60,
+    45, 55, 60, 20, 60, 251, 40, 251, 251, 251, 30, 90,
+    90, 90, 90, 70, 251, 0, 251, 0, 251, 251, 251, 251,
+    251, 251, 251, 251, 251, 115, 5, 251, 251, 251, 130, 251,
+    251, 251, 251, 251, 251, 251, 251, 100, 251, 251, 251,
+    },
+    {
+    251, 251, 251, 251, 251, 251, 251, 251, 75, 125, 251, 251,
+    75, 125, 251, 251, 75, 125, 151, 151, 70, 50, 151, 151,
+    151, 55, 151, 151, 151, 251, 151, 251, 251, 251, 151, 90,
+    90, 90, 90, 151, 251, 151, 251, 151, 251, 251, 251, 251,
+    251, 251, 251, 251, 251, 115, 151, 251, 251, 251, 130, 251,
+    251, 251, 251, 251, 251, 251, 251, 100, 251, 251, 251,
+    },
+};
+// clang-format on
+
+/// Returns the base chance of effect `effectId` against a target of `luck`, as
+/// Battle_GetEffectBaseSuccessRate does: a negative value is a fixed chance.
+static s32 ArenaRules_EffectBaseRate(s32 effectId, s32 luck) {
+  s32 rate;
+
+  if (effectId < 0 || effectId >= ARENA_EFFECT_RATE_COUNT)
+    return -100;
+  rate = sArenaRules_EffectRates[luck >= ARENA_EFFECT_RATE_LUCK][effectId];
+  if (rate >= 151)
+    return 151 - rate;
+  return rate;
+}
+#endif
diff --git a/games/tbs/src/game/game/battle_arithmetic.c b/games/tbs/src/game/game/battle_arithmetic.c
index ef9783f516..bbf234daef 100644
--- a/games/tbs/src/game/game/battle_arithmetic.c
+++ b/games/tbs/src/game/game/battle_arithmetic.c
@@ -357,12 +357,24 @@ action4_done:
 
   // A positive base rate is adjusted by the element levels, the target's luck
   // and its weaknesses; 0 or a negative one is a fixed chance.
+#if ARENA_RULES_AILMENTS
+  // Reloaded: the base chance depends on the target's luck (bosses, luck 40 and
+  // up, are immune to some effects), the caster's level over 4 stands in for the
+  // element levels, and the caster's Ailment attribute is added.
+  score = ArenaRules_EffectBaseRate(effectId, unit->luck);
+  if (score > 0) {
+    struct Unit *caster_ = Unit_Get(caster);
+    s32 difference = (caster_->level >> 2) - (unit->luck >> 1);
+
+    score += difference * 3 + UNIT_AILMENT(caster_);
+#else
   score = Battle_GetEffectBaseSuccessRate(effectId);
   if (score > 0) {
     s32 difference = Unit_GetElementLevel(caster, resistanceCategory) -
                      Unit_GetElementLevel(target, resistanceCategory) -
                      (unit->luck >> 1);
     score += difference * 3;
+#endif
     if (BattleAbility_IsWeakToEffect(unit, effectId) != 0) {
       score += 25;
     }
@@ -375,7 +387,12 @@ action4_done:
   }
 
   for (attempt = 0; attempt < attempts; attempt++) {
+#if ARENA_RULES_AILMENTS
+    // Strictly greater: a chance of 0 never works.
+    if (score * successScale / 100 > (s32)Battle_RandomPercent()) {
+#else
     if (score * successScale / 100 >= (s32)Battle_RandomPercent()) {
+#endif
       return 1;
     }
   }
