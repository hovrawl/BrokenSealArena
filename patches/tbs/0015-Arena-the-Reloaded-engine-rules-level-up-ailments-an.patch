+#if ARENA_RULES_LEVELUP
+#define LEVEL_GAIN(difference) ArenaRules_LevelGain(difference, gains->level)
+#else
+#define LEVEL_GAIN(difference) (((Random16() * 20 >> 16) + (difference)) / 20)
+#endif
