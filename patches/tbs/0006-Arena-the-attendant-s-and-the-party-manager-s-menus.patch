From c221c2fd49904ccddc276824dae989bc411723e9 Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Fri, 30 Oct 2026 14:51:40 +1100
Subject: [PATCH] Arena: the attendant's and the party manager's menus

scene/arena_menu.c is a new object in the Battle Arena overlay. The attendant
asks Solo or Multiplayer and then the tournament (the Monster Gauntlet is the
only one); the man to the counter's right, once the linked-win teller, is now
the party manager: Characters, Djinn, Psynergy and the item shops, opening the
real Shop_Run on Xian's stock. A win pays 200 coins plus 100 for each earlier
win in the series and heals the party. battle_arena.c keeps only the hooks.
The overlay's import lists gain the functions the new code calls. Switch:
ARENA_TRAINING.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/scene/arena_menu.c         | 92 ++++++++++++++++++++++++
 games/tbs/src/scene/battle_arena.c       | 40 +++++++++++
 games/tbs/src/system/overlay/imports.inc |  9 +++
 3 files changed, 141 insertions(+)
 create mode 100644 games/tbs/src/scene/arena_menu.c

diff --git a/games/tbs/src/scene/arena_menu.c b/games/tbs/src/scene/arena_menu.c
new file mode 100644
index 0000000000..971da48968
--- /dev/null
+++ b/games/tbs/src/scene/arena_menu.c
@@ -0,0 +1,92 @@
+/// @file
+/// Arena romhack: the attendant and party manager menus (ARENA_TRAINING).
+
+// Part of battle_arena.c (included at its end), which has the includes.
+
+// Arena romhack: the arena's own menus. The attendant asks Solo or Multiplayer
+// and, for Solo, which tournament. The party manager (the man at the counter's
+// right) trains characters, sells Djinn and Psynergy, and opens the item shops.
+// Choices are a message window across the top and a row of command icons across
+// the bottom (ArenaMenu_IconChoose), as in the shops; a character is chosen in
+// the shops' strip of walking figures (ItemPicker_ChooseMember). All the text
+// is messages added to text/en.po (MsgArena*), so it draws in the game's own
+// font. The icon labels are consecutive messages, as IconMenu_Center wants.
+// The list screens draw as tiles and blank their window with
+// Window_ClearInteriorTiles before each redraw.
+const u8 gArenaMenu_AttendantIcons[] = {COMMAND_ICON_FIGHT, COMMAND_ICON_CABLE};
+const u8 gArenaMenu_TournamentIcons[] = {COMMAND_ICON_BATTLE};
+const u8 gArenaMenu_ManagerIcons[] = {COMMAND_ICON_STATUS, COMMAND_ICON_DJINN,
+                                      COMMAND_ICON_PSYNERGY, COMMAND_ICON_ITEM};
+const u8 gArenaMenu_ShopIcons[] = {COMMAND_ICON_ATTACK, COMMAND_ICON_DEFEND,
+                                   COMMAND_ICON_ITEM};
+
+/// The item shops the manager opens: Xian's weapon, armor and item shops, the
+/// last rows of the shop stock table.
+#define TRAINING_SHOP_FIRST_ROW 16
+
+/// The attendant's menu: Solo or Multiplayer and, for Solo, the tournament.
+/// Returns 1 for a solo series, 2 for a linked battle and 0 to leave. The
+/// Monster Gauntlet is the only tournament so far; the ladder it fights is
+/// gArenaLadder.
+s32 ArenaMenu_AttendantMode(void) {
+  s32 choice;
+
+  for (;;) {
+    choice = ArenaMenu_IconChoose(MsgArenaAttendantPrompt,
+                                  gArenaMenu_AttendantIcons, MsgArenaSolo, 2);
+    if (choice < 0)
+      return 0;
+    if (choice == 1)
+      return 2;
+    choice = ArenaMenu_IconChoose(MsgArenaTournamentPrompt,
+                                  gArenaMenu_TournamentIcons, MsgArenaGauntlet,
+                                  1);
+    if (choice == 0)
+      return 1;
+  }
+}
+
+/// The attendant reports the coins a battle just won, and the party is healed
+/// for the next one.
+void ArenaMenu_ShowWin(s32 actorId, s32 reward) {
+  MessageArgument_ClearAll();
+  MessageArgument_Push(reward, MESSAGE_ARGUMENT_NUMBER);
+  Event_SetMessageId(MsgArenaVictory);
+  Event_OpenMessage(actorId, 0);
+  Party_RestoreHpPp(1);
+}
+
+/// Talking to ACTOR_LINKED_WINS_TELLER, now the party manager: characters,
+/// Djinn, Psynergy and the item shops. B leaves; the party is healed on the
+/// way out, since stats and gear may have changed.
+s32 BattleArena_PartyManager(s32 actorId) {
+  s32 choice;
+  s32 member;
+
+  Event_Start();
+  Actor_FaceActor(actorId, gMainRoutineState.leaderActorId, 0);
+  for (;;) {
+    choice = ArenaMenu_IconChoose(MsgArenaManagerPrompt,
+                                  gArenaMenu_ManagerIcons, MsgArenaCharacters,
+                                  4);
+    if (choice < 0)
+      break;
+    if (choice == 3) {
+      choice = ArenaMenu_IconChoose(MsgArenaShopPrompt, gArenaMenu_ShopIcons,
+                                    MsgArenaWeapons, 3);
+      if (choice >= 0)
+        Shop_Run(TRAINING_SHOP_FIRST_ROW + choice, actorId);
+      continue;
+    }
+    // The strip shows the character's status (3), Djinn (1) or Psynergy (2)
+    // to match; Characters opens the stat counter (2), the others the Djinn (1)
+    // and Psynergy (0) counters.
+    member = ItemPicker_ChooseMember(choice == 0 ? 3 : choice);
+    if (member < 0)
+      continue;
+    ArenaShop_Run(choice == 0 ? 2 : (choice == 1 ? 1 : 0), member);
+  }
+  Party_RestoreHpPp(1);
+  Event_End();
+  return 0;
+}
diff --git a/games/tbs/src/scene/battle_arena.c b/games/tbs/src/scene/battle_arena.c
index 4eb10dee6b..00efa6fef7 100644
--- a/games/tbs/src/scene/battle_arena.c
+++ b/games/tbs/src/scene/battle_arena.c
@@ -15,6 +15,8 @@
 /// Most of the code is the link: the two consoles publish where each player
 /// stands in the arranging, and trade their parties before the battle.
 
+#include "arena_config.h"
+#include "arena/arena.h"
 #include "flags.h"
 #include "stddef.h"
 #include "types.h"
@@ -1012,12 +1014,24 @@ static s32 BattleArena_ChooseBattleMode(void) {
   s32 answer;
   s32 messageBase;
   s32 messageId;
+#if ARENA_TRAINING
+  s32 mode;
+#endif
 
   // The attendant's lines follow "Please speak to me when you want to fight in
   // a battle." (MsgLobbyPleaseSpeakWhen), as quoted where each is chosen.
   messageBase = MsgLobbyPleaseSpeakWhen;
   Event_Start();
   Actor_FaceActor(ACTOR_ATTENDANT, gMainRoutineState.leaderActorId, 0);
+#if ARENA_TRAINING
+  // Solo or Multiplayer, unless a series is already under way.
+  mode = 2;
+  if (!Event_GetFlag(FLAG_MONSTER_BATTLE)) {
+    mode = ArenaMenu_AttendantMode();
+    if (mode == 0)
+      goto leave;
+  }
+#endif
   if (BattleArena_PeerSlotMatches(BATTLE_ARENA_SLOT_SIGNATURE) == 0) {
     wait(1);
   }
@@ -1025,10 +1039,15 @@ static s32 BattleArena_ChooseBattleMode(void) {
     BattleArena_WriteSlotValue(BATTLE_ARENA_SLOT_ALONE);
     BattleArena_RestartLink();
     if (!Event_GetFlag(FLAG_MONSTER_BATTLE)) {
+#if ARENA_TRAINING
+      // The menu has asked: Solo starts a series, Multiplayer waits for a link.
+      answer = (mode == 1) ? YES : NO;
+#else
       Event_SetMessageId(messageBase + 5);
       // "You do not have an opponent. Would you like to battle a monster?"
       Event_OpenMessage(ACTOR_ATTENDANT, 0);
       answer = Event_AskYesNoWithActorAnimation(0, 0);
+#endif
       // Yes starts a monster series: FLAG_AREA_TEMP_E8's byte and
       // LINK_TALLY_MONSTER_STREAK start at 0.
       if (answer == YES) {
@@ -1113,6 +1132,9 @@ static s32 BattleArena_ChooseBattleMode(void) {
       }
     }
   }
+#if ARENA_TRAINING
+leave:
+#endif
   Event_End();
 #ifdef UBFIX
   return 0;
@@ -1536,6 +1558,9 @@ s32 Scene_Initialize(void) {
     s32 wins;
     s32 messageOffset;
     s32 v;
+#if ARENA_TRAINING
+    s32 reward;
+#endif
 
     Event_Start();
     Event_StartScreenTransition();
@@ -1543,6 +1568,14 @@ s32 Scene_Initialize(void) {
     BattleArena_WriteSlotValue(BATTLE_ARENA_SLOT_ALONE);
     gMainRoutineState.linkTallies[LINK_TALLY_MONSTER_WINS]++;
     gMainRoutineState.linkTallies[LINK_TALLY_MONSTER_STREAK]++;
+#if ARENA_TRAINING
+    // A win pays 200 coins, and 100 more for each win before it in the series.
+    reward = 200 + 100 * (gMainRoutineState.linkTallies[LINK_TALLY_MONSTER_STREAK] - 1);
+    gMainRoutineState.holdings.coins += reward;
+    if (gMainRoutineState.holdings.coins > COIN_MAX)
+      gMainRoutineState.holdings.coins = COIN_MAX;
+    ArenaMenu_ShowWin(ACTOR_ATTENDANT, reward);
+#endif
     // The offer has two lines a level (FLAG_MONSTER_BATTLE_WINS, -1 when a
     // series starts), the next monster's line going no further than
     // MONSTER_OFFER_LAST_NEXT. FLAG_AREA_TEMP_E8's byte counts the victories 0
@@ -1829,8 +1862,13 @@ struct Trigger gBattleArenaTriggers[] = {
     {TRIGGER_TALK, JENNA, CONDITION_ALWAYS, EVENT(BattleArena_TalkByProgress)},
     {TRIGGER_TALK, ACTOR_ATTENDANT, CONDITION_ALWAYS,
      EVENT(BattleArena_ChooseBattleMode)},
+#if ARENA_TRAINING
+    {TRIGGER_TALK, ACTOR_LINKED_WINS_TELLER, CONDITION_ALWAYS,
+     EVENT(BattleArena_PartyManager)},
+#else
     {TRIGGER_TALK, ACTOR_LINKED_WINS_TELLER, CONDITION_ALWAYS,
      EVENT(BattleArena_TellLinkedWins)},
+#endif
     {TRIGGER_TALK, ACTOR_HEALER, CONDITION_ALWAYS,
      EVENT(BattleArena_OpenSanctum)},
     {TRIGGER_TALK, ACTOR_GREETER, CONDITION_ALWAYS,
@@ -1871,3 +1909,5 @@ struct Trigger gBattleArenaTriggers[] = {
      EVENT(BattleArena_ReportLinkDisconnected)},
     {TRIGGER_TABLE_END},
 };
+
+#include "arena_menu.c"
