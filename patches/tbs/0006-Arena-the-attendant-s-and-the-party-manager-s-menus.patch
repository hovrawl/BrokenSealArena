+
+// Arena romhack: the arena's own menus. The attendant asks Solo or Multiplayer
+// and, for Solo, which tournament. The party manager (the man at the counter's
+// right) trains characters, sells Djinn and Psynergy, and opens the item shops.
+// Choices are a message window across the top and a row of command icons across
+// the bottom (ArenaMenu_IconChoose), as in the shops; a character is chosen in
+// the shops' strip of walking figures (ItemPicker_ChooseMember). All the text
+// is messages added to text/en.po (MsgArena*), so it draws in the game's own
+// font. The icon labels are consecutive messages, as IconMenu_Center wants.
+// The list screens draw as tiles and blank their window with
+// Window_ClearInteriorTiles before each redraw.
+const u8 gArenaMenu_AttendantIcons[] = {COMMAND_ICON_FIGHT, COMMAND_ICON_CABLE};
+const u8 gArenaMenu_TournamentIcons[] = {COMMAND_ICON_BATTLE};
+const u8 gArenaMenu_ManagerIcons[] = {COMMAND_ICON_STATUS, COMMAND_ICON_DJINN,
+                                      COMMAND_ICON_PSYNERGY, COMMAND_ICON_ITEM};
+const u8 gArenaMenu_ShopIcons[] = {COMMAND_ICON_ATTACK, COMMAND_ICON_DEFEND,
+                                   COMMAND_ICON_ITEM};
+
+/// The item shops the manager opens: Xian's weapon, armor and item shops, the
+/// last rows of the shop stock table.
+#define TRAINING_SHOP_FIRST_ROW 16
+
+/// The attendant's menu: Solo or Multiplayer and, for Solo, the tournament.
+/// Returns 1 for a solo series, 2 for a linked battle and 0 to leave. The
+/// Monster Gauntlet is the only tournament so far; the ladder it fights is
+/// gArenaLadder.
+s32 ArenaMenu_AttendantMode(void) {
+  s32 choice;
+
+  for (;;) {
+    choice = ArenaMenu_IconChoose(MsgArenaAttendantPrompt,
+                                  gArenaMenu_AttendantIcons, MsgArenaSolo, 2);
+    if (choice < 0)
+      return 0;
+    if (choice == 1)
+      return 2;
+    choice = ArenaMenu_IconChoose(MsgArenaTournamentPrompt,
+                                  gArenaMenu_TournamentIcons, MsgArenaGauntlet,
+                                  1);
+    if (choice == 0)
+      return 1;
+  }
+}
+
+/// The attendant reports the coins a battle just won, and the party is healed
+/// for the next one.
+void ArenaMenu_ShowWin(s32 actorId, s32 reward) {
+  MessageArgument_ClearAll();
+  MessageArgument_Push(reward, MESSAGE_ARGUMENT_NUMBER);
+  Event_SetMessageId(MsgArenaVictory);
+  FieldMessage_ShowAtActor(actorId, 0);
+  Party_RestoreHpPp(1);
+}
+
+/// Talking to ACTOR_LINKED_WINS_TELLER, now the party manager: characters,
+/// Djinn, Psynergy and the item shops. B leaves; the party is healed on the
+/// way out, since stats and gear may have changed.
+s32 BattleArena_PartyManager(s32 actorId) {
+  s32 choice;
+  s32 member;
+
+  Event_Start();
+  Actor_SetAngleToward(actorId, gMainRoutineWork.leaderActorId, 0);
+  for (;;) {
+    choice = ArenaMenu_IconChoose(MsgArenaManagerPrompt,
+                                  gArenaMenu_ManagerIcons, MsgArenaCharacters,
+                                  4);
+    if (choice < 0)
+      break;
+    if (choice == 3) {
+      choice = ArenaMenu_IconChoose(MsgArenaShopPrompt, gArenaMenu_ShopIcons,
+                                    MsgArenaWeapons, 3);
+      if (choice >= 0)
+        Shop_Run(TRAINING_SHOP_FIRST_ROW + choice, actorId);
+      continue;
+    }
+    // The strip shows the character's status (3), Djinn (1) or Psynergy (2)
+    // to match; Characters opens the stat counter (2), the others the Djinn (1)
+    // and Psynergy (0) counters.
+    member = ItemPicker_ChooseMember(choice == 0 ? 3 : choice);
+    if (member < 0)
+      continue;
+    ArenaShop_Run(choice == 0 ? 2 : (choice == 1 ? 1 : 0), member);
+  }
+  Party_RestoreHpPp(1);
+  Event_End();
+  return 0;
+}
