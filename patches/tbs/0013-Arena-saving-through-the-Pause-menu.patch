From 2e1a9ce16985e5d02ea3b7b9481082400c58fccf Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Fri, 30 Oct 2026 12:07:14 +1100
Subject: [PATCH] Arena: saving through the Pause menu

The Start (Pause) menu already has Save your quest. It is switched on in the
arena: the field no longer answers "unavailable" when FLAG_IN_BATTLE_ARENA is
set (field/field_sequence/run.c) and the menu lists all its entries, not only
Change settings (window/window/settings_menu.c). Save_ToChosenFile writes a
file saved in the arena as if the game stood at the arena's door with no series
running, so a load does not replay the last battle's reward or resume a series,
and puts the live values back after. New Game sets restartScene and
restartEntrance to the arena so Continue on a file from another build lands
there. Switch: ARENA_PAUSE_MENU.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/field/field_sequence/run.c    |  7 ++++-
 games/tbs/src/scene/file_screen.c           |  3 ++
 games/tbs/src/window/screens/save.c         | 32 +++++++++++++++++++++
 games/tbs/src/window/window/settings_menu.c | 10 +++++--
 4 files changed, 49 insertions(+), 3 deletions(-)

diff --git a/games/tbs/src/field/field_sequence/run.c b/games/tbs/src/field/field_sequence/run.c
index d5103faba0..537c5a9843 100644
--- a/games/tbs/src/field/field_sequence/run.c
+++ b/games/tbs/src/field/field_sequence/run.c
@@ -3,6 +3,10 @@
 /// entrance.
 // Part of field_sequence.c.
 
+#ifndef ARENA_PAUSE_MENU
+#define ARENA_PAUSE_MENU 1
+#endif
+
 #include "../field_sequence_internal.h"
 
 /// The actor system's work (struct ActorSystemWork, gActorSystemWork in
@@ -332,7 +336,8 @@ s32 FieldSequence_Run(s32 entrance) {
             Field_EndBusyAndReveal();
             AreaNameWindow_HideFar();
             gMainRoutineWork.returnMusic = Sound_GetCurrentBgmFar();
-            if (GameFlag_GetFar(FLAG_IN_BATTLE_ARENA) == 0) {
+            // Arena romhack: the Pause menu (Save your quest) works in the arena.
+            if (ARENA_PAUSE_MENU || GameFlag_GetFar(FLAG_IN_BATTLE_ARENA) == 0) {
               // With fewer than 136 of the 512 sprite VRAM blocks (64 bytes
               // each) free, sprite drawing stays suspended while the menu
               // runs, and a frame passes so that the field's sprites give
diff --git a/games/tbs/src/scene/file_screen.c b/games/tbs/src/scene/file_screen.c
index 1d3cf5da8f..42c6b0d7ed 100644
--- a/games/tbs/src/scene/file_screen.c
+++ b/games/tbs/src/scene/file_screen.c
@@ -534,6 +534,9 @@ menu_top:;
     Unit_Calculate(GARET);
     Unit_Calculate(MIA);
     Unit_Calculate(IVAN);
+    // Where Continue restarts a file saved by another build of the game.
+    gMainRoutineWork.restartScene = (s32)&SceneId_BattleArena;
+    gMainRoutineWork.restartEntrance = BATTLE_ARENA_FROM_FILE_SCREEN;
     gMainRoutineWork.leaderActorId = 0;
     GameFlag_Clear(FLAG_KEEP_PARTY_POSITION);
     GameFlag_Clear(FLAG_MENU_OPEN);
diff --git a/games/tbs/src/window/screens/save.c b/games/tbs/src/window/screens/save.c
index 5f1b70fba3..9a864a328e 100644
--- a/games/tbs/src/window/screens/save.c
+++ b/games/tbs/src/window/screens/save.c
@@ -2,7 +2,13 @@
 /// Save files and the file list.
 // Part of screens.c.
 
+#ifndef ARENA_PAUSE_MENU
+#define ARENA_PAUSE_MENU 1
+#endif
+
 #include "../screens_internal.h"
+#include "scene_ids.h"
+#include "scene_exits.h"
 
 // The three save files. Each is two 4 KB parts of backup memory: part
 // `file` holds the first half of the 8 KB save buffer and part
@@ -1190,6 +1196,24 @@ s32 Save_ToChosenFile(void) {
   s32 file;
   s32 error;
   struct SaveWork *work;
+#if ARENA_PAUSE_MENU
+  s32 arenaNext = gMainRoutineWork.next;
+  s32 arenaEntrance = gMainRoutineWork.entrance;
+  s32 arenaSeries = 0;
+  s32 inArena = GameFlag_GetFar(FLAG_IN_BATTLE_ARENA);
+
+  // Arena romhack: a file saved in the arena is written as if the game stood at
+  // the arena's door with no series running, so a load does not replay the last
+  // battle's reward (its entrance) or resume a series (FLAG_MONSTER_BATTLE). The
+  // live values are put back after.
+  if (inArena) {
+    arenaSeries = GameFlag_GetFar(FLAG_MONSTER_BATTLE);
+    gMainRoutineWork.next = (s32)&SceneId_BattleArena;
+    gMainRoutineWork.entrance = BATTLE_ARENA_FROM_FILE_SCREEN;
+    if (arenaSeries)
+      GameFlag_ClearFar(FLAG_MONSTER_BATTLE);
+  }
+#endif
 
   result = 0;
   error = Save_InitializeWork();
@@ -1241,6 +1265,14 @@ s32 Save_ToChosenFile(void) {
   }
 done:
   Save_ReleaseWork();
+#if ARENA_PAUSE_MENU
+  if (inArena) {
+    gMainRoutineWork.next = arenaNext;
+    gMainRoutineWork.entrance = arenaEntrance;
+    if (arenaSeries)
+      GameFlag_SetFar(FLAG_MONSTER_BATTLE);
+  }
+#endif
   return result;
 }
 
diff --git a/games/tbs/src/window/window/settings_menu.c b/games/tbs/src/window/window/settings_menu.c
index 9317052650..d8571e3b4a 100644
--- a/games/tbs/src/window/window/settings_menu.c
+++ b/games/tbs/src/window/window/settings_menu.c
@@ -2,6 +2,10 @@
 /// Window colours, the settings menu and the Pause menu.
 // Part of window.c.
 
+#ifndef ARENA_PAUSE_MENU
+#define ARENA_PAUSE_MENU 1
+#endif
+
 #include "../window_internal.h"
 
 /// Nothing calls them.
@@ -701,7 +705,8 @@ struct Window *PauseMenu_Open(void) {
 
   rows = PAUSE_MENU_ROWS;
   work = gOptionMenuWork;
-  settingsOnly = GameFlag_GetFar(FLAG_IN_BATTLE_ARENA);
+  // Arena romhack: the whole Pause menu, Save your quest included, in the arena.
+  settingsOnly = ARENA_PAUSE_MENU ? 0 : GameFlag_GetFar(FLAG_IN_BATTLE_ARENA);
   first = 0;
   if (settingsOnly != 0) {
     rows = 1;
@@ -785,7 +790,8 @@ s32 PauseMenu_Choose(void) {
 
   redraw = 1;
   rows = PAUSE_MENU_ROWS;
-  settingsOnly = GameFlag_GetFar(FLAG_IN_BATTLE_ARENA);
+  // Arena romhack: the whole Pause menu, Save your quest included, in the arena.
+  settingsOnly = ARENA_PAUSE_MENU ? 0 : GameFlag_GetFar(FLAG_IN_BATTLE_ARENA);
   first = 0;
   PauseMenu_Initialize();
   work = gOptionMenuWork;
-- 
2.53.0

