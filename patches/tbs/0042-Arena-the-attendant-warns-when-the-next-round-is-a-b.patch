diff --git a/games/tbs/src/scene/arena_series.c b/games/tbs/src/scene/arena_series.c
index a1e25f0524..2001b836f7 100644
--- a/games/tbs/src/scene/arena_series.c
+++ b/games/tbs/src/scene/arena_series.c
@@ -178,4 +178,13 @@ static void ArenaSeries_AfterWin(void) {
   Event_SetMessageId(ArenaCup_Heals() ? MsgArenaNextRound
                                       : MsgArenaNextRoundBossRush);
   FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
+  // Round `won + 1` is next: warn when it is a boss or a mini-boss (the bit of the
+  // round is its number less one).
+  if (info->bossRounds & (1 << won)) {
+    Event_SetMessageId(MsgArenaBossWarning);
+    FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
+  } else if (info->miniBossRounds & (1 << won)) {
+    Event_SetMessageId(MsgArenaMiniBossWarning);
+    FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
+  }
 }
