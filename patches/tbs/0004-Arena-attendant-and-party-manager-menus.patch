+/// The Djinn shop: any of the 28 Djinn, given to one character and set at once.
+static void Training_RunDjinn(s32 unitId) {
+  struct Window *window = Training_OpenScreen();
+  s32 cursor = 0;
+  s32 top = 0;
+  s32 redraw = 1;
+  s32 notice = 0;
+  s32 key;
+  s32 row;
+
+  for (;;) {
+    if (redraw) {
+      Training_Clear(window);
+      Training_DrawHeader(window, Unit_Get(unitId)->name);
+      for (row = 0; row < TRAINING_DJINN_ROWS; row++) {
+        s32 n = top + row;
+        s32 element = n / TRAINING_DJINN_PER_ELEMENT;
+        s32 index = n % TRAINING_DJINN_PER_ELEMENT;
+        s32 y = (row + 1) * TRAINING_ROW_HEIGHT;
+
+        if (n >= TRAINING_DJINN_COUNT)
+          break;
+        if (n == cursor)
+          Text_DrawString(gTraining_Cursor, window, 0, y);
+        Text_DrawMessage(MsgDjinnName + element * DJINN_PER_ELEMENT + index,
+                         window, TRAINING_LABEL_X, y);
+        if (Training_DjinnOwned(element, index))
+          Text_DrawString(gTraining_Owned, window, 180, y);
+        else
+          Text_DrawNumber(TRAINING_DJINN_COST, 6, window, 180, y);
+      }
+      if (notice == 1)
+        Text_DrawString(gTraining_Poor, window, 0,
+                        (TRAINING_DJINN_ROWS + 1) * TRAINING_ROW_HEIGHT);
+      else if (notice == 2)
+        Text_DrawString(gTraining_DjinnFull, window, 0,
+                        (TRAINING_DJINN_ROWS + 1) * TRAINING_ROW_HEIGHT);
+      redraw = 0;
+    }
+    key = Training_Navigate(&cursor, TRAINING_DJINN_COUNT);
+    if (notice != 0)
+      redraw = 1;
+    notice = 0;
+    if (key == -1)
+      break;
+    if (key == 2 || key == 1) {
+      redraw = 1;
+      if (cursor < top)
+        top = cursor;
+      if (cursor >= top + TRAINING_DJINN_ROWS)
+        top = cursor - TRAINING_DJINN_ROWS + 1;
+    }
+    if (key == 1) {
+      s32 element = cursor / TRAINING_DJINN_PER_ELEMENT;
+      s32 index = cursor % TRAINING_DJINN_PER_ELEMENT;
+
+      if (Training_DjinnOwned(element, index)) {
+        // Nothing to buy.
+      } else if (gMainRoutineWork.coins < TRAINING_DJINN_COST) {
+        notice = 1;
+      } else if (Djinn_Give(unitId, element, index) < 0) {
+        notice = 2;
+      } else {
+        gMainRoutineWork.coins -= TRAINING_DJINN_COST;
+        Djinn_Set(unitId, element, index);
+        Unit_Calculate(unitId);
+      }
+    }
+  }
+  Window_Close(window, 2);
+}
