+/// Shows `prompt` in a window across the top of the screen and the `count`
+/// options (at most six) in one across the bottom, three to a column. Returns
+/// the option chosen with A, or -1 for B.
+static s32 ArenaMenu_Choose(const u8 *prompt, const u8 *const *options,
+                            s32 count) {
+  struct Window *top;
+  struct Window *bottom;
+  s32 cursor = 0;
+  s32 redraw = 1;
+  s32 result;
+  s32 i;
+
+  while (gKeysHeld != 0)
+    wait(1);
+  top = Window_Create(0, 0, 30, 5, WINDOW_FLAG_INSTANT);
+  Text_DrawString(prompt, top, 4, 4);
+  bottom = Window_Create(0, 12, 30, 8, WINDOW_FLAG_INSTANT);
+  for (;;) {
+    if (redraw) {
+      Window_ClearInteriorTiles(bottom, 0, 0, TRAINING_FULL_W, 48);
+      for (i = 0; i < count; i++) {
+        s32 x = (i / 3) * 112;
+        s32 y = (i % 3) * TRAINING_ROW_HEIGHT;
+
+        if (i == cursor)
+          Text_DrawString(gTraining_Cursor, bottom, x, y);
+        Text_DrawString(options[i], bottom, x + TRAINING_LABEL_X, y);
+      }
+      redraw = 0;
+    }
+    wait(1);
+    if (gKeysRepeat & KEY_B) {
+      result = -1;
+      break;
+    }
+    if (gKeysRepeat & KEY_A) {
+      result = cursor;
+      break;
+    }
+    if (gKeysRepeat & KEY_DOWN) {
+      if (++cursor >= count)
+        cursor = 0;
+      redraw = 1;
+    } else if (gKeysRepeat & KEY_UP) {
+      if (--cursor < 0)
+        cursor = count - 1;
+      redraw = 1;
+    } else if ((gKeysRepeat & KEY_RIGHT) && cursor + 3 < count) {
+      cursor += 3;
+      redraw = 1;
+    } else if ((gKeysRepeat & KEY_LEFT) && cursor >= 3) {
+      cursor -= 3;
+      redraw = 1;
+    }
+  }
+  Window_Close(bottom, 2);
+  Window_Close(top, 2);
+  return result;
+}
+
+/// Asks which of the four characters, returning its unit id or -1.
+static s32 ArenaMenu_ChooseMember(void) {
+  const u8 *names[TRAINING_MEMBER_COUNT];
+  s32 member;
+  s32 choice;
+
+  for (member = 0; member < TRAINING_MEMBER_COUNT; member++)
+    names[member] = Unit_Get(gTraining_Members[member])->name;
+  choice = ArenaMenu_Choose(gArenaMenu_WhoPrompt, names, TRAINING_MEMBER_COUNT);
+  if (choice < 0)
+    return -1;
+  return gTraining_Members[choice];
+}
+
+/// The attendant's menu: Solo or Multiplayer and, for Solo, the tournament.
+/// Returns 1 for a solo series, 2 for a linked battle and 0 to leave. The
+/// Monster Gauntlet is the only tournament so far; the ladder it fights is
+/// gArenaLadder.
+static s32 ArenaMenu_AttendantMode(void) {
+  s32 choice;
+
+  for (;;) {
+    choice = ArenaMenu_Choose(gArenaMenu_AttendantPrompt,
+                              gArenaMenu_AttendantOptions, 2);
+    if (choice < 0)
+      return 0;
+    if (choice == 1)
+      return 2;
+    choice = ArenaMenu_Choose(gArenaMenu_TournamentPrompt,
+                              gArenaMenu_TournamentOptions, 2);
+    if (choice == 0)
+      return 1;
+  }
+}
+
+/// Reports the coins a battle just won and heals the party for the next one.
+static void ArenaMenu_ShowWin(s32 reward) {
+  struct Window *top;
+
+  while (gKeysHeld != 0)
+    wait(1);
+  top = Window_Create(0, 0, 30, 5, WINDOW_FLAG_INSTANT);
+  Text_DrawString(gArenaMenu_Victory, top, 4, 4);
+  Text_DrawNumber(reward, 6, top, 150, 4);
+  do {
+    wait(1);
+  } while (!(gKeysRepeat & (KEY_A | KEY_B)));
+  Window_Close(top, 2);
+  Party_RestoreHpPp(1);
+}
