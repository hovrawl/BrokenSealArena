+/// Arena romhack: what the member picker shows beside the party strip.
+enum ArenaPickerMode {
+  ARENA_PICKER_ITEMS = 0,    ///< the member's items, as the shops' Sell shows
+  ARENA_PICKER_DJINN = 1,    ///< the member's Djinn, an element icon and name
+  ARENA_PICKER_PSYNERGY = 2, ///< the member's Psynergy, an icon and name
+};
+
+/// The Djinn and Psynergy panels are a 30 by 10 tile window across the top of
+/// the screen, 224 by 64 pixels inside. Djinn run in three columns of eight
+/// pixel rows, Psynergy in two columns of sixteen pixel rows; what does not fit
+/// is not shown.
+#define ARENA_PANEL_DJINN_COLUMNS 3
+#define ARENA_PANEL_DJINN_ROWS 8
+#define ARENA_PANEL_DJINN_COLUMN_WIDTH 72
+#define ARENA_PANEL_PSYNERGY_COLUMNS 2
+#define ARENA_PANEL_PSYNERGY_ROWS 4
+#define ARENA_PANEL_PSYNERGY_COLUMN_WIDTH 112
+/// The first of the four element icons among the window tiles; the Djinn
+/// menu's list uses the same (DJINN_ELEMENT_TILE).
+#define ARENA_ELEMENT_TILE 0x5001
+/// The game has seven Djinn of each element.
+#define ARENA_DJINN_PER_ELEMENT 7
+
+/// Draws the member's Djinn as an element icon and a name each.
+static void ArenaPicker_DrawDjinn(struct Window *window, s32 unitId) {
+  struct Unit *unit = Unit_GetFar(unitId);
+  s32 shown = 0;
+  s32 element;
+  s32 index;
+
+  WindowSprite_PrepareForRedrawFar(window);
+  for (element = 0; element < ELEMENT_COUNT; element++) {
+    for (index = 0; index < ARENA_DJINN_PER_ELEMENT; index++) {
+      s32 x;
+      s32 y;
+
+      if (!(unit->djinnHeld[element] & (1 << index)))
+        continue;
+      if (shown >= ARENA_PANEL_DJINN_COLUMNS * ARENA_PANEL_DJINN_ROWS)
+        return;
+      x = (shown % ARENA_PANEL_DJINN_COLUMNS) * ARENA_PANEL_DJINN_COLUMN_WIDTH;
+      y = (shown / ARENA_PANEL_DJINN_COLUMNS) * 8;
+      Window_SetTilemapEntryFar(window, ARENA_ELEMENT_TILE + element, x / 8,
+                                y / 8, 0);
+      Text_DrawMessageAsTilesFar(MsgDjinnName + element * DJINN_PER_ELEMENT +
+                                     index,
+                                 window, x + 12, y);
+      shown++;
+    }
+  }
+  if (shown == 0)
+    Text_DrawMessageAsTilesFar(MsgArenaNone, window, 8, 0);
+}
+
+/// Draws the member's Psynergy as an icon and a name each.
+static void ArenaPicker_DrawPsynergy(struct Window *window, s32 unitId) {
+  struct Unit *unit = Unit_GetFar(unitId);
+  s32 shown = 0;
+  s32 i;
+
+  WindowSprite_PrepareForRedrawFar(window);
+  for (i = 0; i < 32; i++) {
+    s32 id = unit->psynergy[i].encodedAction & PSYNERGY_ABILITY_MASK;
+    struct WindowSprite *icon;
+    s32 x;
+    s32 y;
+
+    if (id == 0)
+      continue;
+    if (shown >= ARENA_PANEL_PSYNERGY_COLUMNS * ARENA_PANEL_PSYNERGY_ROWS)
+      return;
+    x = (shown % ARENA_PANEL_PSYNERGY_COLUMNS) *
+        ARENA_PANEL_PSYNERGY_COLUMN_WIDTH;
+    y = (shown / ARENA_PANEL_PSYNERGY_COLUMNS) * 16;
+    icon = WindowSprite_CreateFromResourceFar(ICON_KIND_ABILITY, id, window,
+                                              x + 4, y);
+    if (icon != 0)
+      icon->sentinel = 252;
+    Text_DrawMessageAsTilesFar(MsgAbilityName + id, window, x + 24, y + 4);
+    shown++;
+  }
+  if (shown == 0)
+    Text_DrawMessageAsTilesFar(MsgArenaNone, window, 8, 0);
+}
