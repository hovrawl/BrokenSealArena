+/// Buys entry `entry` for the character. Returns 0, or the message that says
+/// why not.
+static s32 Training_GridBuy(s32 kind, s32 unitId, s32 entry) {
+  s32 cost = Training_GridCost(kind, entry);
+
+  if (Training_GridOwned(kind, unitId, entry))
+    return 0;
+  if (gMainRoutineWork.coins < cost)
+    return MsgArenaNoCoins;
+  if (kind == TRAIN_GRID_DJINN) {
+    s32 element = entry / TRAINING_DJINN_PER_ELEMENT;
+    s32 index = entry % TRAINING_DJINN_PER_ELEMENT;
+
+    if (Djinn_Give(unitId, element, index) < 0)
+      return MsgArenaNoDjinnRoom;
+    Djinn_Set(unitId, element, index);
+  } else if (Unit_LearnPsynergy(unitId, gTraining_PsynergyShop[entry].id) < 0) {
+    return MsgArenaNoPsynergyRoom;
+  }
+  gMainRoutineWork.coins -= cost;
+  Unit_Calculate(unitId);
+  return 0;
+}
