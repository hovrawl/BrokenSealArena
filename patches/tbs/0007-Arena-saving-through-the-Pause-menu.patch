diff --git a/games/tbs/src/window/screens_save.c b/games/tbs/src/window/screens_save.c
index 60157c58db..f664eef08b 100644
--- a/games/tbs/src/window/screens_save.c
+++ b/games/tbs/src/window/screens_save.c
@@ -3,6 +3,7 @@
 // Part of screens.c.
 
 #include "screens_internal.h"
+#include "arena_config.h"
 
 /// A file's half in bytes: the first is written to the file's slot, the
 /// second to the slot SAVE_FILE_COUNT on. Then the file number for no free
@@ -1150,6 +1151,11 @@ s32 Save_ToChosenFile(void) {
   s32 file;
   s32 error;
   struct SaveState *state;
+#if ARENA_PAUSE_MENU
+  struct ArenaSaveState arenaSave;
+
+  ArenaSave_Begin(&arenaSave);
+#endif
 
   result = 0;
   error = Save_InitializeState();
@@ -1201,6 +1207,9 @@ s32 Save_ToChosenFile(void) {
   }
 done:
   Save_ReleaseState();
+#if ARENA_PAUSE_MENU
+  ArenaSave_End(&arenaSave);
+#endif
   return result;
 }
 
