index f34ac9db2e..65a1280204 100644
--- a/games/tbs/src/field/field_sequence_run.c
+++ b/games/tbs/src/field/field_sequence_run.c
@@ -4,6 +4,7 @@
 // Part of field_sequence.c.
 
 #include "field_sequence_internal.h"
+#include "arena_config.h"
 
 /// The hazard count's limit each scene starts with, in steps on hazard cells:
 /// the hazard deals its damage each time the count reaches it.
@@ -322,7 +323,8 @@ s32 FieldSequence_Run(s32 entrance) {
             Field_EndBusyAndReveal();
             AreaNameWindow_HideFar();
             gMainRoutineState.returnMusic = Sound_GetCurrentBgmFar();
-            if (GameFlag_GetFar(FLAG_IN_BATTLE_ARENA) == 0) {
+            // Arena romhack: the Pause menu (Save your quest) works in the arena.
+            if (ARENA_PAUSE_MENU || GameFlag_GetFar(FLAG_IN_BATTLE_ARENA) == 0) {
               // With fewer than PAUSE_MENU_VRAM_BLOCKS of the sprite VRAM
               // blocks free, sprite drawing stays suspended while the menu
               // runs, and a frame passes so that the field's sprites give
diff --git a/games/tbs/src/window/arena_save.c b/games/tbs/src/window/arena_save.c
new file mode 100644
index 0000000000..d5b163955b
--- /dev/null
+++ b/games/tbs/src/window/arena_save.c
@@ -0,0 +1,40 @@
+/// @file
+/// Arena romhack: saving in the arena. A file saved there is written as if the
+/// game stood at the arena's door with no series running, so a load does not
+/// replay the last battle's reward (its entrance) or resume a series
+/// (FLAG_MONSTER_BATTLE). The live values are put back after.
+// Part of screens.c.
+
+#include "screens_internal.h"
+#include "scene_ids.h"
+#include "scene_exits.h"
+
+struct ArenaSaveState {
+  s32 next;
+  s32 entrance;
+  s32 series;
+  s32 inArena;
+};
+
+static void ArenaSave_Begin(struct ArenaSaveState *state) {
+  state->next = gMainRoutineState.next;
+  state->entrance = gMainRoutineState.entrance;
+  state->series = 0;
+  state->inArena = GameFlag_GetFar(FLAG_IN_BATTLE_ARENA);
+  if (state->inArena) {
+    state->series = GameFlag_GetFar(FLAG_MONSTER_BATTLE);
+    gMainRoutineState.next = SCENE_BATTLE_ARENA;
+    gMainRoutineState.entrance = BATTLE_ARENA_FROM_FILE_SCREEN;
+    if (state->series)
+      GameFlag_ClearFar(FLAG_MONSTER_BATTLE);
+  }
+}
+
+static void ArenaSave_End(struct ArenaSaveState *state) {
+  if (state->inArena) {
+    gMainRoutineState.next = state->next;
+    gMainRoutineState.entrance = state->entrance;
+    if (state->series)
+      GameFlag_SetFar(FLAG_MONSTER_BATTLE);
+  }
+}
