index 0000000000..8b6a2da2cd
--- /dev/null
+++ b/games/tbs/src/window/screens/arena_save.c
@@ -0,0 +1,40 @@
+/// @file
+/// Arena romhack: saving in the arena. A file saved there is written as if the
+/// game stood at the arena's door with no series running, so a load does not
+/// replay the last battle's reward (its entrance) or resume a series
+/// (FLAG_MONSTER_BATTLE). The live values are put back after.
+// Part of screens.c.
+
+#include "../screens_internal.h"
+#include "scene_ids.h"
+#include "scene_exits.h"
+
+struct ArenaSaveState {
+  s32 next;
+  s32 entrance;
+  s32 series;
+  s32 inArena;
+};
+
+static void ArenaSave_Begin(struct ArenaSaveState *state) {
+  state->next = gMainRoutineWork.next;
+  state->entrance = gMainRoutineWork.entrance;
+  state->series = 0;
+  state->inArena = GameFlag_GetFar(FLAG_IN_BATTLE_ARENA);
+  if (state->inArena) {
+    state->series = GameFlag_GetFar(FLAG_MONSTER_BATTLE);
+    gMainRoutineWork.next = (s32)&SceneId_BattleArena;
+    gMainRoutineWork.entrance = BATTLE_ARENA_FROM_FILE_SCREEN;
+    if (state->series)
+      GameFlag_ClearFar(FLAG_MONSTER_BATTLE);
+  }
+}
+
+static void ArenaSave_End(struct ArenaSaveState *state) {
+  if (state->inArena) {
+    gMainRoutineWork.next = state->next;
+    gMainRoutineWork.entrance = state->entrance;
+    if (state->series)
+      GameFlag_SetFar(FLAG_MONSTER_BATTLE);
+  }
+}
diff --git a/games/tbs/src/window/screens/save.c b/games/tbs/src/window/screens/save.c
index 5f1b70fba3..88a2e431ec 100644
--- a/games/tbs/src/window/screens/save.c
+++ b/games/tbs/src/window/screens/save.c
@@ -2,6 +2,8 @@
 /// Save files and the file list.
 // Part of screens.c.
 
+#include "arena_config.h"
+
 #include "../screens_internal.h"
 
 // The three save files. Each is two 4 KB parts of backup memory: part
@@ -1190,6 +1192,11 @@ s32 Save_ToChosenFile(void) {
   s32 file;
   s32 error;
   struct SaveWork *work;
+#if ARENA_PAUSE_MENU
+  struct ArenaSaveState arenaSave;
+
+  ArenaSave_Begin(&arenaSave);
+#endif
 
   result = 0;
   error = Save_InitializeWork();
@@ -1241,6 +1248,9 @@ s32 Save_ToChosenFile(void) {
   }
 done:
   Save_ReleaseWork();
+#if ARENA_PAUSE_MENU
+  ArenaSave_End(&arenaSave);
+#endif
   return result;
 }
 
