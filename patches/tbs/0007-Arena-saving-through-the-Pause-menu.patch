 games/tbs/src/window/screens.c              |  1 +
 games/tbs/src/window/screens/arena_save.c   | 40 +++++++++++++++++++++
 games/tbs/src/window/screens/save.c         | 10 ++++++
 games/tbs/src/window/window/settings_menu.c |  8 +++--
 5 files changed, 61 insertions(+), 3 deletions(-)
 create mode 100644 games/tbs/src/window/screens/arena_save.c

