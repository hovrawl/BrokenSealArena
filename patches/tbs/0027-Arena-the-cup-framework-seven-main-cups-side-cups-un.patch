+/// A Djinni (element * 7 + n, the shop's numbering) joins the first party
+/// member with room for it. 1 if one had, 0 if none did.
+static s32 ArenaSeries_GiveDjinni(s32 entry) {
+  s32 element = entry / 7;
+  s32 index = entry % 7;
+  s32 count = Party_CountMembers();
+  s32 i;
+
+  for (i = 0; i < count; i++) {
+    s32 unitId = gMainRoutineWork.party[i];
+
+    if (Djinn_Give(unitId, element, index) >= 0) {
+      Djinn_Set(unitId, element, index);
+      Unit_Calculate(unitId);
+      return 1;
+    }
+  }
+  return 0;
+}
+
+/// The rewards of the round just won (rounds won so far = `won`), each given
+/// once: the flag bit of the reward says it was.
+static void ArenaSeries_GiveRewards(const struct ArenaCupInfo *info, s32 won) {
+  s32 i;
+
+  for (i = 0; i < info->rewardCount; i++) {
+    const struct ArenaCupReward *reward = &info->rewards[i];
+
+    if (reward->afterRound != won ||
+        GameFlag_Get(ARENA_REWARD_FLAG_FIRST + reward->flag))
+      continue;
+    if (reward->kind == ARENA_REWARD_ITEM) {
+      GameFlag_Set(ARENA_REWARD_FLAG_FIRST + reward->flag);
+      Event_SetMessageId(MsgArenaGearReward);
+      FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
+      PartyInventory_GiveItem(reward->item, 0);
+    } else if (ArenaSeries_GiveDjinni(reward->value)) {
+      GameFlag_Set(ARENA_REWARD_FLAG_FIRST + reward->flag);
+      Event_SetMessageId(reward->message);
+      FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
+    } else {
+      Event_SetMessageId(MsgArenaDjinnNoRoom);
+      FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
+    }
+  }
+}
+
+/// The party is raised to `level` (never lowered: Unit_LevelUpTo only gains) and
+/// healed.
+static void ArenaSeries_RaiseParty(s32 level) {
+  Unit_LevelUpTo(ISAAC, level);
+  Unit_LevelUpTo(GARET, level);
+  Unit_LevelUpTo(MIA, level);
+  Unit_LevelUpTo(IVAN, level);
+  Unit_Calculate(ISAAC);
+  Unit_Calculate(GARET);
+  Unit_Calculate(MIA);
+  Unit_Calculate(IVAN);
+  Party_RestoreHpPp(1);
+}
+
+/// A cup cleared. The first clear of a main cup (the progress is its index)
+/// plays the unlock scene and advances the progress and the level; the first
+/// clear of a side cup plays its scene and sets its bit; any other clear only
+/// congratulates.
+static void ArenaSeries_Cleared(s32 cup, const struct ArenaCupInfo *info) {
+  s32 first = 0;
+
+  if (cup < ARENA_MAIN_CUPS) {
+    first = ArenaCup_Progress() == cup;
+  } else {
+    first = !(FieldGameFlag_GetByte(FLAG_ARENA_SIDE_CLEARED) &
+              (1 << (cup - ARENA_MAIN_CUPS)));
+  }
+  if (!first) {
+    Event_SetMessageId(info->clearedMsg);
+    FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
+    return;
+  }
+  if (cup < ARENA_MAIN_CUPS)
+    FieldGameFlag_SetByte(FLAG_ARENA_PROGRESS, cup + 1);
+  else
+    FieldGameFlag_SetByte(FLAG_ARENA_SIDE_CLEARED,
+                          FieldGameFlag_GetByte(FLAG_ARENA_SIDE_CLEARED) |
+                              (1 << (cup - ARENA_MAIN_CUPS)));
+  Event_SetMessageId(info->firstMsg);
+  FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
+  if (info->raiseTo != 0)
+    ArenaSeries_RaiseParty(info->raiseTo);
+}
