+/* Generated by scripts/gen-cups.py from scripts/cupdata.py. Do not edit. */
+#ifndef ALCHEMY_MODULE_ARENA_CUPS_H
+#define ALCHEMY_MODULE_ARENA_CUPS_H
+
+#include "types.h"
+
+#define ARENA_CUP_COUNT 9
+#define ARENA_MAIN_CUPS 7
+#define ARENA_REWARD_FLAG_FIRST 0x7A0
+#define ARENA_CUP_TRET 0
+#define ARENA_CUP_MERCURY 1
+#define ARENA_CUP_MOGALL 2
+#define ARENA_CUP_ALTIN 3
+#define ARENA_CUP_TOLBI 4
+#define ARENA_CUP_LUNPA 5
+#define ARENA_CUP_LIGHTHOUSE 6
+#define ARENA_CUP_BOSS_RUSH 7
+#define ARENA_CUP_CROSSBONE 8
+#define ARENA_CUP_SIDE 0x01  /* beside the line: not counted in progress */
+#define ARENA_CUP_HEALS 0x02 /* the party is healed after each win */
+#define ARENA_REWARD_ITEM 0
+#define ARENA_REWARD_DJINN 1
+
+#include "battle/formations.h"
+
+/// One round: win number n of a cup fights round n; its enemies are levelled to targetLevel.
+struct ArenaTeam {
+  u8 targetLevel;
+  struct Formation formation;
+};
+
+struct ArenaCupTeams {
+  const struct ArenaTeam *rounds;
+  s32 count;
+};
+extern const struct ArenaCupTeams gArenaCupTeams[];
+
+/// Given the first time round `afterRound` (1-based) is won. `flag` is the
+/// bit that says it was given; `value` the Djinni (element * 7 + n); `item`
+/// the item id; `message` the message said for a Djinni.
+struct ArenaCupReward {
+  u8 afterRound;
+  u8 kind;
+  u8 flag;
+  u8 value;
+  u16 item;
+  u16 message;
+};
+
+struct ArenaCupInfo {
+  u8 roundCount;
+  u8 flags;
+  u8 requires; /* main cups cleared before it opens */
+  u8 raiseTo;   /* party level at the first clear, 0 for none */
+  u8 rewardCount;
+  u8 pad[3];
+  const struct ArenaCupReward *rewards;
+  u16 confirmMsg;
+  u16 clearedMsg;
+  u16 firstMsg;
+  u16 pad2;
+};
+
+extern const struct ArenaCupInfo gArenaCupInfo[ARENA_CUP_COUNT];
+/// Item shop rows (weapons, armor, supplies) by cups cleared, 0 to ARENA_MAIN_CUPS.
+extern const u8 gArenaShopRows[ARENA_MAIN_CUPS + 1][3];
+extern const u8 gArenaCrossboneRows[3];
+
+#define MSG_ARENA_CUP_NAME 10777
+
+#endif
