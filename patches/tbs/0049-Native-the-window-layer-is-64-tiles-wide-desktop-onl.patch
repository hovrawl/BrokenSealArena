--- a/games/tbs/include/window/window.h
+++ b/games/tbs/include/window/window.h
@@ -116,10 +116,27 @@ enum { WINDOW_SPRITE_COUNT = 64 };
 /// (gFont_KanjiGlyphs).
 #define KANJI_FIRST_CODE (TEXT_LAST_FONT_CODE + 1)
 
+#ifdef NATIVE
+// The desktop build's screen can be wider than 32 tiles, so the windows' map
+// is 64 tiles wide there (port/include/native/wide_map.h).
+#include "native/wide_map.h"
+#define WINDOW_MAP_WIDTH NATIVE_WIDE_MAP_WIDTH
+#define WINDOW_MAP_ROW_SHIFT 6
+#define WINDOW_TILEMAP_VRAM NATIVE_WIDE_MAP(4)
+#else
+/// The windows' tilemap's width in tiles: a row's entries.
+#define WINDOW_MAP_WIDTH BG_SCREEN_WIDTH
+#define WINDOW_MAP_ROW_SHIFT 5 ///< log2 of WINDOW_MAP_WIDTH
+/// The UI tilemap in VRAM (BG screen block 4), which WindowSystem_UploadTilemap
+/// copies the state block's tilemap to.
+#define WINDOW_TILEMAP_VRAM ((u8 *)0x06002000)
+#endif
+
 /// The window system's state: the windows' tilemap, the windows, the three text
 /// messages, the 64 window sprites, and the decoded message and its arguments.
 struct WindowState {
-  u16 tilemap[640]; ///< the windows' BG tilemap, 32 by 20 tiles
+  /// the windows' BG tilemap, 32 by 20 tiles (64 by 20 natively)
+  u16 tilemap[WINDOW_MAP_WIDTH * DISPLAY_TILE_HEIGHT];
   struct Window windows[WINDOW_COUNT]; ///< 12 in Japanese, 8 in the others
   struct Message messages[3]; ///< the messages, a NULL window when free
   struct WindowSprite sprites[WINDOW_SPRITE_COUNT];
@@ -222,9 +239,6 @@ enum {
