From 2c39358c1d7b71a2b1f45c2d0690aeae946e2fc3 Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Sat, 28 Nov 2026 09:54:53 +1100
Subject: [PATCH] Battle: taller list rows in the touch layout

The battle Psynergy, Item, Djinn and Summon lists take their row numbers
from layout values (arena/battle_touch.h): BATTLE_LIST_ROWS is a page's
rows, with BATTLE_LIST_MAX_ROWS for the arrays. On the GBA and in the
classic layout they are the old 16-pixel rows, and the ROM is unchanged.
With the touch layout's 24-pixel rows a list shows three rows of three
tiles a page (two for Summon), text and icons centred and the highlight
over the whole row.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 games/tbs/include/arena/battle_touch.h        | 55 +++++++++++++++++--
 games/tbs/include/window/menu_list.h          |  5 +-
 .../src/window/screens_battle_djinn_menu.c    | 20 +++----
 .../tbs/src/window/screens_battle_item_menu.c | 19 +++----
 .../src/window/screens_battle_psynergy_menu.c | 35 ++++++------
 .../src/window/screens_battle_summon_menu.c   | 29 +++++-----
 6 files changed, 107 insertions(+), 56 deletions(-)

diff --git a/games/tbs/include/arena/battle_touch.h b/games/tbs/include/arena/battle_touch.h
index 9890f26c50..e820edfc50 100644
--- a/games/tbs/include/arena/battle_touch.h
+++ b/games/tbs/include/arena/battle_touch.h
@@ -20,6 +20,50 @@
 #define BATTLE_BACK_ROW_X 0
 #define BATTLE_BACK_ROW_Y 14
 
+/// The battle lists' rows (Psynergy, Djinn, Item, Summon): on the GBA and in
+/// the classic layout BATTLE_LIST_ROWS rows of two tiles (16 pixels), text on
+/// a row's first tile row; in the touch layout three rows of three tiles (24
+/// pixels, UI_ROW_HEIGHT's default) a page, text and the tile icons on a row's
+/// middle tile row, so they sit centred, and the window as tall as before.
+/// Constants on the GBA, so its code is unchanged.
+/// The tall rows go with the touch layout's row height (--ui-size): 24 or
+/// more gives them; 16 keeps the GBA's.
+#define BATTLE_LIST_TALL (UI_TOUCH_LAYOUT && UI_ROW_HEIGHT >= 24)
+#define BATTLE_LIST_PAGE_ROWS (BATTLE_LIST_TALL ? 3 : BATTLE_LIST_MAX_ROWS)
+#define BATTLE_LIST_ROW_TILES (BATTLE_LIST_TALL ? 3 : 2)
+#define BATTLE_LIST_ROW_HEIGHT (BATTLE_LIST_ROW_TILES * 8)
+/// The tile row, within a row, of its text and tile icons.
+#define BATTLE_LIST_TEXT_TILE (BATTLE_LIST_TALL ? 1 : 0)
+/// Row `row`'s text tile row and pixel y, from the window's interior.
+#define BATTLE_LIST_TILE_Y(row)                                                \
+  ((row) * BATTLE_LIST_ROW_TILES + BATTLE_LIST_TEXT_TILE)
+#define BATTLE_LIST_TEXT_Y(row) (BATTLE_LIST_TILE_Y(row) * 8)
+/// A list window's height in tiles for `rows` rows. The GBA's last row
+/// reaches into the bottom border (its text is on the first of its two tile
+/// rows); a 24-pixel row is kept inside, so its highlight bar is too.
+#define BATTLE_LIST_WINDOW_HEIGHT(rows)                                        \
+  ((rows) * BATTLE_LIST_ROW_TILES + (BATTLE_LIST_TALL ? 2 : 1))
+/// The highlight bar's height in tiles: the text's tile row on the GBA, the
+/// whole row in the touch layout.
+#define BATTLE_LIST_HIGHLIGHT_TILES (BATTLE_LIST_TALL ? 3 : 1)
+/// Row `row`'s highlight bar (its top tile row on screen), and the bar drawn
+/// in `palette` (HIGHLIGHT_PALETTE to light it, WINDOW_PALETTE to clear it).
+#define BATTLE_LIST_HIGHLIGHT_Y(window, row)                                   \
+  ((window)->y + (row) * BATTLE_LIST_ROW_TILES + 1)
+#define BATTLE_LIST_HIGHLIGHT(window, row, palette)                            \
+  Window_HighlightRect((window)->x + 1,                                        \
+                       BATTLE_LIST_HIGHLIGHT_Y(window, row),                   \
+                       (window)->width - 2, BATTLE_LIST_HIGHLIGHT_TILES,       \
+                       palette)
+/// The pointing hand beside row `row` (MENU_PLACE_CURSOR, by these rows).
+#define BATTLE_LIST_PLACE_CURSOR(position, window, row, margin, sprite)        \
+  do {                                                                         \
+    (position).x = (window)->x * 8 - (margin);                                 \
+    (position).y = (BATTLE_LIST_TILE_Y(row) + (window)->y) * 8 + 20;           \
+    ((u32 *)(sprite))[1] = OBJ_SIZE_16X16;                                     \
+    ((u32 *)(sprite))[2] = 0;                                                  \
+  } while (0)
+
 #ifdef NATIVE
 #include "native/touch.h"
 #include "arena/arena_touch.h"
@@ -47,10 +91,10 @@ static inline s32 BattleTouch_PickCell(s32 left, s32 top, s32 width, s32 height,
   return 1;
 }
 
-/// The battle lists (`pageRows` rows of 16 pixels in `window`, the page
-/// arrows on its top edge): a tap on a row selects it or, on the chosen row,
-/// presses A (gKeysPressed); a tap on a page arrow presses Left or Right
-/// (gKeysRepeat). Call before the menu reads the keys.
+/// The battle lists (`pageRows` rows of BATTLE_LIST_ROW_HEIGHT in `window`,
+/// the page arrows on its top edge): a tap on a row selects it or, on the
+/// chosen row, presses A (gKeysPressed); a tap on a page arrow presses Left or
+/// Right (gKeysRepeat). Call before the menu reads the keys.
 static inline void BattleTouch_List(struct Window *window, s32 pageRows,
                                     s32 firstEntry, s32 count, s32 *selectedRow,
                                     s32 *preferredRow) {
@@ -77,7 +121,8 @@ static inline void BattleTouch_List(struct Window *window, s32 pageRows,
     }
   }
   if (BattleTouch_PickCell(window->x * 8 + 8, window->y * 8 + 8,
-                           (window->width - 2) * 8, 16, 1, rows, &row, &keys)) {
+                           (window->width - 2) * 8, BATTLE_LIST_ROW_HEIGHT, 1,
+                           rows, &row, &keys)) {
     *selectedRow = row;
     *preferredRow = row;
   }
