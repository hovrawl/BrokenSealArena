From 1461ee0ce79366f62dca5d1cbb78e272ca17e0b2 Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Fri, 30 Oct 2026 11:25:51 +1100
Subject: [PATCH] Arena: animated Djinni figures in the Djinn picker and shop

The Djinn lists mark each Djinni with a small animated figure of its element
(the field Djinni sprites 90 to 93, as the Djinn menu shows them) instead of
the element icon tile. The picker panel and the purchase grid create one sprite
per visible Djinni, place it every frame at 0.69 scale
(Render_ApplyProjectedPlacement) and destroy them on a page or member change.
A figure that cannot be made falls back to the icon tile.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/scene/battle_arena.c        | 80 +++++++++++++++++---
 games/tbs/src/scene/import/battle_arena.s |  3 +
 games/tbs/src/shop/shop/item_picker.c     | 92 +++++++++++++++++++----
 games/tbs/src/system/overlay/imports.inc  |  3 +
 4 files changed, 153 insertions(+), 25 deletions(-)

diff --git a/games/tbs/src/scene/battle_arena.c b/games/tbs/src/scene/battle_arena.c
index 5400394ba8..a00d7d4198 100644
--- a/games/tbs/src/scene/battle_arena.c
+++ b/games/tbs/src/scene/battle_arena.c
@@ -10,6 +10,7 @@
 #include "djinn_ids.h"
 #include "module/shop/shop.h"
 #include "render_input.h"
+#include "sprite.h"
 #include "module/scene/battle_arena.h"
 #include "module/field/field_sequence.h"
 #include "module/field/event_commands.h"
@@ -1375,18 +1376,49 @@ static s32 Training_GridCount(s32 kind) {
                                   : TRAINING_PSYNERGY_COUNT;
 }
 
-/// Draws entry `entry`'s icon and name with its cell at (x, y).
+/// How big a Djinni figure is drawn, 16.16: the Djinn menu shows them at full
+/// size (0x10000).
+#define TRAINING_FIGURE_SCALE 0xb000
+
+/// Places a Djinni figure so it stands at screen (x, y), the way the Djinn menu
+/// places its figures (DjinnFigures_UpdateAllPositions). Called every frame a
+/// figure shows.
+static void Training_PlaceFigure(struct Sprite *figure, s32 x, s32 y) {
+  struct SpriteScale scale;
+  struct SpritePlacement placement;
+  u32 vertical = 0x01e20000u;
+
+  figure->image.priority = 0;
+  scale.x = TRAINING_FIGURE_SCALE;
+  scale.y = TRAINING_FIGURE_SCALE;
+  placement.x = x << 16;
+  placement.height = vertical;
+  placement.y = (y << 16) + vertical;
+  placement.groundHeight = 0;
+  Render_ApplyProjectedPlacement(figure, &placement, &scale, FACING_SOUTH);
+}
+
+/// Where the figure of grid cell `cell` stands, in screen pixels: at the
+/// icon's place in the cell, the grid's window starting at (8, 8).
+#define TRAINING_CELL_FIGURE_X(cell)                                           \
+  (((cell) % GRID_COLUMNS) * GRID_CELL_WIDTH + 24)
+#define TRAINING_CELL_FIGURE_Y(cell)                                           \
+  (GRID_TOP + ((cell) / GRID_COLUMNS) * GRID_CELL_HEIGHT + 23)
+
+/// Draws entry `entry`'s icon and name with its cell at (x, y). A Djinni's icon
+/// is an animated figure of its element, `figure`, which the screen places each
+/// frame; with none, the element's icon tile stands in.
 static void Training_GridDrawCell(struct Window *window, s32 kind, s32 entry,
-                                  s32 x, s32 y) {
+                                  s32 x, s32 y, struct Sprite *figure) {
   if (kind == TRAIN_GRID_DJINN) {
     s32 element = entry / TRAINING_DJINN_PER_ELEMENT;
     s32 index = entry % TRAINING_DJINN_PER_ELEMENT;
 
-    // The Djinn lists mark a Djinni with its element's icon tile.
-    Window_SetTilemapEntry(window, TRAINING_ELEMENT_TILE + element, x / 8,
-                           y / 8, 0);
+    if (figure == 0)
+      Window_SetTilemapEntry(window, TRAINING_ELEMENT_TILE + element, x / 8,
+                             y / 8, 0);
     Text_DrawMessageAsTiles(MsgDjinnName + element * DJINN_PER_ELEMENT + index,
-                            window, x + 12, y);
+                            window, x + 20, y + 4);
   } else {
     s32 id = gTraining_PsynergyShop[entry].id;
     struct WindowSprite *icon =
@@ -1439,22 +1471,43 @@ static s32 Training_GridBuy(s32 kind, s32 unitId, s32 entry) {
 
 /// The purchase screen for Psynergy and for Djinn: icons and names in columns,
 /// rows and pages, one character's. The D-pad moves (Left and Right by one,
-/// Up and Down by a row), L and R turn the page, A buys, B leaves.
+/// Up and Down by a row), L and R turn the page, A buys, B leaves. The Djinn
+/// icons are animated figures, made when the page changes and placed every
+/// frame.
 static void Training_RunGrid(s32 unitId, s32 kind) {
   struct Window *window = Training_OpenScreen();
+  struct Sprite *figures[GRID_PAGE];
   s32 count = Training_GridCount(kind);
   s32 pages = (count + GRID_PAGE - 1) / GRID_PAGE;
   s32 cursor = 0;
   s32 redraw = 1;
   s32 notice = 0;
+  s32 figuresPage = -1;
+  s32 i;
 
+  for (i = 0; i < GRID_PAGE; i++)
+    figures[i] = 0;
   for (;;) {
     if (redraw) {
       s32 first = (cursor / GRID_PAGE) * GRID_PAGE;
-      s32 i;
 
       // Clears the window and the sprites of the last draw.
       WindowSprite_PrepareForRedraw(window);
+      if (kind == TRAIN_GRID_DJINN && figuresPage != cursor / GRID_PAGE) {
+        figuresPage = cursor / GRID_PAGE;
+        for (i = 0; i < GRID_PAGE; i++) {
+          if (figures[i] != 0)
+            Sprite_Destroy(figures[i]);
+          figures[i] = 0;
+          if (first + i < count) {
+            figures[i] =
+                Sprite_Create(VENUS_DJINNI + (first + i) /
+                                                 TRAINING_DJINN_PER_ELEMENT);
+            if (figures[i] != 0)
+              Sprite_StartAnimation(figures[i], 2);
+          }
+        }
+      }
       Training_DrawHeader(window, unitId);
       for (i = 0; i < GRID_PAGE && first + i < count; i++) {
         s32 x = (i % GRID_COLUMNS) * GRID_CELL_WIDTH;
@@ -1462,7 +1515,7 @@ static void Training_RunGrid(s32 unitId, s32 kind) {
 
         if (first + i == cursor)
           Text_DrawStringInWindow(gTraining_Cursor, window, x, y + 4);
-        Training_GridDrawCell(window, kind, first + i, x + 8, y);
+        Training_GridDrawCell(window, kind, first + i, x + 8, y, figures[i]);
       }
       if (notice != 0)
         Text_DrawMessageAsTiles(notice, window, 0, GRID_FOOTER_Y);
@@ -1480,6 +1533,11 @@ static void Training_RunGrid(s32 unitId, s32 kind) {
       redraw = 0;
     }
     wait(1);
+    for (i = 0; i < GRID_PAGE; i++) {
+      if (figures[i] != 0)
+        Training_PlaceFigure(figures[i], TRAINING_CELL_FIGURE_X(i),
+                             TRAINING_CELL_FIGURE_Y(i));
+    }
     if (gKeysRepeat & KEY_B)
       break;
     if (notice != 0) {
@@ -1513,6 +1571,10 @@ static void Training_RunGrid(s32 unitId, s32 kind) {
       redraw = 1;
     }
   }
+  for (i = 0; i < GRID_PAGE; i++) {
+    if (figures[i] != 0)
+      Sprite_Destroy(figures[i]);
+  }
   Window_Close(window, 2);
 }
 
diff --git a/games/tbs/src/scene/import/battle_arena.s b/games/tbs/src/scene/import/battle_arena.s
