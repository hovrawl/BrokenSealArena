@@ -0,0 +1,81 @@
+/// @file
+/// Arena romhack: New Game skips the prologue and enters the Battle Arena with
+/// a ready-made level 30 party and 1500 coins to train with.
+
+#include "scene_ids.h"
+#include "module/scene/file_screen.h"
+#include "module/field/field_sequence.h"
+#include "module/field/event_commands.h"
+#include "module/game/game.h"
+#include "module/window/window.h"
+#include "module/window/screens.h"
+#include "module/system/system.h"
+#include "battle.h"
+#include "input.h"
+#include "debug.h"
+#include "field.h"
+#include "game.h"
+#include "graphics.h"
+#include "menu.h"
+#include "types.h"
+#include "edition.h"
+#include "far_call.h"
+#include "sound.h"
+#include "system.h"
+#include "battle_sprite_id.h"
+#include "heap_slots.h"
+#include "edition.h"
+#include "tbs_edition.h"
+#include "text_font.h"
+#include "types.h"
+#include "dma.h"
+#include "ram_buffer.h"
+#include "event.h"
+#include "system_call.h"
+#include "resource_ids.h"
+#include "io_write_queue.h"
+#include "io_reg.h"
+#include "scene_tables.h"
+#include "serial.h"
+#include "heap_release.h"
+#include "window.h"
+#include "item.h"
+#include "main_routine_work.h"
+#include "text/msg_ids.h"
+#include "sounds.h"
+#include "sound_driver_symbols.h"
+#include "frame.h"
+#include "map_grid_scroll.h"
+#include "flags.h"
+#include "title.h"
+#include "arena_config.h"
+#include "module/arena.h"
+
+#if ARENA_BOOT
+void ArenaBoot_NewGame(void) {
+  // "New Game" skips the prologue and enters the Battle Arena with a
+  // ready-made level 30 party and 1500 coins to train with.
+  gMainRoutineWork.coins = 1500;
+  Party_AddMember(GARET);
+  Party_AddMember(MIA);
+  Party_AddMember(IVAN);
+  Unit_LevelUpTo(ISAAC, 30);
+  Unit_LevelUpTo(GARET, 30);
+  Unit_LevelUpTo(MIA, 30);
+  Unit_LevelUpTo(IVAN, 30);
+  Unit_Calculate(ISAAC);
+  Unit_Calculate(GARET);
+  Unit_Calculate(MIA);
+  Unit_Calculate(IVAN);
+  // Where Continue restarts a file saved by another build of the game.
+  gMainRoutineWork.restartScene = (s32)&SceneId_BattleArena;
+  gMainRoutineWork.restartEntrance = BATTLE_ARENA_FROM_FILE_SCREEN;
+  gMainRoutineWork.leaderActorId = 0;
+  GameFlag_Clear(FLAG_KEEP_PARTY_POSITION);
+  GameFlag_Clear(FLAG_MENU_OPEN);
+  GameFlag_Set(FLAG_IN_BATTLE_ARENA);
+  gSleepDisabled = 1;
+  Event_SetDestination((s32)&SceneId_BattleArena,
+                       BATTLE_ARENA_FROM_FILE_SCREEN);
+}
+#endif
