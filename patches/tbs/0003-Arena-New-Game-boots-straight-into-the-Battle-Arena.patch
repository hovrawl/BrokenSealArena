From 1c15378e5aec4e92347ca6ac216d15269ab04c6f Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Fri, 30 Oct 2026 14:51:28 +1100
Subject: [PATCH] Arena: New Game boots straight into the Battle Arena

In the file screen's New Game branch, the hook calls ArenaBoot_NewGame
(scene/arena_boot.c): Garet, Mia and Ivan join, all four are level 30, the
party has 1500 coins, FLAG_IN_BATTLE_ARENA is set and the game goes to
SceneId_BattleArena. No prologue, no save file read or written. Switch:
ARENA_BOOT. The new object is a row in objects.tsv and the overlay's import
list gains Unit_LevelUpTo and Unit_Calculate.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/scene/arena_boot.c  | 34 +++++++++++++++++++++++++++++++
 games/tbs/src/scene/file_screen.c |  9 ++++++++
 2 files changed, 43 insertions(+)
 create mode 100644 games/tbs/src/scene/arena_boot.c

diff --git a/games/tbs/src/scene/arena_boot.c b/games/tbs/src/scene/arena_boot.c
new file mode 100644
index 0000000000..8b7837e805
--- /dev/null
+++ b/games/tbs/src/scene/arena_boot.c
@@ -0,0 +1,34 @@
+/// @file
+/// Arena romhack: New Game skips the prologue and enters the Battle Arena with
+/// a ready-made level 30 party and 1500 coins to train with.
+
+// Part of file_screen.c (included at its end), which has the includes.
+
+#if ARENA_BOOT
+void ArenaBoot_NewGame(void) {
+  // "New Game" skips the prologue and enters the Battle Arena with a
+  // ready-made level 30 party and 1500 coins to train with.
+  gMainRoutineState.holdings.coins = 1500;
+  Party_AddMember(GARET);
+  Party_AddMember(MIA);
+  Party_AddMember(IVAN);
+  Unit_LevelUpTo(ISAAC, 30);
+  Unit_LevelUpTo(GARET, 30);
+  Unit_LevelUpTo(MIA, 30);
+  Unit_LevelUpTo(IVAN, 30);
+  Unit_Calculate(ISAAC);
+  Unit_Calculate(GARET);
+  Unit_Calculate(MIA);
+  Unit_Calculate(IVAN);
+  // Where Continue restarts a file saved by another build of the game.
+  gMainRoutineState.restartScene = SCENE_BATTLE_ARENA;
+  gMainRoutineState.restartEntrance = BATTLE_ARENA_FROM_FILE_SCREEN;
+  gMainRoutineState.leaderActorId = 0;
+  GameFlag_Clear(FLAG_KEEP_PARTY_POSITION);
+  GameFlag_Clear(FLAG_MENU_OPEN);
+  GameFlag_Set(FLAG_IN_BATTLE_ARENA);
+  gSleepDisabled = 1;
+  Event_SetDestination(SCENE_BATTLE_ARENA,
+                       BATTLE_ARENA_FROM_FILE_SCREEN);
+}
+#endif
diff --git a/games/tbs/src/scene/file_screen.c b/games/tbs/src/scene/file_screen.c
index 54e2b3f5ba..f58897fb88 100644
--- a/games/tbs/src/scene/file_screen.c
+++ b/games/tbs/src/scene/file_screen.c
@@ -6,6 +6,8 @@
 /// data to The Lost Age, by link cable or as a password. Two secret button
 /// codes on the screen (FileScreen_CheckButtonCodes) name more of the party.
 
+#include "arena_config.h"
+#include "arena/arena.h"
 #include "flags.h"
 #include "item_ids.h"
 #include "macros.h"
@@ -541,6 +543,11 @@ menu_top:;
     MainRoutineState_InitializeDefaults();
     WindowColor_Apply(gMainRoutineState.windowHue,
                       gMainRoutineState.windowBrightness);
+#if ARENA_BOOT
+    // Arena romhack: "New Game" enters the Battle Arena (scene/arena_boot.c).
+    ArenaBoot_NewGame();
+    goto leave;
+#endif
     limit = ISAAC + 1;
     index = ISAAC;
     for (;;) {
@@ -1416,3 +1423,5 @@ u16 gFileScreen_PasswordStackItems[PASSWORD_STACK_ITEMS] = {
     ITEM_SACRED_FEATHER, ITEM_OIL_DROP, ITEM_WEASELS_CLAW, ITEM_BRAMBLE_SEED, ITEM_CRYSTAL_POWDER,
 };
 // clang-format on
+
+#include "arena_boot.c"
-- 
