     MainRoutineWork_InitializeDefaults();
     WindowColor_Apply(gMainRoutineWork.windowColor[0],
                       gMainRoutineWork.windowColor[1]);
+#if ARENA_BOOT
+    // Arena romhack: "New Game" enters the Battle Arena (scene/arena_boot.c).
+    ArenaBoot_NewGame();
+    goto leave;
+#endif
     v5 = 1;
     v7 = 0;
     for (;;) {
