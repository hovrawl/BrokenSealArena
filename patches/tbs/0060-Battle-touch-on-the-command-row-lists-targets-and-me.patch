@@ -0,0 +1,125 @@
+#ifndef GUARD_ARENA_BATTLE_TOUCH_H
+#define GUARD_ARENA_BATTLE_TOUCH_H
+
+/// @file
+/// Touch for the battle menus in the desktop and phone builds (docs/UI.md):
+/// the command row, the Psynergy, Djinn and item lists, the targets, and a
+/// Back button while a menu is open. Each turns a tap into the keys the menu
+/// already reads, so the menus' own code runs unchanged: a tap on another
+/// choice moves there, a tap on the chosen one presses A. Only in the touch
+/// layout (--ui touch); the GBA build and --ui classic have none of it.
+/// Included by the battle menu parts of screens.c.
+
+#include "arena/ui_kit.h"
+
+/// Where the battle menus put their Back button: the lists' at the left of
+/// their top row (the portrait has the bottom left); the command row's above
+/// its portrait.
+#define BATTLE_BACK_LIST_X 0
+#define BATTLE_BACK_LIST_Y 9
+#define BATTLE_BACK_ROW_X 0
+#define BATTLE_BACK_ROW_Y 14
+
+#ifdef NATIVE
+#include "native/touch.h"
+#include "arena/arena_touch.h"
+
+/// A grid of `count` cells, `columns` across, each `width` by `height` from
+/// (left, top) in screen pixels: a tap on another cell moves *selected there
+/// (with the cursor sound) and returns 1; a tap on *selected adds KEY_A to
+/// *keys.
+static inline s32 BattleTouch_PickCell(s32 left, s32 top, s32 width, s32 height,
+                                       s32 columns, s32 count, s32 *selected,
+                                       s32 *keys) {
+  s32 cell;
+
+  if (!UI_TOUCH_LAYOUT)
+    return 0;
+  cell = Touch_TappedUiCell(left, top, width, height, columns, count);
+  if (cell < 0)
+    return 0;
+  if (cell == *selected) {
+    *keys |= KEY_A;
+    return 0;
+  }
+  Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+  *selected = cell;
+  return 1;
+}
+
+/// The battle lists (`pageRows` rows of 16 pixels in `window`, the page
+/// arrows on its top edge): a tap on a row selects it or, on the chosen row,
+/// presses A (gKeysPressed); a tap on a page arrow presses Left or Right
+/// (gKeysRepeat). Call before the menu reads the keys.
+static inline void BattleTouch_List(struct Window *window, s32 pageRows,
+                                    s32 firstEntry, s32 count, s32 *selectedRow,
+                                    s32 *preferredRow) {
+  s32 rows = count - firstEntry;
+  s32 pages = (count + pageRows - 1) / pageRows;
+  s32 row = *selectedRow;
+  s32 keys = 0;
+
+  if (!UI_TOUCH_LAYOUT || count == 0)
+    return;
+  if (rows > pageRows)
+    rows = pageRows;
+  if (pages > 1) {
+    // The arrows sit on the border row, one tile each; taps reach 24 pixels.
+    if (WindowTouch_Cell(window, (window->width - pages - 3) * 8, -8, 8, 8, 1,
+                         1) == 0) {
+      gKeysRepeat |= KEY_LEFT;
+      return;
+    }
+    if (WindowTouch_Cell(window, (window->width - 2) * 8, -8, 8, 8, 1, 1) ==
+        0) {
+      gKeysRepeat |= KEY_RIGHT;
+      return;
+    }
+  }
+  if (BattleTouch_PickCell(window->x * 8 + 8, window->y * 8 + 8,
+                           (window->width - 2) * 8, 16, 1, rows, &row, &keys)) {
+    *selectedRow = row;
+    *preferredRow = row;
+  }
+  gKeysPressed |= keys;
+}
+
+/// A battle message waiting for the player (the bobbing arrow): a tap
+/// anywhere goes on, as A does. Returns KEY_A when tapped, for the caller to
+/// add to the keys it reads.
+static inline u32 BattleTouch_Advance(void) {
+  if (UI_TOUCH_LAYOUT && Touch_TappedRect(0, 0, 0x7fff, 0x7fff))
+    return KEY_A;
+  return 0;
+}
+
+/// The Back button of the battle menus: a small window with B Back at tile
+/// (x, y) whose tap holds B for a frame (Touch_SetBackZone). Returns 0 in the
+/// classic layout. Close with BattleTouch_CloseBack.
+static inline struct Window *BattleTouch_OpenBack(s32 x, s32 y) {
+  struct Window *button;
+
+  if (!UI_TOUCH_LAYOUT)
+    return 0;
+  button = Window_Create(x, y, 6, 3, WINDOW_FLAG_INSTANT);
+  Text_DrawMessageAsTiles(MsgArenaUiBack, button, 0, 0);
+  Touch_SetBackZone(x * 8, y * 8, 48, 24);
+  return button;
+}
+
+static inline void BattleTouch_CloseBack(struct Window *button) {
+  if (button == 0)
+    return;
+  Touch_SetBackZone(0, 0, 0, 0);
+  Window_Close(button, 1);
+}
+
+#else
+#define BattleTouch_Advance() 0
+#define BattleTouch_List(window, pageRows, firstEntry, count, selectedRow,     \
+                         preferredRow)
+#define BattleTouch_OpenBack(x, y) ((struct Window *)0)
+#define BattleTouch_CloseBack(button)
+#endif
+
+#endif
