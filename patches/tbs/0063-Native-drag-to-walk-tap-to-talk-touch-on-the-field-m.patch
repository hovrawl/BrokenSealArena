diff --git a/games/tbs/include/arena/field_touch.h b/games/tbs/include/arena/field_touch.h
new file mode 100644
index 0000000000..6c06c17048
--- /dev/null
+++ b/games/tbs/include/arena/field_touch.h
@@ -0,0 +1,68 @@
+#ifndef GUARD_ARENA_FIELD_TOUCH_H
+#define GUARD_ARENA_FIELD_TOUCH_H
+
+/// @file
+/// Touch in the field for the desktop and phone builds (native/touch.h):
+/// drag anywhere to walk (a virtual stick where the finger went down; far
+/// from its centre runs), tap near the middle of the screen, where the leader
+/// stands, to talk to or check what is in front (A), tap anywhere to move a
+/// message on, and hold a finger down to hurry its text, as a held button. Keys
+/// and the pad work as before; the GBA build has none of it (the macros below
+/// are empty there).
+
+#ifdef NATIVE
+#include "native/touch.h"
+
+/// The tap zone for A in the field: 96 by 96 pixels round the middle of the
+/// UI's 240 by 160 safe area, which the camera keeps on the leader.
+#define FIELD_TOUCH_ACT_X 72
+#define FIELD_TOUCH_ACT_Y 32
+#define FIELD_TOUCH_ACT_SIZE 96
+
+/// Player control's heading: a drag's way when one is steering (and, far
+/// from its centre, the run speed and animation), else `keyHeading`, the
+/// pad's. A statement expression, so the speed constants are
+/// field_player_control.c's.
+#define FIELD_TOUCH_STEER(actor, keyHeading, animation)                        \
+  ({                                                                           \
+    int touchHeading_, touchDistance_;                                         \
+    s32 heading_ = (keyHeading);                                               \
+    if (Touch_Drag(&touchHeading_, &touchDistance_)) {                         \
+      heading_ = touchHeading_;                                                \
+      if (touchDistance_ >= TOUCH_DRAG_RUN) {                                  \
+        (actor)->speedLimit = FIELD_RUN_SPEED;                                 \
+        (actor)->acceleration = FIELD_ACCELERATION;                            \
+        (animation) = ANIM_LEADER_RUN;                                         \
+      }                                                                        \
+    }                                                                          \
+    heading_;                                                                  \
+  })
+
+/// A tap round the leader adds A to this frame's keys.
+static inline void FieldTouch_AddKeys(void) {
+  if (Touch_TappedUiRect(FIELD_TOUCH_ACT_X, FIELD_TOUCH_ACT_Y,
+                         FIELD_TOUCH_ACT_SIZE, FIELD_TOUCH_ACT_SIZE))
+    gKeysPressed |= KEY_A;
+}
+
+/// 1 while a finger is down: as a held button, it hurries a message's text
+/// and its pauses.
+static inline int MessageTouch_Held(void) {
+  int x, y;
+
+  return Touch_Held(&x, &y);
+}
+
+/// A tap anywhere moves a message on, as A does.
+static inline u16 MessageTouch_Keys(void) {
+  return Touch_TappedRect(0, 0, 0x7fff, 0x7fff) ? KEY_A : 0;
+}
+
+#else
+#define FIELD_TOUCH_STEER(actor, keyHeading, animation) (keyHeading)
+#define FieldTouch_AddKeys() ((void)0)
+#define MessageTouch_Keys() 0
+#define MessageTouch_Held() 0
+#endif
+
+#endif
