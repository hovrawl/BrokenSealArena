@@ -0,0 +1,86 @@
+#ifndef GUARD_ARENA_MENU_TOUCH_H
+#define GUARD_ARENA_MENU_TOUCH_H
+
+/// @file
+/// Touch for the field menu (Select: Psynergy, Item, Status) in the desktop
+/// and phone builds, as the other menus take it (arena_touch.h): a tap on
+/// another choice moves there, a tap on the chosen one presses A, so the
+/// menu's own key code runs. The GBA build has none of it.
+
+/// The party row: Menu_CreatePartyFigures(window, 2, 2, 8, 0) in the 13 by 5
+/// window at the top left (MenuCursor_Create), a figure every 24 pixels with
+/// its feet 32 pixels down, centred 16 pixels in. Each takes taps over 24 by
+/// 36 pixels.
+#define MENU_TOUCH_FIGURES_LEFT 4
+#define MENU_TOUCH_FIGURES_TOP 0
+#define MENU_TOUCH_FIGURE_WIDTH 24
+#define MENU_TOUCH_FIGURE_HEIGHT 36
+
+/// The Psynergy and item lists (listWindow at 13, 3): a row every 16 pixels,
+/// level with the hand, across the window's interior.
+#define MENU_TOUCH_LIST_LEFT (14 * 8)
+#define MENU_TOUCH_LIST_TOP 36
+#define MENU_TOUCH_LIST_WIDTH (15 * 8)
+#define MENU_TOUCH_LIST_ROWS(list)                                             \
+  ((list).entryCount - (list).page * LIST_PAGE_SIZE > LIST_PAGE_SIZE           \
+       ? LIST_PAGE_SIZE                                                        \
+       : (list).entryCount - (list).page * LIST_PAGE_SIZE)
+/// A tap on a row of a PagedList's page (moves list.row, or presses A).
+#define MENU_TOUCH_LIST(list)                                                  \
+  MenuTouch_PickCell(MENU_TOUCH_LIST_LEFT, MENU_TOUCH_LIST_TOP,                \
+                     MENU_TOUCH_LIST_WIDTH, 16, 1, MENU_TOUCH_LIST_ROWS(list), \
+                     &(list).row)
+
+/// The item commands (Use, Equip, Details over Give, Remove, Drop): rows 8
+/// pixels apart (the text at 32 and 40), columns taken as 46 pixels from 96.
+/// Small, as on the GBA; Touch_TappedUiCell widens the outer edges.
+#define MENU_TOUCH_COMMANDS_LEFT 96
+#define MENU_TOUCH_COMMANDS_TOP 32
+#define MENU_TOUCH_COMMAND_WIDTH 46
+#define MENU_TOUCH_COMMAND_HEIGHT 8
+
+#ifdef NATIVE
+#include "native/touch.h"
+
+/// A tap on a cell of a grid (screen pixels in the safe area): on another
+/// cell, moves *selection there (with the cursor sound) and returns 1, for
+/// the caller to redraw; on the selected one, presses A (gKeysPressed) and
+/// returns 0.
+static inline s32 MenuTouch_PickCell(s32 left, s32 top, s32 width, s32 height,
+                                     s32 columns, s32 count, s32 *selection) {
+  s32 cell = Touch_TappedUiCell(left, top, width, height, columns, count);
+
+  if (cell < 0)
+    return 0;
+  if (cell == *selection) {
+    gKeysPressed |= KEY_A;
+    return 0;
+  }
+  Sound_PlayFar(SE_MENU_CURSOR_MOVE);
+  *selection = cell;
+  return 1;
+}
+
+/// As MenuTouch_PickCell, for a figure of the party row.
+static inline s32 MenuTouch_PickMember(s32 count, s32 *selection) {
+  s32 index;
+
+  if (count <= 0)
+    return 0;
+  index = (*selection % count + count) % count;
+  if (!MenuTouch_PickCell(MENU_TOUCH_FIGURES_LEFT, MENU_TOUCH_FIGURES_TOP,
+                          MENU_TOUCH_FIGURE_WIDTH, MENU_TOUCH_FIGURE_HEIGHT,
+                          count, count, &index))
+    return 0;
+  *selection = index;
+  return 1;
+}
+
+#else
+#define MenuTouch_PickCell(left, top, width, height, columns, count,           \
+                           selection)                                          \
+  0
+#define MenuTouch_PickMember(count, selection) 0
+#endif
+
+#endif
