From 6e520b342f38a1ffc712559c2643282148e23776 Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Fri, 30 Oct 2026 11:51:56 +1100
Subject: [PATCH] Arena: centre the names on the icons and figures in the
 picker panels

Tile text snaps to an eight pixel row, so a name drawn at y plus four sat at the
top of its sixteen pixel row. The names now go on the row's lower half and the
Psynergy icons and Djinn figures four pixels down, as the Status screen does;
the panel is one tile taller to hold the last row.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/shop/shop/item_picker.c | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/games/tbs/src/shop/shop/item_picker.c b/games/tbs/src/shop/shop/item_picker.c
index 21632534d7..9d99327612 100644
--- a/games/tbs/src/shop/shop/item_picker.c
+++ b/games/tbs/src/shop/shop/item_picker.c
@@ -175,14 +175,14 @@ static s32 ArenaPicker_DrawDjinn(struct Window *window, s32 unitId,
         Sprite_StartAnimationFar(figure, 2);
         figures[shown] = figure;
         positions[shown * 2] = 8 + x + 8;
-        positions[shown * 2 + 1] = 8 + y + 15;
+        positions[shown * 2 + 1] = 8 + y + 19;
       } else {
         Window_SetTilemapEntryFar(window, ARENA_ELEMENT_TILE + element, x / 8,
-                                  y / 8, 0);
+                                  (y + 8) / 8, 0);
       }
       Text_DrawMessageAsTilesFar(MsgDjinnName + element * DJINN_PER_ELEMENT +
                                      index,
-                                 window, x + 20, y + 4);
+                                 window, x + 20, y + 8);
       shown++;
     }
   }
@@ -211,11 +211,13 @@ static void ArenaPicker_DrawPsynergy(struct Window *window, s32 unitId) {
     x = (shown % ARENA_PANEL_PSYNERGY_COLUMNS) *
         ARENA_PANEL_PSYNERGY_COLUMN_WIDTH;
     y = (shown / ARENA_PANEL_PSYNERGY_COLUMNS) * 16;
+    // The name is on a tile row, so it goes on the lower half of the row's 16
+    // pixels and the icon four pixels down, which centres them on each other.
     icon = WindowSprite_CreateFromResourceFar(ICON_KIND_ABILITY, id, window,
-                                              x + 4, y);
+                                              x + 4, y + 4);
     if (icon != 0)
       icon->sentinel = 252;
-    Text_DrawMessageAsTilesFar(MsgAbilityName + id, window, x + 24, y + 4);
+    Text_DrawMessageAsTilesFar(MsgAbilityName + id, window, x + 24, y + 8);
     shown++;
   }
   if (shown == 0)
@@ -290,7 +292,7 @@ s32 ItemPicker_ChooseMember(s32 mode) {
         Window_CreateFar(0, 9, SHOP_MONEY_WINDOW_WIDTH, 4, WINDOW_FLAG_INSTANT);
     shop->itemWindow = Window_CreateFar(16, 12, 14, 8, WINDOW_FLAG_INSTANT);
   } else {
-    shop->itemWindow = Window_CreateFar(0, 0, 30, 10, WINDOW_FLAG_INSTANT);
+    shop->itemWindow = Window_CreateFar(0, 0, 30, 11, WINDOW_FLAG_INSTANT);
     // The panels have no coins window; the counters show the coins.
     shop->moneyWindow = 0;
   }
-- 
