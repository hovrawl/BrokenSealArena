+#!/usr/bin/env python3
+"""Write the native build's overlay table: for each scene overlay, its
+resource number (OverlayId_NAME, from gamepak/resource_directory.s), its six
+entry points and the bounds of its data and BSS sections
+(port/tools/overlay_object.py names them).
+
+usage: overlay_table.py OUTPUT.c NAME...
+"""
+import sys
+
+ENTRY = ['Scene_Initialize', 'Scene_GetEntrances', 'Scene_GetExits',
+         'Scene_GetActorPlacements', 'Scene_GetTriggers', 'Scene_GetExitRegions']
+
+def main():
+    output, names = sys.argv[1], sys.argv[2:]
+    out = ['// Written by port/tools/overlay_table.py: do not edit.',
+           '#include "native/overlay.h"', '']
+    for n in names:
+        out.append(f'extern char OverlayId_{n}[];')
+        for e in ENTRY:
+            out.append(f'extern void {n}_{e}(void);')
+        for kind in ('data', 'bss'):
+            out.append(f'extern char __start_native_overlay_{kind}_{n}[] __attribute__((weak));')
+            out.append(f'extern char __stop_native_overlay_{kind}_{n}[] __attribute__((weak));')
+    out.append('')
+    out.append('const struct NativeOverlay gNativeOverlays[] = {')
+    for n in names:
+        entries = ', '.join(f'{n}_{e}' for e in ENTRY)
+        out.append(f'  {{"{n}", (unsigned)OverlayId_{n}, {{{entries}}},')
+        out.append(f'   __start_native_overlay_data_{n}, __stop_native_overlay_data_{n},')
+        out.append(f'   __start_native_overlay_bss_{n}, __stop_native_overlay_bss_{n}}},')
+    out.append('};')
+    out.append(f'const int gNativeOverlayCount = {len(names)};')
+    open(output, 'w').write('\n'.join(out) + '\n')
+
+main()
