+#!/usr/bin/env python3
+"""Give the game's RAM globals their GBA addresses in the native build.
+
+ewram.s, iwram.s and iwram_high.s reserve the game's globals with .space at
+fixed places. The native build maps EWRAM and IWRAM at their GBA addresses
+(port/src/native_memory.c), so it defines each name as an absolute symbol at
+the same address: code that reaches across a boundary by arithmetic, or a
+buffer by its fixed address, finds the same bytes.
+
+usage: ram_symbols.py OUTPUT.s EDITION_DEFINE FILE=BASE...
+"""
+import re, sys
+
+def walk(path, base, defines):
+    addr, out, stack = base, [], [True]
+    for raw in open(path):
+        line = raw.split('@')[0].strip()
+        if not line:
+            continue
+        m = re.match(r'\.(ifdef|ifndef)\s+(\w+)', line)
+        if m:
+            on = (m.group(2) in defines) == (m.group(1) == 'ifdef')
+            stack.append(stack[-1] and on); continue
+        if line == '.else':
+            stack[-1] = (not stack[-1]) and stack[-2]; continue
+        if line == '.endif':
+            stack.pop(); continue
+        if not stack[-1]:
+            continue
+        m = re.match(r'\.space\s+(\w+)', line)
+        if m:
+            addr += int(m.group(1), 0); continue
+        m = re.match(r'(\w+):$', line)
+        if m:
+            out.append((m.group(1), addr)); continue
+    return out
+
+def main():
+    output, define = sys.argv[1], sys.argv[2]
+    lines = ['@ Written by port/tools/ram_symbols.py: do not edit.'.replace('@', '#')]
+    for arg in sys.argv[3:]:
+        path, base = arg.split('=')
+        for name, addr in walk(path, int(base, 0), {define}):
+            lines += [f'\t.globl {name}', f'\t.set {name}, 0x{addr:08x}']
+    open(output, 'w').write('\n'.join(lines) + '\n')
+
+main()
