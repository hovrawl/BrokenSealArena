+++ b/port/include/native/native.h
@@ -0,0 +1,89 @@
+#ifndef NATIVE_NATIVE_H
+#define NATIVE_NATIVE_H
+
+/// @file
+/// The platform layer's shared header: the GBA's memory map as the native
+/// build lays it out, and the services the replacement routines and the
+/// display stand-in share. Port code includes this, not the game's headers.
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef int8_t s8;
+typedef uint8_t u8;
+typedef int16_t s16;
+typedef uint16_t u16;
+typedef int32_t s32;
+typedef uint32_t u32;
+typedef int64_t s64;
+typedef uint64_t u64;
+
+#if defined(TBS_EDITION_JA)
+#define EDITION_INTERNATIONAL 0
+#else
+#define EDITION_INTERNATIONAL 1
+#endif
+
+// The GBA regions, mapped at their own addresses (native_memory.c).
+#define EWRAM_BASE 0x02000000u
+#define EWRAM_SIZE 0x40000u
+#define IWRAM_BASE 0x03000000u
+#define IWRAM_SIZE 0x8000u
+#define IO_BASE 0x04000000u
+#define IO_SIZE 0x400u
+#define PALETTE_BASE 0x05000000u
+#define PALETTE_SIZE 0x400u
+#define VRAM_BASE 0x06000000u
+#define VRAM_SIZE 0x18000u
+#define OAM_BASE 0x07000000u
+#define OAM_SIZE 0x400u
+
+#define IO_REG16(offset) (*(volatile u16 *)(uintptr_t)(IO_BASE + (offset)))
+#define IO_REG32(offset) (*(volatile u32 *)(uintptr_t)(IO_BASE + (offset)))
+
+#define GBA_WIDTH 240
+#define GBA_HEIGHT 160
+
+/// Maps the regions; call before any game code runs.
+void Native_MapMemory(void);
+
+/// The frame step: runs the display to the next VBlank (rendering each line,
+/// with its HBlank DMA and interrupts), raises VBlank, presents the frame and
+/// reads input. ASM_BIOS_HALT and Stop come here.
+void Native_Halt(void);
+void Native_Stop(void);
+/// The three DMA registers written at once (Dma_Set).
+void Native_DmaStart(volatile void *channel, u32 source, u32 destination,
+                     u32 control);
+/// Restarts the game (the soft reset).
+void Native_SoftReset(void) __attribute__((noreturn));
+
+/// Whether `address` is native code (the start of a routine the game copies
+/// to RAM to run: a DMA from it writes a jump instead of bytes).
+int Native_IsCode(u32 address);
+
+/// The software display: draws line `y` of the current registers and VRAM
+/// into `line` (240 pixels, 0x00RRGGBB).
+void Ppu_RenderLine(int y, u32 *line);
+
+/// The platform (SDL or headless).
+int Platform_Init(int argc, char **argv);
+/// Shows a finished 240x160 frame and paces to 60 a second.
+void Platform_Present(const u32 *frame);
+/// The GBA's KEYINPUT bits, pressed = 1 (the game reads them inverted).
+u16 Platform_ReadKeys(void);
+/// Whether the player asked to quit.
+int Platform_ShouldQuit(void);
+void Platform_Shutdown(void);
+
+/// Debug output (stderr), and fatal errors.
+void Native_Log(const char *format, ...)
+    __attribute__((format(printf, 1, 2)));
+void Native_Fatal(const char *format, ...)
+    __attribute__((format(printf, 1, 2), noreturn));
+
+/// The frame counter the platform layer keeps (frames presented).
+extern u32 gNativeFrame;
+
+#endif
