diff --git a/port/src/native_system.c b/port/src/native_system.c
new file mode 100644
index 0000000..8bd6a9b
--- /dev/null
+++ b/port/src/native_system.c
@@ -0,0 +1,354 @@
+/// @file
+/// C for the System's hand-written ARM routines (src/system/*.s): the IWRAM
+/// arithmetic library, the trigonometry, the heap release, the BIOS calls the
+/// game makes, the interrupt tables and the resident-code symbols.
+///
+/// Each routine computes what the ARM computes, quirks included (the
+/// remainder's sign follows both operands, a divide by zero returns all ones),
+/// so the game behaves as on the cartridge.
+
+#include "native/native.h"
+
+// --- iwram_routines.s ------------------------------------------------------
+
+/// The 3x3 transform and translation every vector routine works through.
+s32 gCurrentMatrix[12] = {1 << 16, 0, 0, 0, 1 << 16, 0, 0, 0, 1 << 16, 0, 0, 0};
+
+static s32 MulFX(s32 left, s32 right) {
+  return (s32)(((s64)left * right) >> 16);
+}
+
+s32 IwramMulFX(s32 left, s32 right) { return MulFX(left, right); }
+s32 IwramMulFXReturnIp(s32 left, s32 right) { return MulFX(left, right); }
+
+/// The divide core: quotient bits from 31 down, as the restoring loop.
+static u32 DivideCore(u32 numerator, u32 denominator, u32 *remainder) {
+  u32 quotient = 0;
+  s32 shift;
+
+  for (shift = 31; shift >= 0; shift--) {
+    if ((numerator >> shift) >= denominator) {
+      quotient |= 1u << shift;
+      numerator -= denominator << shift;
+    }
+  }
+  if (remainder)
+    *remainder = numerator;
+  return quotient;
+}
+
+s32 IwramSignedDivide(s32 dividend, s32 divisor) {
+  u32 n = dividend < 0 ? -(u32)dividend : (u32)dividend;
+  u32 d = divisor < 0 ? -(u32)divisor : (u32)divisor;
+  u32 q = DivideCore(n, d, NULL);
+
+  return ((dividend ^ divisor) < 0) ? -(s32)q : (s32)q;
+}
+
+s32 IwramSignedRemainder(s32 dividend, s32 divisor) {
+  u32 n = dividend < 0 ? -(u32)dividend : (u32)dividend;
+  u32 d = divisor < 0 ? -(u32)divisor : (u32)divisor;
+  u32 r;
+
+  DivideCore(n, d, &r);
+  // The ARM negates by the sign of dividend ^ divisor.
+  return ((dividend ^ divisor) < 0) ? -(s32)r : (s32)r;
+}
+
+u32 IwramUnsignedDivide(u32 dividend, u32 divisor) {
+  return DivideCore(dividend, divisor, NULL);
+}
+
+u32 IwramUnsignedRemainder(u32 dividend, u32 divisor) {
+  u32 r;
+
+  DivideCore(dividend, divisor, &r);
+  return r;
+}
+
+/// value * 1.0 / divisor in 16.16, through a 2.30 reciprocal as the ARM does.
+s32 IwramDivFX(s32 divisor, s32 value) {
+  s32 reciprocal = IwramSignedDivide(0x40000000, divisor);
+  s64 product = (s64)value * reciprocal;
+
+  return (s32)(u32)((u64)product >> 14);
+}
+
+/// Fills size bytes, rounded down to words; returns the end address.
+s32 IwramFillWords(void *destination, s32 size, u32 value) {
+  u32 *p = destination;
+  u32 words = (u32)size >> 2;
+
+  while (words--)
+    *p++ = value;
+  return (s32)(uintptr_t)p;
+}
+
+s32 IwramClearWords(void *destination, s32 size) {
+  return IwramFillWords(destination, size, 0);
+}
+
+/// The integer square root, two result bits a step from the top.
+s32 IwramSqrt(s32 value) {
+  u32 n = (u32)value;
+  u32 root = 0;
+  u32 bit = 0x8000;
+
+  if (value < 0)
+    return 0;
+  do {
+    root += bit;
+    if (root * root > n)
+      root -= bit;
+    root += bit >> 1;
+    if (root * root > n)
+      root -= bit >> 1;
+    bit >>= 2;
+  } while (bit != 0);
+  return (s32)root;
+}
+
+/// Expands rows of 14 (international) bit flags into bytes of `value`, one
+/// row of 16 bytes per halfword: a glyph's bits into pixels.
+s32 IwramExpandBitRuns(const void *bits, void *destination, s32 value) {
+  const u16 *row = bits;
+  u8 *out = destination;
+  s32 rows = EDITION_INTERNATIONAL ? 14 : 12;
+  s32 i, k;
+
+  for (i = 0; i < rows; i++, out += 16) {
+    u32 flags = row[i] & ~3u;
+
+    for (k = 0; k < 14; k++)
+      if (flags & (0x8000u >> k))
+        out[k] = (u8)value;
+  }
+  return 0;
+}
+
+/// Transforms a 16.16 vector by gCurrentMatrix (row vector times matrix,
+/// plus the translation).
+s32 IwramTransformVector(const void *vector, s32 *result) {
+  const s32 *v = vector;
+  const s32 *m = gCurrentMatrix;
+  s32 x = v[0], y = v[1], z = v[2];
+  s32 out[3];
+  s32 j;
+
+  for (j = 0; j < 3; j++) {
+    s64 sum = (s64)x * m[j] + (s64)y * m[3 + j] + (s64)z * m[6 + j];
+
+    out[j] = (s32)(sum >> 16) + m[9 + j];
+  }
+  result[0] = out[0];
+  result[1] = out[1];
+  result[2] = out[2];
+  return 0;
+}
+
+/// gCurrentMatrix = matrix x gCurrentMatrix, translation included.
+void IwramMultiplyMatrix(const s32 *matrix) {
+  s32 *m = gCurrentMatrix;
+  s32 out[12];
+  s32 i, j;
+
+  for (i = 0; i < 4; i++) {
+    for (j = 0; j < 3; j++) {
+      s64 sum = (s64)matrix[i * 3] * m[j] + (s64)matrix[i * 3 + 1] * m[3 + j] +
+                (s64)matrix[i * 3 + 2] * m[6 + j];
+
+      out[i * 3 + j] = (s32)(sum >> 16);
+    }
+  }
+  for (j = 0; j < 3; j++)
+    out[9 + j] += m[9 + j];
+  memcpy(m, out, sizeof(out));
+}
+
+/// A sprite's codec 3 picture: literal bytes, bytes above 223 skip pixels,
+/// back-references into the literals. Returns null, or the stored picture
+/// when its packed size is 0.
+void *IwramDecompress(const void *source, void *destination) {
+  const u8 *src = source;
+  u8 *dst = destination;
+  u32 size = src[0] | (src[1] << 8);
+  const u8 *literals, *flags;
+
+  src += 2;
+  if (size == 0)
+    return (void *)src;
+  literals = src;
+  flags = src + size - 2;
+  for (;;) {
+    u32 bits = *flags++ | 0x100;
+
+    for (;;) {
+      u32 bit = bits & 1;
+
+      bits >>= 1;
+      if (bits == 0)
+        break; // the stop bit: reload
+      if (bit) {
+        u8 b = *src++;
+
+        if (b > 223)
+          dst += b - 223;
+        else
+          *dst++ = b;
+      } else {
+        u32 code = (flags[0] << 8) | flags[1];
+        const u8 *from;
+        s32 count;
+
+        flags += 2;
+        if (code == 0)
+          return NULL;
+        from = literals - (code & 0xfff);
+        count = code >> 12;
+        if (count == 0)
+          count = *flags++ + 16;
+        count += 1;
+        do {
+          u8 b = *from++;
+
+          if (b > 223)
+            dst += b - 223;
+          else
+            *dst++ = b;
+        } while (count-- > 0);
+      }
+    }
+  }
+}
+
+/// Copies size bytes, rounded down to words.
+s32 IwramCopyWords(void *destination, const void *source, s32 size) {
+  memmove(destination, source, (u32)size & ~3u);
+  return 0;
+}
+
+// --- inner_product.s ---------------------------------------------------------
+
+s32 RelocatedInnerProduct(s32 a, s32 b, s32 c, s32 d, s32 e, s32 f) {
+  s64 sum = (s64)a * b + (s64)c * d + (s64)e * f;
+
+  return (s32)(sum >> 16);
+}
+
+// --- trig.s ------------------------------------------------------------------
+
+extern const u16 Trig_SineTable[];
+
+/// The sine at a quadrant boundary: 0 or +-1.0.
+static s32 SinOnAxis(u32 angle) {
+  s32 value = ((angle >> 14) & 1) << 16;
+
+  return (angle & 0x8000) ? -value : value;
+}
+
+s32 Trig_SinOnAxis(s32 angle) { return SinOnAxis((u32)angle); }
+
+s32 Trig_Sin(s32 angle) {
+  u32 a = (u32)angle + 32;
+  u32 index = (a << 18) >> 24;
+  s32 value;
+
+  if (index == 0)
+    return SinOnAxis(a);
+  if (a & 0x4000)
+    index = 256 - index;
+  value = Trig_SineTable[index];
+  return (a & 0x8000) ? -value : value;
+}
+
+s32 Trig_Cos(s32 angle) { return Trig_Sin(angle + 0x4000); }
+
+// --- heap_release.s ----------------------------------------------------------
+
+extern u32 gHeapSlots[];
+
+/// Frees a heap slot's block: the block becomes its heap's head again.
+void HeapSlot_Release(s32 slot) {
+  u32 block = gHeapSlots[slot];
+
+  if ((block >> 22) == 0)
+    return;
+  gHeapSlots[slot] = 0;
+  gHeapSlots[((block >> 22) & 4) >> 2] = block;
+}
+
+/// Frees a block: its heap (EWRAM or IWRAM, by address) resumes from it.
+void Heap_Release(void *buffer) {
+  u32 block = (u32)(uintptr_t)buffer;
+
+  gHeapSlots[((block >> 22) & 4) >> 2] = block;
+}
+
+// --- bios.s ------------------------------------------------------------------
+
+/// The BIOS CpuSet: copies or fills (bit 24) halfwords or words (bit 26).
+void Bios_CpuSet(const void *source, void *destination, u32 control) {
+  u32 count = control & 0x1fffff;
+  int fill = (control >> 24) & 1;
+
+  if (control & (1 << 26)) {
+    const u32 *s = (const u32 *)((uintptr_t)source & ~3u);
+    u32 *d = (u32 *)((uintptr_t)destination & ~3u);
+    u32 value = *s;
+
+    while (count--)
+      *d++ = fill ? value : *s++;
+  } else {
+    const u16 *s = (const u16 *)((uintptr_t)source & ~1u);
+    u16 *d = (u16 *)((uintptr_t)destination & ~1u);
+    u16 value = *s;
+
+    while (count--)
+      *d++ = fill ? value : *s++;
+  }
+}
+
+void Bios_SoundBiasOff(void) {}
+void Bios_SoundBiasOn(void) {}
+
+// --- irq.s, irq_table.s, entry.s -----------------------------------------------
+
+typedef void (*InterruptHandler)(void);
+void Irq_Ignore(void);
+void Input_HandleKeyInterrupt(void);
+
+InterruptHandler gIrqHandlers[14];
+const u32 gDefaultIrqHandlers[14] = {
+    (u32)Irq_Ignore, (u32)Irq_Ignore, (u32)Irq_Ignore, (u32)Irq_Ignore,
+    (u32)Irq_Ignore, (u32)Irq_Ignore, (u32)Irq_Ignore, (u32)Irq_Ignore,
+    (u32)Irq_Ignore, (u32)Irq_Ignore, (u32)Irq_Ignore, (u32)Irq_Ignore,
+    (u32)Input_HandleKeyInterrupt, (u32)Irq_Ignore};
+
+/// The resident code's ROM image: nothing to copy natively, but the game
+/// copies its 5,120 bytes to IwramIrqMain (0x03000000) at power-on.
+const u8 IwramResident_Rom[5120];
+
+/// The word Battle_Playback hands to _call_via_r0: nothing natively.
+const u32 IwramIrqModeWord = 0;
+
+/// The cartridge entry point the soft reset jumps to.
+void Rom_Start(void) { Native_SoftReset(); }
+
+/// The sound reverb code slots the VBlank handler copies: unused natively.
+const u8 IwramSoundReverbCodes[8 * 256];
+u8 IwramSoundReverbCode[256];
+
+/// Calls `routine` with the first three arguments (r0 to r2).
+s32 _call_via_r3(s32 a, s32 b, s32 c, s32 (*routine)(s32, s32, s32)) {
+  return routine(a, b, c);
+}
+
+/// Dma_StopDma3's call of a word that is not a routine: nothing natively.
+void _call_via_r0(u32 routine) { (void)routine; }
+
+// --- iwram_entry.s, actor_update_far.s: far stubs ----------------------------
+
+s32 Trig_Atan(s32 z, s32 x);
+s32 Trig_AtanFarArm(s32 z, s32 x) { return Trig_Atan(z, x); }
+s32 Iwram_SqrtFarArm(s32 value) { return IwramSqrt(value); }
+s32 Iwram_DivFXFarArm(s32 divisor, s32 value) { return IwramDivFX(divisor, value); }
diff --git a/port/src/platform_headless.c b/port/src/platform_headless.c
new file mode 100644
index 0000000..10adf18
--- /dev/null
+++ b/port/src/platform_headless.c
@@ -0,0 +1,351 @@
+/// @file
+/// The headless platform: no window and no pacing. Input comes from a smoke
+/// script in the libmgba driver's format (scripts/smoke in the arena repo:
+/// wait, press, tap, mash, include, shot, peek, poke), and screenshots are
+/// PNG files, so the same scripts drive the native build.
+///
+///   tbs-native [--script FILE] [--shots DIR] [--frames N] [--scale N]
+///
+/// Without a script it runs --frames frames (default 600) and writes a shot
+/// of the last. A shot path in a script keeps only its file name, written
+/// under --shots (default build/native-shots).
+
+#include "native/native.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+
+// --- PNG (stored deflate: no zlib needed) ---------------------------------
+
+static u32 sCrcTable[256];
+
+static u32 Crc(u32 crc, const u8 *p, size_t n) {
+  if (!sCrcTable[1]) {
+    u32 i, k;
+
+    for (i = 0; i < 256; i++) {
+      u32 c = i;
+
+      for (k = 0; k < 8; k++)
+        c = c & 1 ? 0xedb88320u ^ (c >> 1) : c >> 1;
+      sCrcTable[i] = c;
+    }
+  }
+  crc = ~crc;
+  while (n--)
+    crc = sCrcTable[(crc ^ *p++) & 255] ^ (crc >> 8);
+  return ~crc;
+}
+
+static void Put32(u8 *p, u32 v) {
+  p[0] = v >> 24;
+  p[1] = v >> 16;
+  p[2] = v >> 8;
+  p[3] = v;
+}
+
+static void Chunk(FILE *f, const char *type, const u8 *data, u32 size) {
+  u8 head[8];
+  u32 crc;
+
+  Put32(head, size);
+  memcpy(head + 4, type, 4);
+  fwrite(head, 1, 8, f);
+  fwrite(data, 1, size, f);
+  crc = Crc(Crc(0, (const u8 *)type, 4), data, size);
+  Put32(head, crc);
+  fwrite(head, 1, 4, f);
+}
+
+static int Png_Write(const char *path, const u32 *pixels, int width,
+                     int height, int scale) {
+  int w = width * scale, h = height * scale;
+  size_t row = 1 + (size_t)w * 3, raw = row * h;
+  size_t blocks = (raw + 65534) / 65535;
+  u8 *image = malloc(raw), *z = malloc(raw + blocks * 5 + 6), *q;
+  u8 ihdr[13];
+  u32 a = 1, b = 0;
+  size_t i, left;
+  int x, y;
+  FILE *f = fopen(path, "wb");
+
+  if (!f || !image || !z) {
+    Native_Log("cannot write %s: %s", path, strerror(errno));
+    free(image);
+    free(z);
+    if (f)
+      fclose(f);
+    return -1;
+  }
+  for (y = 0; y < h; y++) {
+    u8 *r = image + y * row;
+
+    *r++ = 0;
+    for (x = 0; x < w; x++) {
+      u32 c = pixels[(y / scale) * width + x / scale];
+
+      *r++ = c >> 16;
+      *r++ = c >> 8;
+      *r++ = c;
+    }
+  }
+  q = z;
+  *q++ = 0x78;
+  *q++ = 0x01;
+  for (i = 0, left = raw; left; ) {
+    u32 n = left > 65535 ? 65535 : left;
+
+    *q++ = left == n;
+    *q++ = n;
+    *q++ = n >> 8;
+    *q++ = ~n;
+    *q++ = ~n >> 8;
+    memcpy(q, image + i, n);
+    q += n;
+    i += n;
+    left -= n;
+  }
+  for (i = 0; i < raw; i++) {
+    a = (a + image[i]) % 65521;
+    b = (b + a) % 65521;
+  }
+  Put32(q, b << 16 | a);
+  q += 4;
+  fwrite("\x89PNG\r\n\x1a\n", 1, 8, f);
+  Put32(ihdr, w);
+  Put32(ihdr + 4, h);
+  ihdr[8] = 8;  // bit depth
+  ihdr[9] = 2;  // RGB
+  ihdr[10] = 0;
+  ihdr[11] = 0;
+  ihdr[12] = 0;
+  Chunk(f, "IHDR", ihdr, 13);
+  Chunk(f, "IDAT", z, q - z);
+  Chunk(f, "IEND", NULL, 0);
+  fclose(f);
+  free(image);
+  free(z);
+  return 0;
+}
+
+// --- the script -----------------------------------------------------------------
+
+enum { CMD_HOLD, CMD_SHOT, CMD_PEEK, CMD_POKE };
+
+struct Command {
+  int kind;
+  u16 keys;
+  u32 frames;
+  u32 address, size, value;
+  char *path;
+};
+
+static struct Command *sCommands;
+static int sCount, sCapacity, sNext;
+static u32 sHoldLeft;
+static u16 sKeys;
+static int sDone;
+static const char *sShotDir = "build/native-shots";
+static int sScale = 3;
+static u32 sFrameLimit = 600;
+static int sScripted;
+static const u32 *sLastFrame;
+
+static struct Command *Command_Add(int kind) {
+  if (sCount == sCapacity) {
+    sCapacity = sCapacity ? sCapacity * 2 : 64;
+    sCommands = realloc(sCommands, sCapacity * sizeof(*sCommands));
+  }
+  memset(&sCommands[sCount], 0, sizeof(*sCommands));
+  sCommands[sCount].kind = kind;
+  return &sCommands[sCount++];
+}
+
+static void Hold(u16 keys, u32 frames) {
+  struct Command *c = Command_Add(CMD_HOLD);
+
+  c->keys = keys;
+  c->frames = frames;
+}
+
+static u16 Keys_Parse(const char *s) {
+  u16 keys = 0;
+
+  for (; *s; s++) {
+    switch (*s) {
+    case 'A': keys |= 1; break;
+    case 'B': keys |= 2; break;
+    case 'S': keys |= 4; break;
+    case 'T': keys |= 8; break;
+    case 'R': keys |= 16; break;
+    case 'L': keys |= 32; break;
+    case 'U': keys |= 64; break;
+    case 'D': keys |= 128; break;
+    case 'r': keys |= 256; break;
+    case 'l': keys |= 512; break;
+    default: Native_Fatal("unknown key '%c'", *s);
+    }
+  }
+  return keys;
+}
+
+static void Script_Load(const char *path) {
+  FILE *f = fopen(path, "r");
+  char line[512], dir[512];
+  const char *slash = strrchr(path, '/');
+
+  if (!f)
+    Native_Fatal("cannot open script %s", path);
+  snprintf(dir, sizeof(dir), "%.*s", slash ? (int)(slash - path) : 1,
+           slash ? path : ".");
+  while (fgets(line, sizeof(line), f)) {
+    char word[64], arg1[400], arg2[64], arg3[64];
+    int n;
+    char *hash = strchr(line, '#');
+
+    if (hash)
+      *hash = 0;
+    n = sscanf(line, "%63s %399s %63s %63s", word, arg1, arg2, arg3);
+    if (n <= 0)
+      continue;
+    if (!strcmp(word, "wait") && n >= 2) {
+      Hold(0, strtoul(arg1, NULL, 0));
+    } else if (!strcmp(word, "press") && n >= 3) {
+      Hold(Keys_Parse(arg1), strtoul(arg2, NULL, 0));
+    } else if (!strcmp(word, "tap") && n >= 2) {
+      Hold(Keys_Parse(arg1), 4);
+      Hold(0, 20);
+    } else if (!strcmp(word, "mash") && n >= 3) {
+      u32 i, times = strtoul(arg2, NULL, 0);
+      u16 keys = Keys_Parse(arg1);
+
+      for (i = 0; i < times; i++) {
+        Hold(keys, 4);
+        Hold(0, 20);
+      }
+    } else if (!strcmp(word, "include") && n >= 2) {
+      char sub[1024];
+
+      if (arg1[0] == '/')
+        snprintf(sub, sizeof(sub), "%s", arg1);
+      else
+        snprintf(sub, sizeof(sub), "%s/%s", dir, arg1);
+      Script_Load(sub);
+    } else if (!strcmp(word, "shot") && n >= 2) {
+      const char *base = strrchr(arg1, '/');
+
+      Command_Add(CMD_SHOT)->path = strdup(base ? base + 1 : arg1);
+    } else if (!strcmp(word, "peek") && n >= 3) {
+      struct Command *c = Command_Add(CMD_PEEK);
+
+      c->address = strtoul(arg1, NULL, 16);
+      c->size = strtoul(arg2, NULL, 0);
+    } else if (!strcmp(word, "poke") && n >= 4) {
+      struct Command *c = Command_Add(CMD_POKE);
+
+      c->address = strtoul(arg1, NULL, 16);
+      c->size = strtoul(arg2, NULL, 0);
+      c->value = strtoul(arg3, NULL, 0);
+    } else {
+      Native_Log("script: skipping unsupported line: %s", word);
+    }
+  }
+  fclose(f);
+}
+
+static void Shot(const char *name) {
+  char path[1024];
+
+  snprintf(path, sizeof(path), "%s/%s", sShotDir, name);
+  if (sLastFrame && Png_Write(path, sLastFrame, GBA_WIDTH, GBA_HEIGHT, sScale) == 0)
+    Native_Log("shot %s", path);
+}
+
+/// Runs the script up to the next frame that holds keys or waits.
+static void Script_Step(void) {
+  if (sHoldLeft && --sHoldLeft)
+    return;
+  sKeys = 0;
+  while (sNext < sCount) {
+    struct Command *c = &sCommands[sNext++];
+    volatile u8 *at = (volatile u8 *)(uintptr_t)c->address;
+
+    switch (c->kind) {
+    case CMD_HOLD:
+      if (c->frames == 0)
+        continue;
+      sKeys = c->keys;
+      sHoldLeft = c->frames;
+      return;
+    case CMD_SHOT:
+      Shot(c->path);
+      break;
+    case CMD_PEEK:
+      if (c->size == 4)
+        Native_Log("peek %08x = %u (0x%08x)", c->address, *(volatile u32 *)at,
+                   *(volatile u32 *)at);
+      else if (c->size == 2)
+        Native_Log("peek %08x = %u", c->address, *(volatile u16 *)at);
+      else
+        Native_Log("peek %08x = %u", c->address, *at);
+      break;
+    case CMD_POKE:
+      if (c->size == 4)
+        *(volatile u32 *)at = c->value;
+      else if (c->size == 2)
+        *(volatile u16 *)at = c->value;
+      else
+        *at = c->value;
+      break;
+    }
+  }
+  sDone = 1;
+}
+
+// --- the platform -----------------------------------------------------------------
+
+int Platform_Init(int argc, char **argv) {
+  int i;
+
+  for (i = 1; i < argc; i++) {
+    if (!strcmp(argv[i], "--script") && i + 1 < argc) {
+      Script_Load(argv[++i]);
+      sScripted = 1;
+    } else if (!strcmp(argv[i], "--shots") && i + 1 < argc) {
+      sShotDir = argv[++i];
+    } else if (!strcmp(argv[i], "--frames") && i + 1 < argc) {
+      sFrameLimit = strtoul(argv[++i], NULL, 0);
+    } else if (!strcmp(argv[i], "--scale") && i + 1 < argc) {
+      sScale = atoi(argv[++i]);
+    } else {
+      fprintf(stderr,
+              "usage: %s [--script FILE] [--shots DIR] [--frames N] [--scale N]\n",
+              argv[0]);
+      return 1;
+    }
+  }
+  mkdir(sShotDir, 0777);
+  return 0;
+}
+
+void Platform_Present(const u32 *frame) {
+  sLastFrame = frame;
+  if (sScripted)
+    Script_Step();
+}
+
+u16 Platform_ReadKeys(void) { return sKeys; }
+
+int Platform_ShouldQuit(void) {
+  if (sScripted)
+    return sDone;
+  if (gNativeFrame >= sFrameLimit) {
+    Shot("last.png");
+    return 1;
+  }
+  return 0;
+}
+
+void Platform_Shutdown(void) {}
diff --git a/port/src/platform_sdl.c b/port/src/platform_sdl.c
new file mode 100644
index 0000000..bd8cca7
--- /dev/null
+++ b/port/src/platform_sdl.c
@@ -0,0 +1,159 @@
+/// @file
+/// The SDL3 platform: a window scaled by whole steps (keeping the GBA's
+/// 3:2 picture), keyboard and gamepad input, and 60 frames a second.
+///
+///   tbs-native [--scale N] [--fullscreen]
+///
+/// Keys: arrows (D-pad), X (A), Z (B), Enter (Start), Backspace or right
+/// Shift (Select), A and S (L and R); hold Tab to run without the frame
+/// limit; Escape quits. A gamepad works as laid out on a GBA: south A, east
+/// B, the shoulders L and R, Back for Select.
+
+#include "native/native.h"
+
+#include <SDL3/SDL.h>
+#include <stdlib.h>
+
+static SDL_Window *sWindow;
+static SDL_Renderer *sRenderer;
+static SDL_Texture *sTexture;
+static SDL_Gamepad *sGamepad;
+static int sQuit;
+static Uint64 sNextFrame;
+
+#define FRAME_NS (SDL_NS_PER_SECOND * 280896ull / 16777216ull) // 59.73 Hz
+
+int Platform_Init(int argc, char **argv) {
+  int scale = 4, fullscreen = 0, i;
+
+  for (i = 1; i < argc; i++) {
+    if (!strcmp(argv[i], "--scale") && i + 1 < argc)
+      scale = atoi(argv[++i]);
+    else if (!strcmp(argv[i], "--fullscreen"))
+      fullscreen = 1;
+  }
+  if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD)) {
+    Native_Log("SDL_Init: %s", SDL_GetError());
+    return 1;
+  }
+  if (!SDL_CreateWindowAndRenderer("Broken Seal Arena", GBA_WIDTH * scale,
+                                   GBA_HEIGHT * scale,
+                                   SDL_WINDOW_RESIZABLE |
+                                       (fullscreen ? SDL_WINDOW_FULLSCREEN : 0),
+                                   &sWindow, &sRenderer)) {
+    Native_Log("SDL_CreateWindowAndRenderer: %s", SDL_GetError());
+    return 1;
+  }
+  SDL_SetRenderLogicalPresentation(sRenderer, GBA_WIDTH, GBA_HEIGHT,
+                                   SDL_LOGICAL_PRESENTATION_INTEGER_SCALE);
+  sTexture = SDL_CreateTexture(sRenderer, SDL_PIXELFORMAT_XRGB8888,
+                               SDL_TEXTUREACCESS_STREAMING, GBA_WIDTH,
+                               GBA_HEIGHT);
+  if (!sTexture) {
+    Native_Log("SDL_CreateTexture: %s", SDL_GetError());
+    return 1;
+  }
+  SDL_SetTextureScaleMode(sTexture, SDL_SCALEMODE_NEAREST);
+  sNextFrame = SDL_GetTicksNS();
+  return 0;
+}
+
+static void Events_Poll(void) {
+  SDL_Event event;
+
+  while (SDL_PollEvent(&event)) {
+    switch (event.type) {
+    case SDL_EVENT_QUIT:
+      sQuit = 1;
+      break;
+    case SDL_EVENT_KEY_DOWN:
+      if (event.key.key == SDLK_ESCAPE)
+        sQuit = 1;
+      break;
+    case SDL_EVENT_GAMEPAD_ADDED:
+      if (!sGamepad)
+        sGamepad = SDL_OpenGamepad(event.gdevice.which);
+      break;
+    case SDL_EVENT_GAMEPAD_REMOVED:
+      if (sGamepad && SDL_GetGamepadID(sGamepad) == event.gdevice.which) {
+        SDL_CloseGamepad(sGamepad);
+        sGamepad = NULL;
+      }
+      break;
+    }
+  }
+}
+
+void Platform_Present(const u32 *frame) {
+  const bool *keys;
+
+  SDL_UpdateTexture(sTexture, NULL, frame, GBA_WIDTH * 4);
+  SDL_SetRenderDrawColor(sRenderer, 0, 0, 0, 255);
+  SDL_RenderClear(sRenderer);
+  SDL_RenderTexture(sRenderer, sTexture, NULL, NULL);
+  SDL_RenderPresent(sRenderer);
+  Events_Poll();
+  keys = SDL_GetKeyboardState(NULL);
+  // Pace to the GBA's frame rate unless Tab is held.
+  sNextFrame += FRAME_NS;
+  if (!keys[SDL_SCANCODE_TAB]) {
+    Uint64 now = SDL_GetTicksNS();
+
+    if (sNextFrame > now)
+      SDL_DelayNS(sNextFrame - now);
+    else if (now - sNextFrame > FRAME_NS * 4)
+      sNextFrame = now; // fell behind: do not race to catch up
+  } else {
+    sNextFrame = SDL_GetTicksNS();
+  }
+}
+
+u16 Platform_ReadKeys(void) {
+  const bool *k = SDL_GetKeyboardState(NULL);
+  u16 keys = 0;
+
+  if (k[SDL_SCANCODE_X]) keys |= 1;
+  if (k[SDL_SCANCODE_Z]) keys |= 2;
+  if (k[SDL_SCANCODE_BACKSPACE] || k[SDL_SCANCODE_RSHIFT]) keys |= 4;
+  if (k[SDL_SCANCODE_RETURN]) keys |= 8;
+  if (k[SDL_SCANCODE_RIGHT]) keys |= 16;
+  if (k[SDL_SCANCODE_LEFT]) keys |= 32;
+  if (k[SDL_SCANCODE_UP]) keys |= 64;
+  if (k[SDL_SCANCODE_DOWN]) keys |= 128;
+  if (k[SDL_SCANCODE_S]) keys |= 256;
+  if (k[SDL_SCANCODE_A]) keys |= 512;
+  if (sGamepad) {
+    Sint16 x = SDL_GetGamepadAxis(sGamepad, SDL_GAMEPAD_AXIS_LEFTX);
+    Sint16 y = SDL_GetGamepadAxis(sGamepad, SDL_GAMEPAD_AXIS_LEFTY);
+
+    if (SDL_GetGamepadButton(sGamepad, SDL_GAMEPAD_BUTTON_SOUTH)) keys |= 1;
+    if (SDL_GetGamepadButton(sGamepad, SDL_GAMEPAD_BUTTON_EAST)) keys |= 2;
+    if (SDL_GetGamepadButton(sGamepad, SDL_GAMEPAD_BUTTON_BACK)) keys |= 4;
+    if (SDL_GetGamepadButton(sGamepad, SDL_GAMEPAD_BUTTON_START)) keys |= 8;
+    if (SDL_GetGamepadButton(sGamepad, SDL_GAMEPAD_BUTTON_DPAD_RIGHT) || x > 16000) keys |= 16;
+    if (SDL_GetGamepadButton(sGamepad, SDL_GAMEPAD_BUTTON_DPAD_LEFT) || x < -16000) keys |= 32;
+    if (SDL_GetGamepadButton(sGamepad, SDL_GAMEPAD_BUTTON_DPAD_UP) || y < -16000) keys |= 64;
+    if (SDL_GetGamepadButton(sGamepad, SDL_GAMEPAD_BUTTON_DPAD_DOWN) || y > 16000) keys |= 128;
+    if (SDL_GetGamepadButton(sGamepad, SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER)) keys |= 256;
+    if (SDL_GetGamepadButton(sGamepad, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER)) keys |= 512;
+  }
+  return keys;
+}
+
+int Platform_ShouldQuit(void) { return sQuit; }
+
+void Platform_Shutdown(void) {
+  if (sGamepad)
+    SDL_CloseGamepad(sGamepad);
+  if (sTexture)
+    SDL_DestroyTexture(sTexture);
+  if (sRenderer)
+    SDL_DestroyRenderer(sRenderer);
+  if (sWindow)
+    SDL_DestroyWindow(sWindow);
+  sGamepad = NULL;
+  sTexture = NULL;
+  sRenderer = NULL;
+  sWindow = NULL;
+  SDL_Quit();
+}
diff --git a/port/src/ppu.c b/port/src/ppu.c
new file mode 100644
index 0000000..fa18076
--- /dev/null
+++ b/port/src/ppu.c
@@ -0,0 +1,414 @@
+/// @file
+/// The software display: draws one line at a time from the GBA's display
+/// registers, VRAM, palette and OAM as the hardware would, so the HBlank
+/// effects the game drives by DMA and interrupts land on their lines.
+///
+/// Covered: modes 0 to 5; text and affine backgrounds (4 and 8 bpp, all
+/// sizes, wrap); sprites, flipped and affine (double size), 1D and 2D tile
+/// mapping, semi-transparent and window sprites; WIN0, WIN1 and the sprite
+/// window; alpha blending, brighten and darken; forced blank. Not covered
+/// yet: mosaic, and the sprite-priority quirk between overlapping sprites.
+
+#include "native/native.h"
+
+#define REG16(offset) (*(volatile u16 *)(uintptr_t)(IO_BASE + (offset)))
+#define REG32(offset) (*(volatile u32 *)(uintptr_t)(IO_BASE + (offset)))
+#define VRAM ((const u8 *)(uintptr_t)VRAM_BASE)
+#define PALETTE ((const u16 *)(uintptr_t)PALETTE_BASE)
+#define OAM ((const u16 *)(uintptr_t)OAM_BASE)
+
+/// A layer pixel: the RGB555 colour, or TRANSPARENT.
+#define TRANSPARENT 0x8000
+
+enum { LAYER_BG0, LAYER_BG1, LAYER_BG2, LAYER_BG3, LAYER_OBJ, LAYER_BD };
+
+static u16 sBg[4][GBA_WIDTH];
+static u16 sObj[GBA_WIDTH];
+static u8 sObjPriority[GBA_WIDTH];
+static u8 sObjSemi[GBA_WIDTH];
+static u8 sObjWindow[GBA_WIDTH];
+
+/// The affine backgrounds' internal reference points, which step by PB and
+/// PD each line and reload when the game writes the registers.
+static s32 sRefX[2], sRefY[2];
+static u32 sLastX[2], sLastY[2];
+
+static s32 Signed28(u32 value) { return (s32)(value << 4) >> 4; }
+
+static u32 Rgb(u16 c) {
+  u32 r = c & 31, g = (c >> 5) & 31, b = (c >> 10) & 31;
+
+  return ((r << 3 | r >> 2) << 16) | ((g << 3 | g >> 2) << 8) | (b << 3 | b >> 2);
+}
+
+// --- backgrounds -----------------------------------------------------------------
+
+static void Bg_Text(int bg, int y) {
+  u16 control = REG16(0x08 + bg * 2);
+  u32 hofs = REG16(0x10 + bg * 4) & 0x1ff;
+  u32 vofs = REG16(0x12 + bg * 4) & 0x1ff;
+  const u8 *tiles = VRAM + ((control >> 2) & 3) * 0x4000;
+  const u16 *map = (const u16 *)(VRAM + ((control >> 8) & 31) * 0x800);
+  int wide = control & 0x4000, tall = control & 0x8000;
+  int colours256 = control & 0x80;
+  u32 py = (y + vofs) & (tall ? 511 : 255);
+  int x;
+
+  for (x = 0; x < GBA_WIDTH; x++) {
+    u32 px = (x + hofs) & (wide ? 511 : 255);
+    u32 block = 0, entry, tx, ty, index;
+
+    if (px >= 256)
+      block += 1;
+    if (py >= 256)
+      block += wide ? 2 : 1;
+    entry = map[block * 1024 + ((py & 255) >> 3) * 32 + ((px & 255) >> 3)];
+    tx = px & 7;
+    ty = py & 7;
+    if (entry & 0x400)
+      tx = 7 - tx;
+    if (entry & 0x800)
+      ty = 7 - ty;
+    if (colours256) {
+      u32 at = (entry & 0x3ff) * 64 + ty * 8 + tx;
+
+      index = at < 0x10000 - ((control >> 2) & 3) * 0x4000 ? tiles[at] : 0;
+      sBg[bg][x] = index ? PALETTE[index] & 0x7fff : TRANSPARENT;
+    } else {
+      u32 at = (entry & 0x3ff) * 32 + ty * 4 + (tx >> 1);
+
+      index = (tiles[at] >> ((tx & 1) * 4)) & 15;
+      sBg[bg][x] = index ? PALETTE[(entry >> 12) * 16 + index] & 0x7fff
+                         : TRANSPARENT;
+    }
+  }
+}
+
+static void Bg_Affine(int bg, int y) {
+  int k = bg - 2;
+  u16 control = REG16(0x08 + bg * 2);
+  s32 pa = (s16)REG16(0x20 + k * 16), pc = (s16)REG16(0x24 + k * 16);
+  const u8 *tiles = VRAM + ((control >> 2) & 3) * 0x4000;
+  const u8 *map = VRAM + ((control >> 8) & 31) * 0x800;
+  s32 size = 128 << ((control >> 14) & 3);
+  int wrap = control & 0x2000;
+  s32 cx = sRefX[k], cy = sRefY[k];
+  int x;
+
+  (void)y;
+  for (x = 0; x < GBA_WIDTH; x++, cx += pa, cy += pc) {
+    s32 px = cx >> 8, py = cy >> 8;
+    u32 index;
+
+    if (wrap) {
+      px &= size - 1;
+      py &= size - 1;
+    } else if (px < 0 || py < 0 || px >= size || py >= size) {
+      sBg[bg][x] = TRANSPARENT;
+      continue;
+    }
+    index = tiles[map[(py >> 3) * (size >> 3) + (px >> 3)] * 64 + (py & 7) * 8 +
+                  (px & 7)];
+    sBg[bg][x] = index ? PALETTE[index] & 0x7fff : TRANSPARENT;
+  }
+}
+
+/// Modes 3 to 5: BG2 is a bitmap (through the affine reference point).
+static void Bg_Bitmap(int mode, int y) {
+  s32 pa = (s16)REG16(0x20), pc = (s16)REG16(0x24);
+  s32 cx = sRefX[0], cy = sRefY[0];
+  int width = mode == 5 ? 160 : 240, height = mode == 5 ? 128 : 160;
+  const u8 *page = VRAM + ((mode != 3 && (REG16(0) & 0x10)) ? 0xa000 : 0);
+  int x;
+
+  (void)y;
+  for (x = 0; x < GBA_WIDTH; x++, cx += pa, cy += pc) {
+    s32 px = cx >> 8, py = cy >> 8;
+
+    if (px < 0 || py < 0 || px >= width || py >= height) {
+      sBg[2][x] = TRANSPARENT;
+    } else if (mode == 4) {
+      u8 index = page[py * 240 + px];
+
+      sBg[2][x] = index ? PALETTE[index] & 0x7fff : TRANSPARENT;
+    } else {
+      sBg[2][x] = ((const u16 *)page)[py * width + px] & 0x7fff;
+    }
+  }
+}
+
+// --- sprites -------------------------------------------------------------------------
+
+static const u8 kObjWidth[3][4] = {{8, 16, 32, 64}, {16, 32, 32, 64}, {8, 8, 16, 32}};
+static const u8 kObjHeight[3][4] = {{8, 16, 32, 64}, {8, 8, 16, 32}, {16, 32, 32, 64}};
+
+static void Obj_Line(int y) {
+  u16 dispcnt = REG16(0);
+  int oneD = dispcnt & 0x40;
+  u32 tileBase = (dispcnt & 7) >= 3 ? 512 : 0;
+  const u8 *objTiles = VRAM + 0x10000;
+  int i, x;
+
+  for (x = 0; x < GBA_WIDTH; x++) {
+    sObj[x] = TRANSPARENT;
+    sObjPriority[x] = 4;
+    sObjSemi[x] = 0;
+    sObjWindow[x] = 0;
+  }
+  if (!(dispcnt & 0x1000))
+    return;
+  for (i = 0; i < 128; i++) {
+    u16 a0 = OAM[i * 4], a1 = OAM[i * 4 + 1], a2 = OAM[i * 4 + 2];
+    int affine = a0 & 0x100, shape = a0 >> 14, size = a1 >> 14;
+    int mode = (a0 >> 10) & 3, colours256 = a0 & 0x2000;
+    int width, height, boxW, boxH, sy, sx, row;
+    u32 tile = a2 & 0x3ff, priority = (a2 >> 10) & 3;
+    s32 pa = 256, pb = 0, pc = 0, pd = 256;
+
+    if (!affine && (a0 & 0x200))
+      continue; // hidden
+    if (shape == 3 || mode == 3)
+      continue;
+    width = kObjWidth[shape][size];
+    height = kObjHeight[shape][size];
+    boxW = width;
+    boxH = height;
+    if (affine && (a0 & 0x200)) {
+      boxW *= 2;
+      boxH *= 2;
+    }
+    sy = a0 & 255;
+    if (sy >= 160)
+      sy -= 256;
+    row = y - sy;
+    if (row < 0 || row >= boxH)
+      continue;
+    sx = a1 & 511;
+    if (sx >= 240)
+      sx -= 512;
+    if (tile < tileBase)
+      continue;
+    if (affine) {
+      int group = (a1 >> 9) & 31;
+
+      pa = (s16)OAM[group * 16 + 3];
+      pb = (s16)OAM[group * 16 + 7];
+      pc = (s16)OAM[group * 16 + 11];
+      pd = (s16)OAM[group * 16 + 15];
+    }
+    for (x = 0; x < boxW; x++) {
+      int screen = sx + x;
+      s32 tx, ty;
+      u32 index, tileNumber, at;
+
+      if (screen < 0 || screen >= GBA_WIDTH)
+        continue;
+      if (affine) {
+        s32 dx = x - boxW / 2, dy = row - boxH / 2;
+
+        tx = ((pa * dx + pb * dy) >> 8) + width / 2;
+        ty = ((pc * dx + pd * dy) >> 8) + height / 2;
+        if (tx < 0 || ty < 0 || tx >= width || ty >= height)
+          continue;
+      } else {
+        tx = (a1 & 0x1000) ? width - 1 - x : x;
+        ty = (a1 & 0x2000) ? height - 1 - row : row;
+      }
+      if (colours256) {
+        tileNumber = tile + (oneD ? (ty >> 3) * (width >> 3) * 2 : (ty >> 3) * 32) +
+                     (tx >> 3) * 2;
+        at = (tileNumber & 0x3ff) * 32 + (ty & 7) * 8 + (tx & 7);
+        index = objTiles[at & 0x7fff];
+        if (!index)
+          continue;
+        index += 256;
+      } else {
+        tileNumber = tile + (oneD ? (ty >> 3) * (width >> 3) : (ty >> 3) * 32) +
+                     (tx >> 3);
+        at = (tileNumber & 0x3ff) * 32 + (ty & 7) * 4 + ((tx & 7) >> 1);
+        index = (objTiles[at & 0x7fff] >> ((tx & 1) * 4)) & 15;
+        if (!index)
+          continue;
+        index += 256 + (a2 >> 12) * 16;
+      }
+      if (mode == 2) {
+        sObjWindow[screen] = 1;
+        continue;
+      }
+      if (sObj[screen] != TRANSPARENT && sObjPriority[screen] <= priority)
+        continue;
+      sObj[screen] = PALETTE[index] & 0x7fff;
+      sObjPriority[screen] = priority;
+      sObjSemi[screen] = mode == 1;
+    }
+  }
+}
+
+// --- windows and composition ---------------------------------------------------
+
+static int InRange(u32 value, u32 start, u32 end) {
+  if (start <= end)
+    return value >= start && value < end;
+  return value >= start || value < end;
+}
+
+static u16 Blend(u16 top, u16 bottom, u32 eva, u32 evb) {
+  u32 r = ((top & 31) * eva + (bottom & 31) * evb) >> 4;
+  u32 g = (((top >> 5) & 31) * eva + ((bottom >> 5) & 31) * evb) >> 4;
+  u32 b = (((top >> 10) & 31) * eva + ((bottom >> 10) & 31) * evb) >> 4;
+
+  return (r > 31 ? 31 : r) | (g > 31 ? 31 : g) << 5 | (b > 31 ? 31 : b) << 10;
+}
+
+static u16 Brighten(u16 c, u32 evy) {
+  u32 r = c & 31, g = (c >> 5) & 31, b = (c >> 10) & 31;
+
+  r += ((31 - r) * evy) >> 4;
+  g += ((31 - g) * evy) >> 4;
+  b += ((31 - b) * evy) >> 4;
+  return r | g << 5 | b << 10;
+}
+
+static u16 Darken(u16 c, u32 evy) {
+  u32 r = c & 31, g = (c >> 5) & 31, b = (c >> 10) & 31;
+
+  r -= (r * evy) >> 4;
+  g -= (g * evy) >> 4;
+  b -= (b * evy) >> 4;
+  return r | g << 5 | b << 10;
+}
+
+void Ppu_RenderLine(int y, u32 *line) {
+  u16 dispcnt = REG16(0);
+  int mode = dispcnt & 7;
+  u16 bldcnt = REG16(0x50), alpha = REG16(0x52);
+  u32 eva = alpha & 31, evb = (alpha >> 8) & 31, evy = REG16(0x54) & 31;
+  int windows = dispcnt & 0xe000;
+  int enabled[4] = {0, 0, 0, 0};
+  int bg, k, x;
+  u16 backdrop = PALETTE[0] & 0x7fff;
+
+  if (eva > 16)
+    eva = 16;
+  if (evb > 16)
+    evb = 16;
+  if (evy > 16)
+    evy = 16;
+  // The affine reference points: reload at the frame's top or when written.
+  for (k = 0; k < 2; k++) {
+    u32 rx = REG32(0x28 + k * 16), ry = REG32(0x2c + k * 16);
+
+    if (y == 0 || rx != sLastX[k]) {
+      sRefX[k] = Signed28(rx);
+      sLastX[k] = rx;
+    }
+    if (y == 0 || ry != sLastY[k]) {
+      sRefY[k] = Signed28(ry);
+      sLastY[k] = ry;
+    }
+  }
+  if (dispcnt & 0x80) {
+    for (x = 0; x < GBA_WIDTH; x++)
+      line[x] = 0xffffff;
+    goto step;
+  }
+  for (bg = 0; bg < 4; bg++) {
+    int on = (dispcnt >> (8 + bg)) & 1;
+
+    if (!on)
+      continue;
+    if (mode == 0 || (mode == 1 && bg < 2)) {
+      Bg_Text(bg, y);
+    } else if ((mode == 1 && bg == 2) || (mode == 2 && bg >= 2)) {
+      Bg_Affine(bg, y);
+    } else if (mode >= 3 && bg == 2) {
+      Bg_Bitmap(mode, y);
+    } else {
+      continue;
+    }
+    enabled[bg] = 1;
+  }
+  Obj_Line(y);
+
+  for (x = 0; x < GBA_WIDTH; x++) {
+    u32 mask = 0x3f; // BG0-3, OBJ, effects
+    u16 top = backdrop, second = backdrop;
+    int topLayer = LAYER_BD, secondLayer = LAYER_BD;
+    int topPriority = 5, secondPriority = 5;
+    int p;
+    u16 colour;
+
+    if (windows) {
+      u16 winin = REG16(0x48), winout = REG16(0x4a);
+
+      if ((dispcnt & 0x2000) &&
+          InRange(x, REG16(0x40) >> 8, REG16(0x40) & 255) &&
+          InRange(y, REG16(0x44) >> 8, REG16(0x44) & 255))
+        mask = winin & 0x3f;
+      else if ((dispcnt & 0x4000) &&
+               InRange(x, REG16(0x42) >> 8, REG16(0x42) & 255) &&
+               InRange(y, REG16(0x46) >> 8, REG16(0x46) & 255))
+        mask = (winin >> 8) & 0x3f;
+      else if ((dispcnt & 0x8000) && sObjWindow[x])
+        mask = (winout >> 8) & 0x3f;
+      else
+        mask = winout & 0x3f;
+    }
+    // The two front layers: lower priority number first; a sprite beats a
+    // background of its own priority, a lower background number beats a
+    // higher.
+    for (p = 0; p < 4; p++) {
+      if ((mask & 0x10) && sObj[x] != TRANSPARENT && sObjPriority[x] == p) {
+        if (topLayer == LAYER_BD) {
+          top = sObj[x];
+          topLayer = LAYER_OBJ;
+          topPriority = p;
+        } else if (secondLayer == LAYER_BD) {
+          second = sObj[x];
+          secondLayer = LAYER_OBJ;
+          secondPriority = p;
+        }
+      }
+      for (bg = 0; bg < 4; bg++) {
+        if (!enabled[bg] || !(mask & (1 << bg)) ||
+            (REG16(0x08 + bg * 2) & 3) != p || sBg[bg][x] == TRANSPARENT)
+          continue;
+        if (topLayer == LAYER_BD) {
+          top = sBg[bg][x];
+          topLayer = bg;
+          topPriority = p;
+        } else if (secondLayer == LAYER_BD) {
+          second = sBg[bg][x];
+          secondLayer = bg;
+          secondPriority = p;
+        }
+      }
+    }
+    (void)topPriority;
+    (void)secondPriority;
+    colour = top;
+    if (topLayer == LAYER_OBJ && sObjSemi[x] &&
+        (bldcnt & (0x100 << secondLayer))) {
+      colour = Blend(top, second, eva, evb);
+    } else if ((mask & 0x20) && (bldcnt & (1 << topLayer))) {
+      switch ((bldcnt >> 6) & 3) {
+      case 1:
+        if (bldcnt & (0x100 << secondLayer))
+          colour = Blend(top, second, eva, evb);
+        break;
+      case 2:
+        colour = Brighten(top, evy);
+        break;
+      case 3:
+        colour = Darken(top, evy);
+        break;
+      }
+    }
+    line[x] = Rgb(colour);
+  }
+step:
+  for (k = 0; k < 2; k++) {
+    sRefX[k] += (s16)REG16(0x22 + k * 16);
+    sRefY[k] += (s16)REG16(0x26 + k * 16);
+  }
+}
diff --git a/port/tools/arm2host_s.py b/port/tools/arm2host_s.py
new file mode 100644
index 0000000..adfa82a
--- /dev/null
+++ b/port/tools/arm2host_s.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Turn one of the game's data-only ARM assembly files into one the host's
+GNU assembler takes (x86 or any other little-endian ELF target).
+
+Includes are inlined (converted the same way); `@` comments go; ARM-only
+directives (.arm, .thumb, .syntax, .thumb_func) are dropped; .word becomes
+.4byte (on x86 .word is two bytes). Code (an ARM or Thumb instruction) is
+refused: those files have C replacements under port/src.
+
+usage: arm2host_s.py INPUT OUTPUT [-I DIR]... [--defsym NAME=VALUE]...
+"""
+import os, re, sys
+
+DROP = {'.arm', '.thumb', '.syntax', '.thumb_func', '.code', '.force_thumb',
+        '.cpu', '.fpu', '.eabi_attribute', '.pool', '.ltorg'}
+RENAME = {'.word': '.4byte', '.hword': '.2byte', '.short': '.2byte',
+          '.int': '.4byte', '.long': '.4byte'}
+DIRECTIVE = re.compile(r'^(\s*)(\.[A-Za-z0-9_]+)(.*)$')
+LABEL = re.compile(r'^\s*[A-Za-z_.$][A-Za-z0-9_.$]*:\s*')
+
+def strip_comment(line):
+    out, quote, i = [], False, 0
+    while i < len(line):
+        c = line[i]
+        if c == '\\' and quote:
+            out.append(line[i:i + 2]); i += 2; continue
+        if c == '"':
+            quote = not quote
+        elif not quote and c == '@':
+            break
+        elif not quote and c == '/' and line[i:i + 2] == '//':
+            break
+        out.append(c); i += 1
+    return ''.join(out).rstrip()
+
+class Converter:
+    def __init__(self, includes):
+        self.includes = includes
+        self.macros = set()
+
+    def find(self, name, here):
+        for d in [os.path.dirname(here), '.'] + self.includes:
+            p = os.path.join(d, name)
+            if os.path.exists(p):
+                return p
+        raise SystemExit(f'{here}: cannot find include {name}')
+
+    def convert(self, path, out, in_macro=False):
+        with open(path, encoding='utf-8', errors='replace') as f:
+            text = f.read()
+        # C-style block comments
+        text = re.sub(r'/\*.*?\*/', lambda m: '\n' * m.group(0).count('\n'), text, flags=re.S)
+        for n, raw in enumerate(text.split('\n'), 1):
+            line = strip_comment(raw)
+            if not line.strip():
+                continue
+            body = LABEL.sub('', line) if not line.lstrip().startswith('.') else line
+            label = line[:len(line) - len(body)]
+            m = DIRECTIVE.match(body)
+            if not m:
+                if body.strip():
+                    word = body.split()[0]
+                    if word in self.macros:
+                        out.append(line); continue
+                    raise ValueError(f'{path}:{n}: not data: {raw.strip()}')
+                out.append(line); continue
+            indent, d, rest = m.groups()
+            if d == '.macro':
+                self.macros.add(rest.split()[0].rstrip(','))
+            if d == '.include':
+                inc = rest.strip().strip('"')
+                if label.strip():
+                    out.append(label)
+                self.convert(self.find(inc, path), out)
+                continue
+            if d in DROP:
+                if label.strip():
+                    out.append(label)
+                continue
+            if d == '.section':
+                rest = rest.replace('%nobits', '@nobits').replace('%progbits', '@progbits')
+            if d == '.type':
+                rest = rest.replace('%function', '@function').replace('%object', '@object')
+            if d == '.align':
+                d = '.p2align'
+            d = RENAME.get(d, d)
+            out.append(f'{label}{indent}{d}{rest}')
+
+def main():
+    args = sys.argv[1:]
+    inp, outp = args[0], args[1]
+    includes, defsyms = [], []
+    i = 2
+    while i < len(args):
+        if args[i] == '-I':
+            includes.append(args[i + 1]); i += 2
+        elif args[i] == '--defsym':
+            defsyms.append(args[i + 1]); i += 2
+        else:
+            raise SystemExit(f'unknown argument {args[i]}')
+    out = [f'\t.set {d.replace("=", ", ")}' for d in defsyms]
+    try:
+        Converter(includes).convert(inp, out)
+    except ValueError as e:
+        raise SystemExit(str(e))
+    tmp = outp + '.tmp'
+    with open(tmp, 'w') as f:
+        f.write('\n'.join(out) + '\n')
+    os.replace(tmp, outp)
+
+if __name__ == '__main__':
+    main()
diff --git a/port/tools/far_aliases.py b/port/tools/far_aliases.py
new file mode 100644
index 0000000..29b6cd9
--- /dev/null
+++ b/port/tools/far_aliases.py
@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""The far calls, as plain aliases, for the native build.
+
+On the GBA a bank's code is reached through a table of 8-byte veneers at a
+fixed address (src/gamepak/far_call/*.s: `export NameFar, Name`), and an
+overlay calls the main image through its import table (imports.inc: `export
+Name, TargetFar`). The native build links everything into one image, so
+NameFar is simply another name for Name (a linker script of PROVIDEs), and an import whose name differs
+from its target is an alias of the target.
+
+usage: far_aliases.py OUTPUT.ld FAR_CALL_DIR IMPORTS.inc
+"""
+import glob, os, re, sys
+
+def exports(path):
+    for raw in open(path):
+        m = re.match(r'\s*export\s+(\w+)\s*,\s*(\w+)', raw.split('@')[0])
+        if m:
+            yield m.group(1), m.group(2)
+
+def main():
+    output, far_dir, imports = sys.argv[1:4]
+    aliases = {}
+    for path in sorted(glob.glob(os.path.join(far_dir, '*.s'))):
+        for name, target in exports(path):
+            aliases[name] = target
+    for name, target in exports(imports):
+        real = aliases.get(target, target)
+        if name != real and name not in aliases and not name.startswith('__'):
+            aliases[name] = real
+    # Resolve chains (an alias of an alias) to the routine itself.
+    def resolve(n, seen=()):
+        t = aliases.get(n, n)
+        return t if t == n or t in seen else resolve(t, seen + (n,))
+    out = ['/* Written by port/tools/far_aliases.py: do not edit. */']
+    for name in sorted(aliases):
+        out.append(f'PROVIDE({name} = {resolve(name)});')
+    open(output, 'w').write('\n'.join(out) + '\n')
+
+main()
diff --git a/port/tools/far_tables.py b/port/tools/far_tables.py
new file mode 100644
index 0000000..f12fa01
--- /dev/null
+++ b/port/tools/far_tables.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+"""Writes the far-call bank tables (games/tbs/src/gamepak/far_call/*.s) as
+host data: each 8-byte entry becomes {0, target}, so code that reads an
+entry's target (the world map's trigonometry) finds the routine, and the
+resource directory's rows find their tables. The named stubs themselves are
+linker aliases (far_aliases.py).
+
+usage: far_tables.py OUT.s DEFINE FILE.s...
+"""
+import re
+import sys
+
+out, define, files = sys.argv[1], sys.argv[2], sys.argv[3:]
+lines = []
+for path in files:
+    stack = []  # whether each enclosing .if block is active
+    for raw in open(path):
+        line = raw.split('@')[0].strip()
+        if not line:
+            continue
+        m = re.match(r'\.(ifdef|ifndef)\s+(\S+)', line)
+        if m:
+            defined = m.group(2) == define
+            stack.append(defined if m.group(1) == 'ifdef' else not defined)
+            continue
+        if line == '.else':
+            stack[-1] = not stack[-1]
+            continue
+        if line == '.endif':
+            stack.pop()
+            continue
+        if not all(stack):
+            continue
+        m = re.match(r'([A-Za-z_]\w*):$', line)
+        if m and m.group(1).startswith('FarCall_'):
+            lines += ['\t.p2align 2', '\t.globl %s' % m.group(1),
+                      '%s:' % m.group(1)]
+            continue
+        m = re.match(r'export\s+\S+\s*,\s*(\S+)$', line) or \
+            re.match(r'overlay_veneer\s+(\S+)$', line)
+        if m:
+            lines.append('\t.4byte 0, %s' % m.group(1))
+with open(out, 'w') as f:
+    f.write('# Generated by port/tools/far_tables.py.\n\t.section .rodata\n')
+    f.write('\n'.join(lines) + '\n')
diff --git a/port/tools/native_symbols.py b/port/tools/native_symbols.py
new file mode 100644
index 0000000..ab7e9a5
--- /dev/null
+++ b/port/tools/native_symbols.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+"""Writes the absolute symbols the native build takes from elsewhere:
+- the code sizes of the routines the game copies to RAM (*CodeSize,
+  BitDecoder_Size), from the GBA build's ELF, so its heap allocations stay
+  the cartridge's sizes;
+- IwramIrqMain at the start of IWRAM, where the game copies its resident
+  code (offsets from it to the IWRAM routines are link-time differences);
+- the data tables of assembly files whose code is replaced, copied from
+  their source (FILE.s:LABEL, up to the next label or code).
+
+usage: native_symbols.py OUT.s GBA.elf NM [FILE.s:LABEL...]
+"""
+import re
+import subprocess
+import sys
+
+out, elf, nm = sys.argv[1:4]
+tables = sys.argv[4:]
+lines = ['# Generated by port/tools/native_symbols.py.']
+for row in subprocess.check_output([nm, elf], text=True).splitlines():
+    parts = row.split()
+    if len(parts) == 3 and parts[1] in 'Aa' and \
+            re.search(r'(CodeSize|^BitDecoder_Size)$', parts[2]):
+        lines += ['\t.globl %s' % parts[2], '\t.set %s, 0x%s' % (parts[2], parts[0])]
+lines += ['\t.globl IwramIrqMain', '\t.set IwramIrqMain, 0x03000000']
+lines.append('\t.section .rodata')
+for spec in tables:
+    path, label = spec.rsplit(':', 1)
+    copying = False
+    for raw in open(path):
+        line = raw.split('@')[0].rstrip()
+        if re.match(r'\s*%s:' % re.escape(label), line):
+            copying = True
+            lines += ['\t.p2align 2', '\t.globl %s' % label, '%s:' % label]
+            continue
+        if not copying or not line.strip():
+            continue
+        m = re.match(r'\s*\.(hword|short|word|4byte|2byte|byte)\s+(.*)$', line)
+        if not m:
+            break
+        kind = {'hword': '2byte', 'short': '2byte', 'word': '4byte'}.get(m.group(1), m.group(1))
+        lines.append('\t.%s %s' % (kind, m.group(2)))
+    if not copying:
+        sys.exit('%s: no label %s' % (path, label))
+open(out, 'w').write('\n'.join(lines) + '\n')
diff --git a/port/tools/overlay_object.py b/port/tools/overlay_object.py
new file mode 100644
index 0000000..59a546e
--- /dev/null
+++ b/port/tools/overlay_object.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""Link one scene overlay into a relocatable object for the native build.
+
+On the GBA every overlay is linked at 0x2008000 and unpacked there when its
+scene starts, so all 96 define the same six entry points (Scene_Initialize
+and the rest) and many share helper names. Natively they all live in one
+image, so each overlay is linked on its own (ld -r), then:
+
+  * every global it defines becomes local, except the six entry points,
+    which are renamed NAME_Scene_Initialize and so on;
+  * its code goes into section native_overlay_text (the task list asks
+    whether a routine is overlay code);
+  * its data and read-only data go into native_overlay_data_NAME, which the
+    loader restores each time the overlay is loaded (scenes write into their
+    own tables), and its BSS into native_overlay_bss_NAME, which it clears.
+
+usage: overlay_object.py NAME OUTPUT.o INPUT.o...
+"""
+import os, subprocess, sys
+
+ENTRY = ['Scene_Initialize', 'Scene_GetEntrances', 'Scene_GetExits',
+         'Scene_GetActorPlacements', 'Scene_GetTriggers', 'Scene_GetExitRegions']
+LD = os.environ.get('LD_HOST', 'ld')
+OBJCOPY = os.environ.get('OBJCOPY_HOST', 'objcopy')
+NM = os.environ.get('NM_HOST', 'nm')
+EMULATION = os.environ.get('LD_EMULATION', 'elf_i386')
+
+def run(*args):
+    subprocess.run(args, check=True)
+
+def main():
+    name, output, inputs = sys.argv[1], sys.argv[2], sys.argv[3:]
+    tmp = output + '.ld.o'
+    run(LD, '-m', EMULATION, '-r', '-d', '-o', tmp, *inputs)
+    symbols = subprocess.run([NM, '-g', '--defined-only', tmp], check=True,
+                             capture_output=True, text=True).stdout.split('\n')
+    defined = [line.split()[-1] for line in symbols if len(line.split()) == 3]
+    args = [OBJCOPY]
+    for sym in defined:
+        if sym in ENTRY:
+            args += ['--redefine-sym', f'{sym}={name}_{sym}']
+        else:
+            args += ['--localize-symbol', sym]
+    data = f'native_overlay_data_{name}'
+    bss = f'native_overlay_bss_{name}'
+    sections = subprocess.run(['objdump', '-h', tmp], check=True,
+                              capture_output=True, text=True).stdout.split('\n')
+    for line in sections:
+        parts = line.split()
+        if len(parts) < 7 or not parts[0].isdigit():
+            continue
+        sec = parts[1]
+        if sec.startswith('.text'):
+            args += ['--rename-section', f'{sec}=native_overlay_text,alloc,load,readonly,code,contents']
+        elif sec.startswith('.rodata') or sec.startswith('.data') or sec == '.overlays':
+            args += ['--rename-section', f'{sec}={data},alloc,load,data,contents']
+        elif sec.startswith('.bss') or sec == 'COMMON':
+            args += ['--rename-section', f'{sec}={bss},alloc']
+    run(*args, tmp, output)
+    os.remove(tmp)
+
+main()
