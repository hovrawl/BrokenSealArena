+#!/usr/bin/env python3
+"""Puts a run's PNG shots on one labelled page: sheet.py DIR [OUT.png]."""
+import os
+import sys
+from PIL import Image, ImageDraw
+
+d = sys.argv[1]
+out = sys.argv[2] if len(sys.argv) > 2 else os.path.join(d, 'sheet.png')
+names = sorted(n for n in os.listdir(d) if n.endswith('.png') and n != os.path.basename(out))
+shots = [Image.open(os.path.join(d, n)).convert('RGB').resize((240, 160)) for n in names]
+cols = min(4, len(shots)) or 1
+rows = (len(shots) + cols - 1) // cols
+sheet = Image.new('RGB', (cols * 244, rows * 176), (40, 40, 40))
+draw = ImageDraw.Draw(sheet)
+for i, (n, s) in enumerate(zip(names, shots)):
+    x, y = (i % cols) * 244 + 2, (i // cols) * 176 + 2
+    sheet.paste(s, (x, y))
+    draw.text((x, y + 161), n, fill=(230, 230, 230))
+sheet.save(out)
+print(out)
