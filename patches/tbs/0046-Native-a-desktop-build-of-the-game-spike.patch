diff --git a/port/Makefile b/port/Makefile
new file mode 100644
index 0000000..23557ea
--- /dev/null
+++ b/port/Makefile
@@ -0,0 +1,145 @@
+# The native build of The Broken Seal (Arena): the game's C compiled for the
+# host (32-bit for now), with the ARM assembly replaced by C in port/src and
+# a software stand-in for the GBA's display. Run from the repository root:
+#
+#   make tbs-en                      # once: the GBA build makes the assets,
+#                                    # text and the object lists this reads
+#   make -f port/Makefile            # out/native-tbs-en/tbs-native (SDL3)
+#   make -f port/Makefile HEADLESS=1 # no SDL: frames go to PNG files
+#
+# See port/README.md.
+
+EDITION  ?= tbs-en
+GAME     := tbs
+DEFINE   := TBS_EDITION_EN
+GBA      := out/$(EDITION)
+HEADLESS ?= 0
+BUILD    ?= out/native-$(EDITION)$(if $(filter 1,$(HEADLESS)),-headless)
+TARGET   := $(BUILD)/tbs-native
+
+CC       ?= gcc
+AS_HOST  ?= as
+PYTHON   ?= python3
+GBA_NM   ?= arm-none-eabi-nm
+ARCH     ?= -m32
+ASARCH   ?= --32
+SDL_CFLAGS ?= $(shell pkg-config --cflags sdl3 2>/dev/null)
+SDL_LIBS   ?= $(shell pkg-config --libs sdl3 2>/dev/null)
+
+ifeq ($(HEADLESS),1)
+PLATFORM := port/src/platform_headless.c
+PLATFORM_LIBS :=
+else
+PLATFORM := port/src/platform_sdl.c
+PLATFORM_LIBS := $(SDL_LIBS)
+endif
+
+GAME_CFLAGS := $(ARCH) -std=gnu89 -O2 -g -fno-strict-aliasing -fwrapv -fno-pie \
+               -fno-stack-protector -ffreestanding -nostdinc -fcommon \
+               -DMODERN=1 -DNATIVE=1 -DUBFIX=1 -D$(DEFINE)=1 \
+               -Iport/include -Igames/$(GAME)/include -I$(GBA) -w
+PORT_CFLAGS := $(ARCH) -std=gnu99 -O2 -g -fno-strict-aliasing -fwrapv -fno-pie \
+               -DNATIVE=1 -D$(DEFINE)=1 -Iport/include -Wall -Wno-unused-function
+# Routines the game copies to RAM or the stack run there (as jumps back to
+# the host code), so EWRAM, IWRAM and the stack are executable.
+LDFLAGS     := $(ARCH) -no-pie -g -z execstack
+
+.SUFFIXES:
+.SECONDARY:
+.DEFAULT_GOAL := $(TARGET)
+
+ifeq ($(wildcard $(GBA)/objects.mk),)
+$(error $(GBA)/objects.mk is missing: run `make $(EDITION)` first)
+endif
+include $(GBA)/objects.mk
+
+# Assembly that is code, not data: each has a C replacement in port/src, or
+# (the sound driver) is left out for now. The RAM layouts (ewram, iwram,
+# iwram_high) become absolute symbols instead.
+ASM_CODE := games/tbs/src/battle/background_decode \
+            games/tbs/src/battle_effect/blitter_color_fragments \
+            games/tbs/src/battle_effect/blitter_fragments \
+            games/tbs/src/field/actor_update_far \
+            games/tbs/src/field/map_grid_convert \
+            games/tbs/src/field/picture_decode \
+            games/tbs/src/gamepak/rom_header \
+            games/tbs/src/menu/credits_background_decode \
+            games/tbs/src/menu/credits_background_expand \
+            games/tbs/src/scene/entry \
+            games/tbs/src/system/bios games/tbs/src/system/decompress_byte_lz \
+            games/tbs/src/system/decompress_tagged_lz games/tbs/src/system/entry \
+            games/tbs/src/system/heap_release games/tbs/src/system/inner_product \
+            games/tbs/src/system/irq games/tbs/src/system/irq_table \
+            games/tbs/src/system/iwram_entry games/tbs/src/system/iwram_routines \
+            games/tbs/src/system/trig games/tbs/src/window/decompress_4bpp \
+            games/tbs/src/window/expand_opaque games/tbs/src/window/message_decode \
+            games/tbs/src/system/ewram games/tbs/src/system/iwram \
+            games/tbs/src/system/iwram_high
+FAR_CALLS := $(basename $(wildcard games/tbs/src/gamepak/far_call/*.s))
+# The sound driver and its data: silent for now (port/src/sound_stub.c).
+SOUND := $(basename $(wildcard games/tbs/sound/*.s games/tbs/sound/songs/*.s games/tbs/sound/songs/*.mid)) \
+         $(basename $(wildcard games/tbs/src/sound/*.s games/tbs/src/sound/*.c))
+# The flash save library: port/src/native_flash.c keeps the save in a file.
+FLASH := $(basename $(wildcard games/tbs/src/gamepak/flash/*.c))
+SKIP := $(ASM_CODE) $(FAR_CALLS) $(SOUND) $(FLASH)
+
+stem = $(patsubst $(BUILD)/obj/%.o,%,$(1))
+MAIN_STEMS := $(filter-out $(SKIP),$(call stem,$(MAIN_OBJS)))
+overlay_stems = $(filter-out $(SKIP) %/imports,$(call stem,$(OVERLAY_OBJS_$(1))))
+obj = $(BUILD)/obj/$(1).o
+
+MAIN_GAME_OBJS := $(foreach s,$(MAIN_STEMS),$(call obj,$(s)))
+OVERLAY_RELOCS := $(foreach o,$(OVERLAYS),$(BUILD)/overlays/$(o).o)
+
+PORT_SRCS := $(filter-out port/src/platform_%.c,$(wildcard port/src/*.c)) $(PLATFORM)
+PORT_OBJS := $(PORT_SRCS:port/src/%.c=$(BUILD)/port/%.o)
+GEN_OBJS  := $(BUILD)/gen/ram_symbols.o $(BUILD)/gen/far_aliases.ld $(BUILD)/gen/overlay_table.o \
+             $(BUILD)/gen/far_tables.o $(BUILD)/gen/native_symbols.o
+
+$(TARGET): $(MAIN_GAME_OBJS) $(OVERLAY_RELOCS) $(PORT_OBJS) $(GEN_OBJS)
+	$(CC) $(LDFLAGS) -o $@ $^ $(PLATFORM_LIBS) -lm
+
+# Game C.
+$(BUILD)/obj/%.o: %.c
+	@mkdir -p $(@D)
+	$(CC) $(GAME_CFLAGS) -MMD -MP -c -o $@ $<
+# Game data in assembly, made host-assembler friendly first.
+$(BUILD)/obj/%.o: %.s port/tools/arm2host_s.py
+	@mkdir -p $(@D)
+	$(PYTHON) port/tools/arm2host_s.py $< $(@:.o=.host.s) -I $(GBA) --defsym $(DEFINE)=1
+	$(AS_HOST) $(ASARCH) -I $(GBA) -o $@ $(@:.o=.host.s)
+# The platform layer.
+$(BUILD)/port/%.o: port/src/%.c
+	@mkdir -p $(@D)
+	$(CC) $(PORT_CFLAGS) $(if $(filter platform_sdl.c,$(notdir $<)),$(SDL_CFLAGS)) -MMD -MP -c -o $@ $<
+
+# Each overlay is linked into one relocatable object; its own globals are made
+# local, its six entry points renamed after it, and its sections renamed so
+# the loader can find its code, restore its data and clear its BSS.
+.SECONDEXPANSION:
+$(BUILD)/overlays/%.o: $$(foreach s,$$(call overlay_stems,$$*),$$(call obj,$$(s))) port/tools/overlay_object.py
+	@mkdir -p $(@D)
+	$(PYTHON) port/tools/overlay_object.py $* $@ $(filter %.o,$^)
+
+$(BUILD)/gen/ram_symbols.s: port/tools/ram_symbols.py games/tbs/src/system/ewram.s games/tbs/src/system/iwram.s games/tbs/src/system/iwram_high.s
+	@mkdir -p $(@D)
+	$(PYTHON) $< $@ $(DEFINE) games/tbs/src/system/ewram.s=0x02000000 \
+	  games/tbs/src/system/iwram.s=0x03001400 games/tbs/src/system/iwram_high.s=0x030073a4
+$(BUILD)/gen/far_aliases.ld: port/tools/far_aliases.py $(wildcard games/tbs/src/gamepak/far_call/*.s) games/tbs/src/system/overlay/imports.inc
+	@mkdir -p $(@D)
+	$(PYTHON) $< $@ games/tbs/src/gamepak/far_call games/tbs/src/system/overlay/imports.inc
+$(BUILD)/gen/far_tables.s: port/tools/far_tables.py $(wildcard games/tbs/src/gamepak/far_call/*.s)
+	@mkdir -p $(@D)
+	$(PYTHON) $< $@ $(DEFINE) $(wildcard games/tbs/src/gamepak/far_call/*.s)
+$(BUILD)/gen/native_symbols.s: port/tools/native_symbols.py $(GBA)/$(EDITION).elf games/tbs/src/system/trig.s
+	@mkdir -p $(@D)
+	$(PYTHON) $< $@ $(GBA)/$(EDITION).elf $(GBA_NM) games/tbs/src/system/trig.s:Trig_SineTable
+$(BUILD)/gen/overlay_table.c: port/tools/overlay_table.py $(GBA)/objects.mk
+	@mkdir -p $(@D)
+	$(PYTHON) $< $@ $(OVERLAYS)
+$(BUILD)/gen/%.o: $(BUILD)/gen/%.s
+	$(AS_HOST) $(ASARCH) -o $@ $<
+$(BUILD)/gen/%.o: $(BUILD)/gen/%.c
+	$(CC) $(PORT_CFLAGS) -c -o $@ $<
+
+-include $(shell find $(BUILD) -name '*.d' 2>/dev/null)
diff --git a/port/README.md b/port/README.md
new file mode 100644
index 0000000..c429943
--- /dev/null
+++ b/port/README.md
@@ -0,0 +1,82 @@
+# The native build (desktop spike)
+
+The game's C compiled for a PC instead of the GBA, with a software stand-in
+for the GBA's display. It boots, runs the arena and fights battles; it is a
+spike, so it is 32-bit, silent, and has gaps (below).
+
+## Build and run
+
+From the repository root, on Linux or WSL with `gcc-multilib`:
+
+```sh
+make tbs-en                          # the GBA build first: it makes the
+                                     # assets, text and object lists
+make -f port/Makefile HEADLESS=1     # out/native-tbs-en-headless/tbs-native
+make -f port/Makefile                # out/native-tbs-en/tbs-native (SDL3)
+```
+
+The SDL3 build needs a **32-bit** SDL3 that `pkg-config sdl3` finds (or pass
+`SDL_CFLAGS=... SDL_LIBS=...`). Keys: arrows, X (A), Z (B), Enter (Start),
+Backspace (Select), A and S (L and R); hold Tab to fast-forward; Escape quits.
+A gamepad works too.
+
+The headless build takes the arena repo's smoke scripts (`scripts/smoke/*.txt`:
+`wait`, `press`, `tap`, `mash`, `include`, `shot`, `peek`, `poke`) and writes
+the shots as PNG files:
+
+```sh
+out/native-tbs-en-headless/tbs-native --script ../scripts/smoke/battle.txt --shots build/native-shots
+python3 port/tools/sheet.py build/native-shots   # all shots on one page
+```
+
+The save is `tbs-native.sav` in the working directory (or `$TBS_SAVE`).
+No ROM is read: everything comes from the repository's sources and assets.
+
+## How it works
+
+- **Same addresses as the GBA.** EWRAM, IWRAM, I/O, palette, VRAM and OAM are
+  mapped at their GBA addresses (`native_platform.c`), and the game's RAM
+  globals (`ewram.s`, `iwram.s`, `iwram_high.s`) become absolute symbols at
+  their cartridge addresses (`tools/ram_symbols.py`). Pointers are 32 bits, so
+  the build is `-m32`, non-PIE.
+- **The assembly.** Data assembly is converted for the host assembler
+  (`tools/arm2host_s.py`). The hand-written ARM routines have C versions:
+  `native_system.c` (divide, square root, matrices, trigonometry, heap,
+  BIOS calls, interrupt tables), `native_decompress.c` (the LZ decoders,
+  OAM builder, canvas blends, resource transfer) and `native_graphics.c`
+  (icon and text decoding, sprite pictures, the world map's ground, map grid,
+  battle backgrounds). `include/native/asm.h` replaces `system/asm.h`'s
+  inline assembly.
+- **Code copied to RAM.** The game copies routines into RAM to run them. A
+  DMA whose source is host code writes a jump to the routine instead
+  (`Native_DmaStart`), so EWRAM, IWRAM and the stack are executable.
+- **Far calls** (`gamepak/far_call`) become linker aliases
+  (`tools/far_aliases.py`), and their tables data (`tools/far_tables.py`).
+- **Overlays.** Every scene overlay is linked into the image: each is
+  linked on its own (`ld -r`), its globals made local and its six entry points
+  renamed (`tools/overlay_object.py`). Loading one restores its data, clears
+  its BSS and writes its entry table into the overlay area
+  (`Native_LoadOverlay`, hooked from `Overlay_Load`).
+- **The frame.** `VBlankIntrWait`'s halt runs the display through a frame:
+  228 lines, each drawn by `ppu.c` with its HBlank DMA and interrupts, VBlank
+  (its DMA and the game's handler) at line 160.
+- **The display** (`ppu.c`): modes 0 to 5, text and affine backgrounds,
+  sprites (affine too), windows, blending. No mosaic yet.
+- `UBFIX` is on: the native build cannot read or write through null the way
+  the cartridge does (into the BIOS), so the guarded versions are used.
+
+Hooks in upstream files, all under `#ifdef NATIVE` (or `UBFIX`):
+`include/system/asm.h`, `include/system/task.h` (`TASK_IN_OVERLAY`),
+`src/system/system_start_up.c` (`Overlay_Load`),
+`src/field/field_sequence_actors.c` (a null `previous` actor).
+
+## Gaps
+
+- **Sound**: none (`native_stubs.c`); the m4a driver and mixer are ARM.
+- **Battle effects** draw nothing: the canvas blitter builds ARM code from
+  fragments; its fragments are `ret` stubs for now.
+- **Null stores the cartridge ignores** crash natively (one per site, fixed
+  under `UBFIX`). Known: the field Psynergy menu's missing markers
+  (`menu_psynergy.c`, `menu_shared.c`).
+- The credits' background decoder is a stub; soft reset restarts the process.
+- 32-bit only; 64-bit needs the game's pointer-as-`u32` habits fixed.
diff --git a/port/include/native/asm.h b/port/include/native/asm.h
new file mode 100644
index 0000000..24f6513
--- /dev/null
+++ b/port/include/native/asm.h
@@ -0,0 +1,60 @@
+#ifndef NATIVE_ASM_H
+#define NATIVE_ASM_H
+
+/// @file
+/// The native build's replacements for system/asm.h: every ARM instruction
+/// sequence the game's C holds, as C or a call into the platform layer.
+
+void Native_Halt(void);
+void Native_Stop(void);
+void Native_DmaStart(volatile void *channel, unsigned source,
+                     unsigned destination, unsigned control);
+
+/// Halt: the platform runs the display up to the next interrupt.
+#define ASM_BIOS_HALT() Native_Halt()
+/// Stop (sleep mode): treated as a halt.
+#define ASM_BIOS_STOP() Native_Stop()
+
+/// The three DMA registers, written at once: the platform carries the
+/// transfer out (or arms it for its start timing).
+#define ASM_DMA_STORE(source, control, channel, destination)                   \
+  Native_DmaStart((channel), (source), (destination), (control))
+
+/// A call that returns through ip: a plain call of the native routine.
+#define ASM_CALL_RETURN_IP_MODERN(result, left, right, routine)                \
+  ((result) = ((int (*)(int, int))(routine))((left), (right)))
+#define ASM_CALL_RETURN_IP(result, factor, routine)                            \
+  ((result) = ((int (*)(int, int))(routine))((result), (factor)))
+
+/// The 64-bit signed product of two words, as its two halves.
+#define ASM_SMULL(high, low, left, right)                                      \
+  do {                                                                         \
+    long long product_ = (long long)(int)(left) * (int)(right);                \
+    (high) = (int)(product_ >> 32);                                            \
+    (low) = (unsigned)product_;                                                \
+  } while (0)
+#define ASM_ORR_SHIFTED(result, high, low)                                     \
+  ((result) = (int)((unsigned)(high) | ((unsigned)(low) >> 16)))
+
+/// The unit matrix: twelve words, 1.0 (0x10000) on the diagonal.
+#define ASM_MATRIX_UNIT(matrix)                                                \
+  do {                                                                         \
+    int *unit_ = (int *)(matrix);                                              \
+    int i_;                                                                    \
+    for (i_ = 0; i_ < 12; i_++)                                                \
+      unit_[i_] = (i_ % 4 == 0) ? 0x10000 : 0;                                 \
+  } while (0)
+#define ASM_MATRIX_UNIT_CURRENT(matrix) ASM_MATRIX_UNIT(matrix)
+
+/// The host keeps its own stack: wait() never moves it. Reading gives an
+/// address above every GBA region, so the frame wait's stack swap is skipped.
+#define ASM_STACK_POINTER_GET(variable)                                        \
+  ((variable) = (void *)__builtin_frame_address(0))
+#define ASM_STACK_POINTER_SET(value) ((void)(value))
+
+/// A local pinned to an ARM register is a plain local.
+#define ASM_REGISTER(declaration, name) declaration
+#define ASM_NOTHING() ((void)0)
+#define ASM_LINKED_NAME(symbol, name) extern char symbol[] __asm__(name)
+
+#endif
diff --git a/port/include/native/native.h b/port/include/native/native.h
