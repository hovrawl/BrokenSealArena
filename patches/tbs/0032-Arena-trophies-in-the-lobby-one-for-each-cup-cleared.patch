 //   0x7a0 to 0x7df                one bit for each reward given
 //                                 (ARENA_REWARD_FLAG_FIRST in arena_cups.h)
+//   0x790 to 0x79f                trophy of cup n (n 0 to 15) stands in the lobby,
+//                                 set at the first clear (FLAG_ARENA_TROPHY_FIRST)
+#define FLAG_ARENA_TROPHY_FIRST 0x790
 #define FLAG_ARENA_TOURNAMENT 0x7f8
 #define FLAG_ARENA_PROGRESS 0x7f0
 #define FLAG_ARENA_SIDE_CLEARED 0x7e8
