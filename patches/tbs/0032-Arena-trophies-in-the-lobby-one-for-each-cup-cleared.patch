diff --git a/games/tbs/src/scene/arena_series.c b/games/tbs/src/scene/arena_series.c
index 46ceddec0a..c12036e079 100644
--- a/games/tbs/src/scene/arena_series.c
+++ b/games/tbs/src/scene/arena_series.c
@@ -146,6 +146,8 @@ static void ArenaSeries_Cleared(s32 cup, const struct ArenaCupInfo *info) {
     FieldGameFlag_SetByte(FLAG_ARENA_SIDE_CLEARED,
                           FieldGameFlag_GetByte(FLAG_ARENA_SIDE_CLEARED) |
                               (1 << (cup - ARENA_MAIN_CUPS)));
+  // The trophy of the cup stands in the lobby from the next time it is built.
+  GameFlag_Set(FLAG_ARENA_TROPHY_FIRST + cup);
   Event_SetMessageId(info->firstMsg);
   FieldMessage_ShowAtActor(ACTOR_ATTENDANT, 0);
   if (info->raiseTo != 0)
