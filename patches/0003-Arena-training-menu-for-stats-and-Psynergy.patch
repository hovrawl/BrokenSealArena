 #include "module/import.h"
 #include "module/scene/battle_arena.h"
 #include "module/field/field_sequence.h"
@@ -1061,6 +1065,413 @@ static s32 BattleArena_EnterBattle(void) {
 #endif
 }
 
+#if ARENA_TRAINING
+// Arena romhack: the training menu. Coins buy permanent increases to a
+// character's base stats and Psynergy from a fixed shop. It runs after each
+// monster battle won and each time the attendant is spoken to; B leaves it.
+// Strings are global const arrays like the scene's other tables.
+const u8 gTraining_Coins[] = "Coins";
+const u8 gTraining_Cursor[] = ">";
+const u8 gTraining_Title[] = "Training";
+const u8 gTraining_Reward[] = "Won";
+const u8 gTraining_Level[] = "Lv";
+const u8 gTraining_Done[] = "Done";
+const u8 gTraining_Psynergy[] = "Psynergy";
+const u8 gTraining_Known[] = "Known";
+const u8 gTraining_Max[] = "MAX";
+const u8 gTraining_Poor[] = "Not enough coins";
+const u8 gTraining_Full[] = "No room for more Psynergy";
+const u8 gTraining_StatHp[] = "HP";
+const u8 gTraining_StatPp[] = "PP";
+const u8 gTraining_StatAtk[] = "Attack";
+const u8 gTraining_StatDef[] = "Defense";
+const u8 gTraining_StatAgi[] = "Agility";
+const u8 gTraining_StatLuck[] = "Luck";
+
+/// The stats the menu raises, in row order.
+enum TrainingStat {
+  TRAIN_HP,
+  TRAIN_PP,
+  TRAIN_ATK,
+  TRAIN_DEF,
+  TRAIN_AGI,
+  TRAIN_LUCK,
+  TRAIN_STAT_COUNT
+};
+
+/// The characters the menu trains, in row order.
+const u8 gTraining_Members[] = {ISAAC, GARET, IVAN, MIA};
+#define TRAINING_MEMBER_COUNT 4
+
+/// A Psynergy for sale: its ability id and PP cost, which sets the price.
+struct TrainingPsynergy {
+  u16 id;
+  u16 ppCost;
+};
+
+#define TRAINING_PSYNERGY_COUNT 32
+#define TRAINING_PSYNERGY_ROWS 8
+const struct TrainingPsynergy gTraining_PsynergyShop[TRAINING_PSYNERGY_COUNT] = {
+    // Venus
+    {3, 4}, {4, 7}, {8, 22}, {12, 4}, {15, 6}, {90, 3}, {91, 7}, {101, 15},
+    // Mercury
+    {24, 5}, {26, 15}, {27, 5}, {33, 5}, {35, 20}, {93, 4}, {94, 8}, {96, 9},
+    {128, 6},
+    // Mars
+    {45, 4}, {49, 12}, {50, 23}, {52, 14}, {106, 3}, {107, 5}, {182, 5},
+    // Jupiter
+    {66, 4}, {68, 14}, {71, 21}, {76, 9}, {79, 14}, {120, 5}, {125, 3},
+    {189, 19},
+};
+
+#define TRAINING_ROW_HEIGHT 14
+#define TRAINING_LABEL_X 10
+
+static const u8 *Training_StatLabel(s32 stat) {
+  switch (stat) {
+  case TRAIN_HP:
+    return gTraining_StatHp;
+  case TRAIN_PP:
+    return gTraining_StatPp;
+  case TRAIN_ATK:
+    return gTraining_StatAtk;
+  case TRAIN_DEF:
+    return gTraining_StatDef;
+  case TRAIN_AGI:
+    return gTraining_StatAgi;
+  default:
+    return gTraining_StatLuck;
+  }
+}
+
+static s32 Training_StatValue(struct Unit *unit, s32 stat) {
+  switch (stat) {
+  case TRAIN_HP:
+    return unit->baseHp;
+  case TRAIN_PP:
+    return unit->basePp;
+  case TRAIN_ATK:
+    return unit->baseAttack;
+  case TRAIN_DEF:
+    return unit->baseDefense;
+  case TRAIN_AGI:
+    return unit->baseAgility;
+  default:
+    return unit->baseLuck;
+  }
+}
+
+/// How much one purchase adds to a stat.
+static s32 Training_StatStep(s32 stat) {
+  switch (stat) {
+  case TRAIN_HP:
+    return 20;
+  case TRAIN_PP:
+    return 10;
+  case TRAIN_LUCK:
+    return 1;
+  default:
+    return 5;
+  }
+}
+
+/// The most a stat's base value may reach.
+static s32 Training_StatCap(s32 stat) {
+  switch (stat) {
+  case TRAIN_HP:
+  case TRAIN_PP:
+    return UNIT_CHARACTER_HP_MAX;
+  case TRAIN_LUCK:
+    return UNIT_LUCK_MAX;
+  default:
+    return UNIT_STAT_MAX;
+  }
+}
+
+/// A stat's price, which rises with its value.
+static s32 Training_StatCost(struct Unit *unit, s32 stat) {
+  s32 value = Training_StatValue(unit, stat);
+
+  switch (stat) {
+  case TRAIN_HP:
+    return value;
+  case TRAIN_PP:
+    return value * 2;
+  case TRAIN_ATK:
+    return value * 3;
+  case TRAIN_LUCK:
+    return (value + 1) * 100;
+  default:
+    return value * 4;
+  }
+}
+
+static void Training_StatAdd(struct Unit *unit, s32 stat, s32 amount) {
+  switch (stat) {
+  case TRAIN_HP:
+    unit->baseHp += amount;
+    break;
+  case TRAIN_PP:
+    unit->basePp += amount;
+    break;
+  case TRAIN_ATK:
+    unit->baseAttack += amount;
+    break;
+  case TRAIN_DEF:
+    unit->baseDefense += amount;
+    break;
+  case TRAIN_AGI:
+    unit->baseAgility += amount;
+    break;
+  default:
+    unit->baseLuck += amount;
+    break;
+  }
+}
+
+static s32 Training_PsynergyCost(const struct TrainingPsynergy *entry) {
+  return 150 + entry->ppCost * 50;
+}
+
+static s32 Training_KnowsPsynergy(struct Unit *unit, s32 id) {
+  s32 i;
+
+  for (i = 0; i < 32; i++) {
+    if ((unit->psynergy[i].encodedAction & PSYNERGY_ABILITY_MASK) == id)
+      return 1;
+  }
+  return 0;
+}
+
+/// Reads one frame of the D-pad and buttons for a list of count rows: 1 for A,
+/// -1 for B, 2 when the cursor moved, else 0.
+static s32 Training_Navigate(s32 *cursor, s32 count) {
+  wait(1);
+  if (gKeysRepeat & KEY_B)
+    return -1;
+  if (gKeysRepeat & KEY_A)
+    return 1;
+  if (gKeysRepeat & KEY_DOWN) {
+    if (++*cursor >= count)
+      *cursor = 0;
+    return 2;
+  }
+  if (gKeysRepeat & KEY_UP) {
+    if (--*cursor < 0)
+      *cursor = count - 1;
+    return 2;
+  }
+  return 0;
+}
+
+/// The first row of every screen: a title, and the coins held.
+static void Training_DrawHeader(struct Window *window, const u8 *title) {
+  Text_DrawString(title, window, TRAINING_LABEL_X, 0);
+  Text_DrawString(gTraining_Coins, window, 130, 0);
+  Text_DrawNumber(gMainRoutineWork.coins, 6, window, 180, 0);
+}
+
+/// The Psynergy shop for one character.
+static void Training_RunPsynergy(struct Window *window, s32 unitId) {
+  s32 cursor = 0;
+  s32 top = 0;
+  s32 redraw = 1;
+  s32 notice = 0;
+  s32 key;
+  s32 row;
+
+  for (;;) {
+    if (redraw) {
+      struct Unit *unit = Unit_Get(unitId);
+
+      WindowSprite_PrepareForRedraw(window);
+      Training_DrawHeader(window, gTraining_Psynergy);
+      for (row = 0; row < TRAINING_PSYNERGY_ROWS; row++) {
+        const struct TrainingPsynergy *entry;
+        s32 y = (row + 1) * TRAINING_ROW_HEIGHT;
+
+        if (top + row >= TRAINING_PSYNERGY_COUNT)
+          break;
+        entry = &gTraining_PsynergyShop[top + row];
+        if (top + row == cursor)
+          Text_DrawString(gTraining_Cursor, window, 0, y);
+        Text_DrawMessage(MsgAbilityName + entry->id, window,
+                         TRAINING_LABEL_X, y);
+        if (Training_KnowsPsynergy(unit, entry->id))
+          Text_DrawString(gTraining_Known, window, 180, y);
+        else
+          Text_DrawNumber(Training_PsynergyCost(entry), 6, window, 180, y);
+      }
+      if (notice == 1)
+        Text_DrawString(gTraining_Poor, window, 0,
+                        (TRAINING_PSYNERGY_ROWS + 1) * TRAINING_ROW_HEIGHT);
+      else if (notice == 2)
+        Text_DrawString(gTraining_Full, window, 0,
+                        (TRAINING_PSYNERGY_ROWS + 1) * TRAINING_ROW_HEIGHT);
+      redraw = 0;
+    }
+    key = Training_Navigate(&cursor, TRAINING_PSYNERGY_COUNT);
+    notice = 0;
+    if (key == -1)
+      return;
+    if (key == 2 || key == 1) {
+      redraw = 1;
+      if (cursor < top)
+        top = cursor;
+      if (cursor >= top + TRAINING_PSYNERGY_ROWS)
+        top = cursor - TRAINING_PSYNERGY_ROWS + 1;
+    }
+    if (key == 1) {
+      const struct TrainingPsynergy *entry = &gTraining_PsynergyShop[cursor];
+      struct Unit *unit = Unit_Get(unitId);
+      s32 cost = Training_PsynergyCost(entry);
+
+      if (Training_KnowsPsynergy(unit, entry->id)) {
+        // Nothing to buy.
+      } else if (gMainRoutineWork.coins < cost) {
+        notice = 1;
+      } else if (Unit_LearnPsynergy(unitId, entry->id) < 0) {
+        notice = 2;
+      } else {
+        gMainRoutineWork.coins -= cost;
+        Unit_Calculate(unitId);
+      }
+    }
+  }
+}
+
+/// One character: the stats to raise, then the Psynergy shop.
+static void Training_RunMember(struct Window *window, s32 unitId) {
+  // Rows: the stats, Psynergy, then Done.
+  s32 count = TRAIN_STAT_COUNT + 2;
+  s32 cursor = 0;
+  s32 redraw = 1;
+  s32 notice = 0;
+  s32 key;
+  s32 stat;
+
+  for (;;) {
+    if (redraw) {
+      struct Unit *unit = Unit_Get(unitId);
+
+      WindowSprite_PrepareForRedraw(window);
+      Training_DrawHeader(window, unit->name);
+      for (stat = 0; stat < TRAIN_STAT_COUNT; stat++) {
+        s32 y = (stat + 1) * TRAINING_ROW_HEIGHT;
+
+        if (stat == cursor)
+          Text_DrawString(gTraining_Cursor, window, 0, y);
+        Text_DrawString(Training_StatLabel(stat), window, TRAINING_LABEL_X, y);
+        Text_DrawNumber(Training_StatValue(unit, stat), 4, window, 80, y);
+        if (Training_StatValue(unit, stat) + Training_StatStep(stat) >
+            Training_StatCap(stat))
+          Text_DrawString(gTraining_Max, window, 180, y);
+        else
+          Text_DrawNumber(Training_StatCost(unit, stat), 6, window, 180, y);
+      }
+      if (cursor == TRAIN_STAT_COUNT)
+        Text_DrawString(gTraining_Cursor, window, 0,
+                        (TRAIN_STAT_COUNT + 1) * TRAINING_ROW_HEIGHT);
+      Text_DrawString(gTraining_Psynergy, window, TRAINING_LABEL_X,
+                      (TRAIN_STAT_COUNT + 1) * TRAINING_ROW_HEIGHT);
+      if (cursor == TRAIN_STAT_COUNT + 1)
+        Text_DrawString(gTraining_Cursor, window, 0,
+                        (TRAIN_STAT_COUNT + 2) * TRAINING_ROW_HEIGHT);
+      Text_DrawString(gTraining_Done, window, TRAINING_LABEL_X,
+                      (TRAIN_STAT_COUNT + 2) * TRAINING_ROW_HEIGHT);
+      if (notice)
+        Text_DrawString(gTraining_Poor, window, 0,
+                        (TRAIN_STAT_COUNT + 3) * TRAINING_ROW_HEIGHT);
+      redraw = 0;
+    }
+    key = Training_Navigate(&cursor, count);
+    notice = 0;
+    if (key == -1)
+      return;
+    if (key == 2)
+      redraw = 1;
+    if (key != 1)
+      continue;
+    redraw = 1;
+    if (cursor == TRAIN_STAT_COUNT + 1)
+      return;
+    if (cursor == TRAIN_STAT_COUNT) {
+      Training_RunPsynergy(window, unitId);
+    } else {
+      struct Unit *unit = Unit_Get(unitId);
+      s32 cost = Training_StatCost(unit, cursor);
+
+      if (Training_StatValue(unit, cursor) + Training_StatStep(cursor) >
+          Training_StatCap(cursor)) {
+        // At its cap.
+      } else if (gMainRoutineWork.coins < cost) {
+        notice = 1;
+      } else {
+        gMainRoutineWork.coins -= cost;
+        Training_StatAdd(unit, cursor, Training_StatStep(cursor));
+        Unit_Calculate(unitId);
+      }
+    }
+  }
+}
+
+/// The training menu: choose a character, then spend coins on it. `reward` is
+/// the coins a won battle just paid, shown on the first screen, or 0.
+static void Training_Run(s32 reward) {
+  struct Window *window;
+  s32 cursor = 0;
+  s32 redraw = 1;
+  s32 key;
+  s32 member;
+
+  // Wait for the keys that opened it to be let go.
+  while (gKeysHeld != 0)
+    wait(1);
+  window = Window_Create(0, 0, 30, 20, WINDOW_FLAG_INSTANT);
+  for (;;) {
+    if (redraw) {
+      WindowSprite_PrepareForRedraw(window);
+      Training_DrawHeader(window, gTraining_Title);
+      for (member = 0; member < TRAINING_MEMBER_COUNT; member++) {
+        struct Unit *unit = Unit_Get(gTraining_Members[member]);
+        s32 y = (member + 1) * TRAINING_ROW_HEIGHT;
+
+        if (member == cursor)
+          Text_DrawString(gTraining_Cursor, window, 0, y);
+        Text_DrawString(unit->name, window, TRAINING_LABEL_X, y);
+        Text_DrawString(gTraining_Level, window, 100, y);
+        Text_DrawNumber(unit->level, 2, window, 120, y);
+      }
+      if (cursor == TRAINING_MEMBER_COUNT)
+        Text_DrawString(gTraining_Cursor, window, 0,
+                        (TRAINING_MEMBER_COUNT + 1) * TRAINING_ROW_HEIGHT);
+      Text_DrawString(gTraining_Done, window, TRAINING_LABEL_X,
+                      (TRAINING_MEMBER_COUNT + 1) * TRAINING_ROW_HEIGHT);
+      if (reward > 0) {
+        Text_DrawString(gTraining_Reward, window, 0,
+                        (TRAINING_MEMBER_COUNT + 3) * TRAINING_ROW_HEIGHT);
+        Text_DrawNumber(reward, 6, window, 40,
+                        (TRAINING_MEMBER_COUNT + 3) * TRAINING_ROW_HEIGHT);
+      }
+      redraw = 0;
+    }
+    key = Training_Navigate(&cursor, TRAINING_MEMBER_COUNT + 1);
+    if (key == -1)
+      break;
+    if (key == 2)
+      redraw = 1;
+    if (key == 1) {
+      if (cursor == TRAINING_MEMBER_COUNT)
+        break;
+      Training_RunMember(window, gTraining_Members[cursor]);
+      redraw = 1;
+    }
+  }
+  Window_Close(window, 2);
+  Party_RestoreHpPp(1);
+}
+#endif
+
 /// Talking to ACTOR_ATTENDANT, who arranges a battle. With no partner, offers
 /// a monster battle. With one, calls off a monster battle in waiting, then asks
 /// the player to apply or to accept the partner's request; a yes is published
@@ -1081,6 +1492,9 @@ static s32 BattleArena_ChooseBattleMode(void) {
   messageBase = MsgLobbyPleaseSpeakWhen;
   Event_Start();
   Actor_SetAngleToward(ACTOR_ATTENDANT, gMainRoutineWork.leaderActorId, 0);
+#if ARENA_TRAINING
+  Training_Run(0);
+#endif
   // Look for the partner's signature twice, a frame apart.
   if (BattleArena_PeerSlotMatches(LOBBY_SLOT_SIGNATURE) == 0) {
     wait(1);
@@ -1574,6 +1988,9 @@ s32 BattleArena_RunRoundResult(void) {
     s32 wins;
     s32 messageOffset;
     s32 v;
+#if ARENA_TRAINING
+    s32 reward;
+#endif
 
     Event_Start();
     Event_StartScreenTransition();
@@ -1581,6 +1998,14 @@ s32 BattleArena_RunRoundResult(void) {
     BattleArena_WriteSlotValue(LOBBY_SLOT_ALONE);
     gMainRoutineWork.linkTallies[LINK_TALLY_MONSTER_WINS]++;
     gMainRoutineWork.linkTallies[LINK_TALLY_MONSTER_STREAK]++;
+#if ARENA_TRAINING
+    // A win pays 200 coins, and 100 more for each win before it in the series.
+    reward = 200 + 100 * (gMainRoutineWork.linkTallies[LINK_TALLY_MONSTER_STREAK] - 1);
+    gMainRoutineWork.coins += reward;
+    if (gMainRoutineWork.coins > 999999)
+      gMainRoutineWork.coins = 999999;
+    Training_Run(reward);
+#endif
     // The offer has two lines a level (FLAG_MONSTER_BATTLE_WINS, -1 when a
     // series starts), the even line capped at 14. FLAG_AREA_TEMP_E8's byte
     // counts the victories 0 to 2; the third raises the level and takes the
