From 174de2666f1c00dc04018f5a76402bc4edca1a6e Mon Sep 17 00:00:00 2001
From: Nathan Singh <nathan.singh@hotmail.com>
Date: Fri, 30 Oct 2026 11:48:27 +1100
Subject: [PATCH] Arena: no coins window on the Djinn and Psynergy character
 pickers

The panels (status, Djinn, Psynergy) now open without the coins window; the
counters show the coins.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 games/tbs/src/shop/shop/item_picker.c | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/games/tbs/src/shop/shop/item_picker.c b/games/tbs/src/shop/shop/item_picker.c
index de56e1036d..21632534d7 100644
--- a/games/tbs/src/shop/shop/item_picker.c
+++ b/games/tbs/src/shop/shop/item_picker.c
@@ -291,12 +291,8 @@ s32 ItemPicker_ChooseMember(s32 mode) {
     shop->itemWindow = Window_CreateFar(16, 12, 14, 8, WINDOW_FLAG_INSTANT);
   } else {
     shop->itemWindow = Window_CreateFar(0, 0, 30, 10, WINDOW_FLAG_INSTANT);
-    // The status panel has no coins window.
-    shop->moneyWindow =
-        mode == ARENA_PICKER_STATUS
-            ? 0
-            : Window_CreateFar(0, 10, SHOP_MONEY_WINDOW_WIDTH, 4,
-                               WINDOW_FLAG_INSTANT);
+    // The panels have no coins window; the counters show the coins.
+    shop->moneyWindow = 0;
   }
   Shop_DrawMoney();
   partyWindow = Window_CreateFar(0, 14, 13, 3, WINDOW_FLAG_INSTANT);
-- 
2.53.0

